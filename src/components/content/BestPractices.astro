---
interface Props {
  practices: Array<{ title: string; description: string }>;
  title?: string;
  description?: string;
}

const { 
  practices = [], 
  title = "Best Practices",
  description = "Follow these standard industry recommendations for optimal, professional results:"
} = Astro.props;
---

{practices.length > 0 && (
  <div class="flex flex-col gap-4 w-full">
    {title && (
      <h2 class="text-xl font-semibold text-zinc-50 tracking-tight flex items-center gap-2">
        <span class="w-1.5 h-6 bg-accent-emerald rounded-full"></span>
        {title}
      </h2>
    )}
    {description && <p class="text-zinc-400 text-xs leading-relaxed font-sans">{description}</p>}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {practices.map((item) => (
        <div class="p-4 bg-zinc-900/20 border border-border-hairline rounded-lg flex flex-col gap-1.5">
          <strong class="text-zinc-200 text-xs font-sans flex items-center gap-1.5">
            <span class="text-accent-emerald font-semibold">✓</span>
            {item.title}
          </strong>
          <p class="text-xs text-zinc-400 leading-relaxed font-sans pl-4.5">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
)}
