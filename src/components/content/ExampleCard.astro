---
interface Props {
  title?: string;
  description?: string;
  examples: Array<{ label: string; input: string; output: string; badge?: string }>;
}

const { 
  title = "Conversion Examples", 
  description,
  examples = [] 
} = Astro.props;
---

{examples.length > 0 && (
  <div class="flex flex-col gap-4 w-full">
    {title && (
      <h2 class="text-xl font-semibold text-zinc-50 tracking-tight flex items-center gap-2">
        <span class="w-1.5 h-6 bg-accent-emerald rounded-full"></span>
        {title}
      </h2>
    )}
    {description && <p class="text-zinc-400 text-xs leading-relaxed font-sans">{description}</p>}
    
    <div class="border border-border-hairline rounded-lg p-5 bg-zinc-900/40 flex flex-col gap-4">
      {examples.map((item) => (
        <div class="flex flex-col gap-2 font-mono text-xs border-b border-border-hairline/30 last:border-b-0 pb-4 last:pb-0">
          <div class="flex justify-between items-center text-zinc-300 mb-1">
            <span class="text-xs font-semibold font-sans">{item.label}</span>
            {item.badge && (
              <span class="text-[9px] bg-zinc-800 border border-zinc-700 text-zinc-400 px-1.5 py-0.5 rounded tracking-wide uppercase">
                {item.badge}
              </span>
            )}
          </div>
          <div class="flex flex-col gap-1.5 pl-2 border-l border-zinc-800">
            <div class="flex items-center gap-2">
              <span class="text-zinc-500 w-24">Input:</span>
              <span class="text-red-400 truncate">{item.input}</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-zinc-500 w-24">Output:</span>
              <span class="text-accent-emerald font-semibold truncate">{item.output}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
)}
