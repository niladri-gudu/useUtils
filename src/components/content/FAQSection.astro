---
interface Props {
  faqs: Array<{ question: string; answer: string }>;
}

const { faqs = [] } = Astro.props;
---

{faqs.length > 0 && (
  <div class="flex flex-col gap-6 w-full">
    <h2 class="text-xl font-semibold text-zinc-50 tracking-tight flex items-center gap-2">
      <span class="w-1.5 h-6 bg-accent-emerald rounded-full"></span>
      Frequently Asked Questions
    </h2>
    <div class="grid grid-cols-1 gap-4">
      {faqs.map((faq) => (
        <div class="p-4 bg-zinc-900/30 border border-border-hairline rounded-lg flex flex-col gap-2">
          <h3 class="font-medium text-zinc-100 text-sm font-sans">{faq.question}</h3>
          <p class="text-zinc-400 text-xs leading-relaxed font-sans" set:html={faq.answer} />
        </div>
      ))}
    </div>
  </div>
)}
