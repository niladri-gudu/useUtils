---
import { ALL_TOOLS } from '../ToolsList';

interface Props {
  category?: string;
  excludeId?: string;
}

const { category, excludeId } = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const currentTool = ALL_TOOLS.find(t => t.href && t.href.replace(/\/+$/, "") === currentPath);

const targetCategory = category || (currentTool ? currentTool.category : 'text');
const targetExcludeId = excludeId || (currentTool ? currentTool.id : '');

// Query related active tools in the same category
let relatedTools = ALL_TOOLS.filter(
  t => t.isActive && t.category === targetCategory && t.id !== targetExcludeId
);

// Fallback to other active popular tools if we don't have enough in the same category
if (relatedTools.length < 3) {
  const fallbacks = ALL_TOOLS.filter(
    t => t.isActive && t.id !== targetExcludeId && !relatedTools.some(r => r.id === t.id)
  );
  relatedTools = [...relatedTools, ...fallbacks].slice(0, 3);
} else {
  relatedTools = relatedTools.slice(0, 3);
}
---

{relatedTools.length > 0 && (
  <div class="mt-12 border-t border-border-hairline/60 pt-10 max-w-4xl mx-auto w-full">
    <h3 class="text-sm font-semibold text-zinc-300 font-mono tracking-wider uppercase mb-6 flex items-center gap-2">
      <span class="w-1 h-4 bg-accent-emerald rounded-full"></span>
      Related Utilities
    </h3>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {relatedTools.map((tool) => (
        <a
          href={tool.href}
          class="flex flex-col justify-between bg-panel border border-border-hairline rounded-xl p-4 gap-4 transition-all duration-300 ease-out group hover:-translate-y-0.5 hover:border-accent-emerald/40 hover:shadow-[0_4px_20px_rgba(52,211,153,0.04)] hover:bg-zinc-900/20"
        >
          <div class="flex flex-col gap-2">
            <div class="flex items-center justify-between">
              <span class="w-7 h-7 rounded-lg bg-zinc-900 border border-border-hairline flex items-center justify-center text-xs group-hover:border-accent-emerald/30 group-hover:text-accent-emerald transition-colors">
                {tool.icon}
              </span>
              <span class="text-[9px] font-mono bg-accent-emerald/10 border border-accent-emerald/20 text-accent-emerald px-1.5 py-0.5 rounded uppercase font-semibold">
                Active
              </span>
            </div>
            
            <h4 class="text-sm font-semibold text-zinc-100 group-hover:text-accent-emerald transition-colors font-sans mt-1">
              {tool.name}
            </h4>
            
            <p class="text-[11px] text-zinc-400 leading-relaxed font-sans line-clamp-2">
              {tool.description}
            </p>
          </div>
          
          <div class="text-[10px] font-mono text-zinc-500 group-hover:text-accent-emerald flex items-center gap-1.5 mt-1 transition-colors">
            <span>Open Tool</span>
            <span>→</span>
          </div>
        </a>
      ))}
    </div>
  </div>
)}
