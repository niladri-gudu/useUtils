---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RelatedTools from '../components/content/RelatedTools.astro';
import PrivacyBadge from '../components/content/PrivacyBadge.astro';
import FAQSection from '../components/content/FAQSection.astro';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  noindex?: boolean;
  toolTitle: string;
  toolDescription: string;
  version?: string;
  tabs?: Array<{ label: string; href: string; active?: boolean }>;
  faqs?: Array<{ question: string; answer: string }>;
  showPrivacyBanner?: boolean;
  privacyText?: string;
}

const {
  title,
  description,
  keywords,
  noindex = false,
  toolTitle,
  toolDescription,
  version = "v1.0.0",
  tabs = [],
  faqs = [],
  showPrivacyBanner = true,
  privacyText = "Processed locally in browser. Zero server transmission."
} = Astro.props;

// Enforce canonical URL for schemas
const cleanPathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const canonicalURL = new URL(cleanPathname, Astro.site || 'https://useutils.com');

// Build the JSON-LD schemas for search engines including BreadcrumbList and WebPage
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": canonicalURL.toString(),
      "url": canonicalURL.toString(),
      "name": title,
      "description": description,
      "breadcrumb": {
        "@id": `${canonicalURL.toString()}#breadcrumb`
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalURL.toString()}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://useutils.com"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Tools",
          "item": "https://useutils.com/tools"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": toolTitle,
          "item": canonicalURL.toString()
        }
      ]
    },
    {
      "@type": "SoftwareApplication",
      "name": toolTitle,
      "operatingSystem": "All",
      "applicationCategory": "DeveloperApplication",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": toolDescription
    },
    ...(faqs.length > 0 ? [{
      "@type": "FAQPage",
      "mainEntity": faqs.map(faq => ({
        "@type": "Question",
        "name": faq.question,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": faq.answer.replace(/<[^>]*>/g, '') // strip HTML tag formatting for clean schema text
        }
      }))
    }] : [])
  ]
};
---

<Layout 
  title={title} 
  description={description} 
  keywords={keywords}
  noindex={noindex}
>
  <Header version={version} />

  <!-- Main Body Content -->
  <main class="flex-grow w-full max-w-7xl mx-auto px-4 py-8 flex flex-col gap-5">
    <!-- Breadcrumbs Navigation -->
    <nav class="flex items-center gap-2 text-[10px] md:text-[11px] font-mono text-zinc-500 select-none" aria-label="Breadcrumb">
      <a href="/" class="hover:text-accent-emerald transition-colors">home</a>
      <span class="text-zinc-700">/</span>
      <a href="/tools" class="hover:text-accent-emerald transition-colors">tools</a>
      <span class="text-zinc-700">/</span>
      <span class="text-accent-emerald font-medium">{toolTitle.toLowerCase()}</span>
    </nav>

    <!-- Hero / Title Header Section -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pt-2 pb-6 border-b border-border-hairline/60">
      <div class="flex flex-col gap-2">
        <h1 class="text-2xl md:text-3xl font-semibold tracking-tight text-zinc-50">
          {toolTitle}
        </h1>
        <p class="text-zinc-400 text-sm max-w-2xl leading-relaxed font-sans">
          {toolDescription}
        </p>
      </div>

      <!-- Pill Tab Switcher -->
      {tabs.length > 1 && (
        <div class="bg-panel border border-border-hairline rounded-full p-1 inline-flex items-center gap-1 self-start md:self-end max-w-full overflow-x-auto no-scrollbar whitespace-nowrap">
          {tabs.map((tab) => (
            <a 
              href={tab.href} 
              class={`px-4 py-1.5 text-xs font-semibold rounded-full transition-all shrink-0 ${
                tab.active 
                  ? 'bg-zinc-800 text-zinc-50' 
                  : 'text-zinc-400 hover:text-zinc-50'
              }`}
            >
              {tab.label}
            </a>
          ))}
        </div>
      )}
    </div>

    <!-- Privacy Banner -->
    {showPrivacyBanner && (
      <PrivacyBadge variant="banner" text={privacyText} />
    )}

    <!-- Dynamic Slot for Tool Components -->
    <div class="tool-workspace-container">
      <slot />
    </div>

    <!-- Rich On-Page SEO Landing Page Content -->
    {((Astro.slots.has('seo-content') || faqs.length > 0)) && (
      <section class="mt-12 border-t border-border-hairline/60 pt-12 max-w-4xl mx-auto w-full">
        <div class="bg-panel border border-border-hairline rounded-xl p-6 md:p-10 shadow-sm flex flex-col gap-8">
          
          <!-- Section SEO articles -->
          <slot name="seo-content" />

          <!-- FAQ Section -->
          {faqs.length > 0 && (
            <FAQSection faqs={faqs} />
          )}

        </div>
      </section>
    )}

    <!-- Dynamic Related Tools Recommendation Grid -->
    <RelatedTools />
  </main>

  <Footer />

  <!-- Schema-Ready JSON-LD for SoftwareApplication & FAQPage -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</Layout>
