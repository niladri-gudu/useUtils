---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ALL_TOOLS } from '../components/ToolsList';

const activeTools = ALL_TOOLS.filter(t => t.isActive);

const categories = [
  { id: 'all', name: 'All Categories', icon: '📁' },
  { id: 'text', name: 'Text Utilities', icon: '📝' },
  { id: 'json', name: 'Data & JSON', icon: '{ }' },
  { id: 'encoding', name: 'Crypto & Encode', icon: '🔐' },
  { id: 'css', name: 'CSS & Design', icon: '🎨' },
  { id: 'generators', name: 'Generators & Time', icon: '⚡' }
];
---

<Layout 
  title="useUtils - Premium Local-First Developer Workspace Suite" 
  description="A secure browser sandbox of local-first developer tools, interactive WASM runtimes, cheatsheets, configuration builders, and WebRTC experiments. 100% private."
>
  <Header />

  <main class="flex-grow w-full max-w-7xl mx-auto px-4 py-12 flex flex-col gap-10">
    
    <!-- Hero / Title Section -->
    <section class="flex flex-col items-center justify-center text-center gap-6 pt-4 pb-8 border-b border-border-hairline/60">
      <div class="flex flex-col gap-3 max-w-3xl">
        <div class="mx-auto w-14 h-14 rounded-xl bg-accent-emerald/10 border border-accent-emerald/20 flex items-center justify-center text-accent-emerald shadow-lg animate-pulse">
          <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width={1.5} d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
          </svg>
        </div>
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-zinc-50 font-sans">
          useUtils
        </h1>
        <p class="text-zinc-300 font-mono text-sm md:text-base tracking-wider uppercase">
          The Local-First Developer Workspace Suite
        </p>
        <p class="text-zinc-400 text-xs md:text-sm max-w-xl mx-auto leading-relaxed mt-1">
          A secure browser sandbox of offline developer tools, interactive WASM runtimes, cheatsheet references, configuration builders, and WebRTC experiments. 100% private.
        </p>
      </div>

      <!-- Local Transmission Pill -->
      <div class="inline-flex items-center gap-2 bg-zinc-900/60 border border-border-hairline rounded-full px-3 py-1.5 text-xs text-accent-emerald font-mono">
        <span class="w-1.5 h-1.5 rounded-full bg-accent-emerald animate-ping"></span>
        Processed locally in browser. Zero server transmission.
      </div>
    </section>

    <!-- Workspace Selector segmentation tabs -->
    <div class="flex flex-wrap items-center gap-1.5 bg-zinc-900/60 border border-border-hairline p-1.5 rounded-xl mx-auto justify-center shadow-inner">
      <button data-workspace-tab="tools" class="workspace-tab px-4 py-2 text-xs font-mono rounded-lg transition-all cursor-pointer bg-zinc-800 text-accent-emerald border border-zinc-700/60 font-semibold shadow-sm">
        🛠️ Developer Tools
      </button>
      <button data-workspace-tab="playground" class="workspace-tab px-4 py-2 text-xs font-mono rounded-lg transition-all cursor-pointer border border-transparent text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800/40">
        🎮 Playgrounds
      </button>
      <button data-workspace-tab="cheatsheets" class="workspace-tab px-4 py-2 text-xs font-mono rounded-lg transition-all cursor-pointer border border-transparent text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800/40">
        📚 Cheat Sheets
      </button>
      <button data-workspace-tab="labs" class="workspace-tab px-4 py-2 text-xs font-mono rounded-lg transition-all cursor-pointer border border-transparent text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800/40">
        🔬 P2P Labs
      </button>
      <button data-workspace-tab="configs" class="workspace-tab px-4 py-2 text-xs font-mono rounded-lg transition-all cursor-pointer border border-transparent text-zinc-400 hover:text-zinc-200 hover:bg-zinc-800/40">
        ⚙️ Config Builders
      </button>
    </div>

    <!-- Active Tools Workspace Area -->
    <div id="workspace-tools-content" class="workspace-content flex gap-8 w-full">
      
      <!-- Left Categories Sidebar - Hidden on mobile, sticky on desktop -->
      <aside class="hidden lg:block w-64 shrink-0">
        <div class="sticky top-20 flex flex-col gap-1.5 max-h-[calc(100vh-120px)] overflow-y-auto pr-2">
          <div class="text-xs font-mono font-semibold uppercase tracking-wider text-zinc-500 px-3 mb-2 select-none">
            Categories
          </div>
          
          {categories.map((cat) => (
            <button
              data-category-tab={cat.id}
              class={`category-tab relative flex items-center justify-between pl-4 pr-3 py-2 rounded-lg text-sm select-none border transition-colors duration-100 cursor-pointer ${
                cat.id === 'all'
                  ? 'bg-panel border-border-hairline text-accent-emerald font-medium shadow-sm before:absolute before:left-0 before:top-2.5 before:bottom-2.5 before:w-1 before:bg-accent-emerald before:rounded-r'
                  : 'border-transparent text-zinc-400 hover:bg-panel/50 hover:text-zinc-200'
              }`}
            >
              <span class="flex items-center gap-2 truncate">
                <span>{cat.icon}</span>
                <span class="truncate">{cat.name}</span>
              </span>
            </button>
          ))}
        </div>
      </aside>

      <!-- Right Content Area (Search and Grid) -->
      <div class="flex-grow flex flex-col gap-6">
        
        <!-- Search Input -->
        <div class="relative w-full max-w-xl">
          <input
            id="homepage-search"
            type="text"
            placeholder="Search tools... (e.g., JSON, Base64, JWT, CSS)"
            class="w-full bg-panel border border-border-hairline hover:border-zinc-700 focus:border-accent-emerald focus:ring-1 focus:ring-accent-emerald/30 rounded-xl py-3 pl-11 pr-20 text-sm font-mono text-zinc-100 placeholder-zinc-500 outline-none transition-all"
          />
          <div class="absolute left-4 top-1/2 -translate-y-1/2 text-zinc-500">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <div class="absolute right-3.5 top-1/2 -translate-y-1/2 flex items-center gap-1.5 pointer-events-none select-none">
            <kbd class="font-mono bg-zinc-800/80 px-1.5 py-0.5 rounded border border-zinc-700 text-[10px] text-zinc-400">⌘ K</kbd>
            <kbd class="font-mono bg-zinc-800/80 px-1.5 py-0.5 rounded border border-zinc-700 text-[10px] text-zinc-400">/</kbd>
          </div>
        </div>

        <!-- Tools Grid -->
        <div id="homepage-tools-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 mt-2">
          {activeTools.map((tool) => (
            <a
              href={tool.href}
              data-tool-name={tool.name.toLowerCase()}
              data-tool-desc={tool.description.toLowerCase()}
              data-tool-cat={tool.category}
              class="homepage-tool-card flex flex-col justify-between bg-panel border border-border-hairline hover:border-accent-emerald/40 hover:bg-zinc-900/40 rounded-xl p-5 gap-4 transition-all duration-300 ease-out group select-none hover:-translate-y-0.5"
            >
              <div class="flex flex-col gap-2.5">
                <div class="flex items-center justify-between">
                  <span class="w-8 h-8 rounded-lg bg-zinc-900 border border-border-hairline flex items-center justify-center text-sm font-mono font-semibold select-none group-hover:border-accent-emerald/30 group-hover:text-accent-emerald transition-colors">
                    {tool.icon}
                  </span>
                  <div class="flex items-center gap-1.5">
                    {tool.isPopular && (
                      <span class="text-[9px] font-mono bg-zinc-800 border border-zinc-700 text-zinc-400 px-1.5 py-0.5 rounded tracking-wide uppercase">
                        Popular
                      </span>
                    )}
                    <span class="text-[9px] font-mono bg-accent-emerald/10 border border-accent-emerald/20 text-accent-emerald px-1.5 py-0.5 rounded tracking-wide uppercase font-semibold">
                      Active
                    </span>
                  </div>
                </div>

                <h3 class="text-base font-semibold text-zinc-50 group-hover:text-accent-emerald transition-colors font-sans mt-1">
                  {tool.name}
                </h3>
                <p class="text-xs text-zinc-400 leading-relaxed font-sans line-clamp-2">
                  {tool.description}
                </p>
              </div>

              <div class="pt-2">
                <div class="inline-flex items-center justify-between w-full bg-zinc-900 border border-border-hairline group-hover:bg-accent-emerald group-hover:text-zinc-950 group-hover:border-accent-emerald text-zinc-300 font-mono text-xs font-semibold py-2 px-3.5 rounded-lg transition-all duration-200">
                  <span>Open Tool</span>
                  <span>→</span>
                </div>
              </div>
            </a>
          ))}
        </div>

        <!-- No Results State -->
        <div id="no-results-state" class="hidden w-full flex flex-col items-center justify-center py-20 text-center gap-4 bg-panel border border-border-hairline border-dashed rounded-xl">
          <span class="text-4xl text-zinc-650">🔍</span>
          <div class="flex flex-col gap-1">
            <h3 class="text-base font-semibold text-zinc-50">
              No tools found
            </h3>
            <p class="text-xs text-zinc-500 max-w-sm">
              We couldn't find any utilities matching your query. Let us know what developer tool you need!
            </p>
          </div>
          <a
            href="/tools"
            class="px-4 py-2 bg-accent-emerald hover:bg-emerald-400 text-zinc-950 font-mono text-xs font-semibold rounded-lg transition-all cursor-pointer shadow-md"
          >
            Go to Tool Pipeline
          </a>
        </div>
      </div>
    </div>

    <!-- Playground Workspace Placeholder -->
    <div id="workspace-playground-content" class="workspace-content hidden flex flex-col gap-6 max-w-3xl mx-auto w-full animate-in fade-in duration-200">
      <div class="bg-panel border border-border-hairline rounded-xl p-8 flex flex-col gap-5 text-center items-center">
        <span class="w-12 h-12 rounded-xl bg-zinc-900 border border-border-hairline flex items-center justify-center text-2xl">🎮</span>
        <div class="flex flex-col gap-2">
          <h3 class="text-lg font-bold text-zinc-50 font-sans">Interactive Runtimes & Playgrounds</h3>
          <span class="text-[9px] font-mono bg-zinc-900 border border-border-hairline text-zinc-500 px-2 py-0.5 rounded uppercase self-center tracking-wider font-semibold">Coming Soon / Under Development</span>
        </div>
        <p class="text-xs text-zinc-400 max-w-md leading-relaxed font-sans">
          Write and evaluate code in sandboxed client-side environments. Compile regex rules visually, query local SQL databases, and run full-stack code frames inside secure WebAssembly runtimes.
        </p>
      </div>
    </div>

    <!-- Cheatsheets Workspace Placeholder -->
    <div id="workspace-cheatsheets-content" class="workspace-content hidden flex flex-col gap-6 max-w-3xl mx-auto w-full animate-in fade-in duration-200">
      <div class="bg-panel border border-border-hairline rounded-xl p-8 flex flex-col gap-5 text-center items-center">
        <span class="w-12 h-12 rounded-xl bg-zinc-900 border border-border-hairline flex items-center justify-center text-2xl">📚</span>
        <div class="flex flex-col gap-2">
          <h3 class="text-lg font-bold text-zinc-50 font-sans">High-Density Reference Cheat Sheets</h3>
          <span class="text-[9px] font-mono bg-zinc-900 border border-border-hairline text-zinc-500 px-2 py-0.5 rounded uppercase self-center tracking-wider font-semibold">Coming Soon</span>
        </div>
        <p class="text-xs text-zinc-400 max-w-md leading-relaxed font-sans">
          Quick-reference cards designed for second monitor display. Copy syntax configurations, layouts, and shortcuts for Git, CSS grid/flexbox, markdown, and regular expressions.
        </p>
      </div>
    </div>

    <!-- Labs Workspace Placeholder -->
    <div id="workspace-labs-content" class="workspace-content hidden flex flex-col gap-6 max-w-3xl mx-auto w-full animate-in fade-in duration-200">
      <div class="bg-panel border border-border-hairline rounded-xl p-8 flex flex-col gap-5 text-center items-center">
        <span class="w-12 h-12 rounded-xl bg-zinc-900 border border-border-hairline flex items-center justify-center text-2xl">🔬</span>
        <div class="flex flex-col gap-2">
          <h3 class="text-lg font-bold text-zinc-50 font-sans">Experimental & P2P WebRTC Apps</h3>
          <span class="text-[9px] font-mono bg-zinc-900 border border-border-hairline text-zinc-500 px-2 py-0.5 rounded uppercase self-center tracking-wider font-semibold">Coming Soon</span>
        </div>
        <p class="text-xs text-zinc-400 max-w-md leading-relaxed font-sans">
          Serverless point-to-point experiments. Share massive files securely or collaborate on design templates with zero network staging and direct browser connectivity.
        </p>
      </div>
    </div>

    <!-- Configs Workspace Placeholder -->
    <div id="workspace-configs-content" class="workspace-content hidden flex flex-col gap-6 max-w-3xl mx-auto w-full animate-in fade-in duration-200">
      <div class="bg-panel border border-border-hairline rounded-xl p-8 flex flex-col gap-5 text-center items-center">
        <span class="w-12 h-12 rounded-xl bg-zinc-900 border border-border-hairline flex items-center justify-center text-2xl">⚙️</span>
        <div class="flex flex-col gap-2">
          <h3 class="text-lg font-bold text-zinc-50 font-sans">Visual Boilerplate Config Builders</h3>
          <span class="text-[9px] font-mono bg-zinc-900 border border-border-hairline text-zinc-500 px-2 py-0.5 rounded uppercase self-center tracking-wider font-semibold">Coming Soon</span>
        </div>
        <p class="text-xs text-zinc-400 max-w-md leading-relaxed font-sans">
          Construct standard config templates visually. Export valid boilerplate checklists for Docker, TypeScript tsconfig, ESLint rules, or GitHub Actions workflows.
        </p>
      </div>
    </div>

    <!-- Sandbox Technical Metrics -->
    <section class="mt-4 border-t border-border-hairline/60 pt-10">
      <div class="bg-zinc-900/40 border border-border-hairline rounded-xl p-6 md:p-8 flex flex-col gap-6 max-w-4xl mx-auto">
        <h3 class="text-sm font-semibold text-zinc-300 font-mono tracking-wider uppercase flex items-center gap-2">
          <span>🛡️</span> local-first sandbox validation
        </h3>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="flex flex-col gap-1">
            <span class="text-xs font-mono text-zinc-500 uppercase">Sandbox Mode</span>
            <span class="text-sm font-semibold text-zinc-100 font-sans flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-accent-emerald animate-pulse"></span>
              Client-Only Container
            </span>
            <p class="text-[11px] text-zinc-400 leading-relaxed mt-1">
              All tools run inside a sandboxed iframe. Your keys, files, and inputs are never exposed to remote endpoints.
            </p>
          </div>
          
          <div class="flex flex-col gap-1">
            <span class="text-xs font-mono text-zinc-500 uppercase">Data Transmission</span>
            <span class="text-sm font-semibold text-zinc-100 font-sans flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-accent-emerald"></span>
              0 Bytes Sent
            </span>
            <p class="text-[11px] text-zinc-400 leading-relaxed mt-1">
              Zero network tracking on content parses. WebRTC connections use standard ephemeral signaling and disconnect immediately.
            </p>
          </div>

          <div class="flex flex-col gap-1">
            <span class="text-xs font-mono text-zinc-500 uppercase">Code Integrity</span>
            <span class="text-sm font-semibold text-zinc-100 font-sans flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-accent-emerald"></span>
              In-House Utilities
            </span>
            <p class="text-[11px] text-zinc-400 leading-relaxed mt-1">
              Every package and utility is written natively using JS/Web APIs. No bloated third-party wrapper APIs.
            </p>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('homepage-search');
    const toolCards = document.querySelectorAll('.homepage-tool-card');
    const categoryTabs = document.querySelectorAll('.category-tab');
    const noResults = document.getElementById('no-results-state');
    
    let currentCategory = 'all';

    function filterTools() {
      const query = (searchInput.value || '').toLowerCase().trim();
      let visibleCount = 0;

      toolCards.forEach(card => {
        const name = card.getAttribute('data-tool-name') || '';
        const desc = card.getAttribute('data-tool-desc') || '';
        const cat = card.getAttribute('data-tool-cat') || '';
        
        const matchesQuery = name.includes(query) || desc.includes(query) || cat.includes(query);
        const matchesCategory = currentCategory === 'all' || cat === currentCategory;

        if (matchesQuery && matchesCategory) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (visibleCount === 0) {
        noResults.classList.remove('hidden');
      } else {
        noResults.classList.add('hidden');
      }
    }

    searchInput?.addEventListener('input', filterTools);

    categoryTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        categoryTabs.forEach(t => {
          t.classList.remove('bg-panel', 'border-border-hairline', 'text-accent-emerald', 'font-medium', 'shadow-sm', 'before:absolute', 'before:left-0', 'before:top-2.5', 'before:bottom-2.5', 'before:w-1', 'before:bg-accent-emerald', 'before:rounded-r');
          t.classList.add('border-transparent', 'text-zinc-400', 'hover:bg-panel/50', 'hover:text-zinc-200');
        });
        
        tab.classList.remove('border-transparent', 'text-zinc-400', 'hover:bg-panel/50', 'hover:text-zinc-200');
        tab.classList.add('bg-panel', 'border-border-hairline', 'text-accent-emerald', 'font-medium', 'shadow-sm', 'before:absolute', 'before:left-0', 'before:top-2.5', 'before:bottom-2.5', 'before:w-1', 'before:bg-accent-emerald', 'before:rounded-r');
        
        currentCategory = tab.getAttribute('data-category-tab') || 'all';
        filterTools();
      });
    });

    // Workspace tab switcher logic
    const workspaceTabs = document.querySelectorAll('.workspace-tab');
    const workspaceContents = document.querySelectorAll('.workspace-content');

    workspaceTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        workspaceTabs.forEach(t => {
          t.classList.remove('bg-zinc-800', 'text-accent-emerald', 'border-zinc-700/60', 'font-semibold', 'shadow-sm');
          t.classList.add('border-transparent', 'text-zinc-400', 'hover:text-zinc-200', 'hover:bg-zinc-800/40');
        });

        tab.classList.remove('border-transparent', 'text-zinc-400', 'hover:text-zinc-200', 'hover:bg-zinc-800/40');
        tab.classList.add('bg-zinc-800', 'text-accent-emerald', 'border-zinc-700/60', 'font-semibold', 'shadow-sm');

        const targetTab = tab.getAttribute('data-workspace-tab');
        workspaceContents.forEach(content => {
          if (content.id === `workspace-${targetTab}-content`) {
            content.classList.remove('hidden');
            // If tools tab is reopened, restore layout display
            if (targetTab === 'tools') {
              content.style.display = 'flex';
            }
          } else {
            content.classList.add('hidden');
            content.style.display = '';
          }
        });
      });
    });

    // Global keyboard listener
    document.addEventListener('keydown', (e) => {
      // Focus search on CMD+K / Ctrl+K / /
      if (((e.metaKey || e.ctrlKey) && e.key === 'k') || (e.key === '/' && document.activeElement !== searchInput)) {
        e.preventDefault();
        searchInput?.focus();
        return;
      }
    });
  });
</script>
