---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
import { AesEncryptDecrypt } from '../../components/AesEncryptDecrypt';
import ComparisonTable from '../../components/content/ComparisonTable.astro';
import BestPractices from '../../components/content/BestPractices.astro';
import CommonMistakes from '../../components/content/CommonMistakes.astro';
import OfficialReferences from '../../components/content/OfficialReferences.astro';
import LanguageSupport from '../../components/content/LanguageSupport.astro';
import ExampleCard from '../../components/content/ExampleCard.astro';

const tabs = [
  { label: 'AES Encrypt & Decrypt', href: '/tools/aes-encrypt-decrypt' },
  { label: 'AES Encryption', href: '/tools/aes-encryption' },
  { label: 'AES Decryption', href: '/tools/aes-decryption', active: true }
];

const faqs = [
  {
    question: "What is AES Decryption?",
    answer: "AES Decryption is the process of reversing AES encryption, using the same secret key or passphrase to restore scramble ciphertexts back to their original plain text form."
  },
  {
    question: "How do I decrypt an AES payload online?",
    answer: "Paste your encrypted ciphertext (Base64, Hex, or JSON envelope) into the input field above, select the decryption mode, enter the passphrase or raw key, and configure matching cipher parameters (like AES-GCM or AES-CBC) to decrypt."
  },
  {
    question: "Why does the tool show a 'Decryption failed' error?",
    answer: "Decryption fails if the password is incorrect, the key size/block mode does not match the encryption settings, or the ciphertext payload has been truncated or corrupted."
  },
  {
    question: "What parameters are needed for AES decryption?",
    answer: "To decrypt successfully, you need the secret key/passphrase, the Initialization Vector (IV), the salt (if derived from a passphrase), and the block mode (GCM vs CBC)."
  },
  {
    question: "Is this AES decryption tool secure?",
    answer: "Yes. Like all tools on useUtils, the decryption runs entirely locally using the browser's Web Crypto API. No passwords, keys, or ciphertexts are ever transmitted to our servers."
  },
  {
    question: "How does the tool decrypt standard concatenated strings?",
    answer: "Our engine automatically parses standard concatenated formats to split out the salt, IV, and ciphertext blocks before performing key derivation and block decryption."
  },
  {
    question: "Can I decrypt .enc files using this tool?",
    answer: "Yes. Select File mode, drop your <code>.enc</code> file generated by our encryptor, input the password, and click decrypt to download the original unencrypted file."
  },
  {
    question: "How do I decrypt AES ciphertext in Node.js?",
    answer: "Use the built-in <code>crypto</code> module with decipher methods: <br/><code>const decipher = crypto.createDecipheriv('aes-256-gcm', key, iv)</code>."
  },
  {
    question: "How do I decrypt AES ciphertext in Python?",
    answer: "Use the <code>pycryptodome</code> package: <br/><code>cipher = AES.new(key, AES.MODE_GCM, nonce=iv); plaintext = cipher.decrypt_and_verify(ciphertext, tag)</code>."
  },
  {
    question: "What is the role of the IV in decryption?",
    answer: "The Initialization Vector (IV) tells the decryption engine the initial block configuration, aligning the decryption cycles with the encryption blocks."
  },
  {
    question: "What is the authentication tag in AES-GCM?",
    answer: "In GCM mode, the encryption output includes a 16-byte authentication tag. The decryption engine validates this tag first; if the tag does not match, it aborts, detecting data tampering."
  },
  {
    question: "Why is a salt needed for decryption?",
    answer: "If the key was derived from a passphrase, the same salt must be passed to the PBKDF2 function to derive the exact same cryptographic key."
  },
  {
    question: "How are share links decrypted?",
    answer: "If someone shared a config link with you (e.g. <code>#payload=...</code>), our tool automatically loads all parameters (MIME type, salt, IV, and ciphertext) from the URL hash. You only need to type the password."
  },
  {
    question: "Can I decrypt AES-CBC ciphertext here?",
    answer: "Yes, the tool supports both AES-GCM and AES-CBC modes with customizable 128, 192, and 256-bit key sizes."
  },
  {
    question: "Can I enter a raw hexadecimal key instead of a password?",
    answer: "Yes. Toggle the key type from 'Passphrase' to 'Raw Cryptographic Key' to input 32-byte hexadecimal keys directly."
  },
  {
    question: "How do I resolve a padding error during CBC decryption?",
    answer: "Padding errors usually mean the ciphertext was parsed incorrectly, or the password/key is wrong. Verify the delimiter format and output representation settings."
  },
  {
    question: "What is PBKDF2 iterations syncing?",
    answer: "To decrypt, you must match the exact number of PBKDF2 iteration rounds used during encryption (e.g. 100,000 rounds). If the counts mismatch, the derived keys will differ."
  },
  {
    question: "Can I decode Base64 and decrypt AES in one step?",
    answer: "Yes, the tool handles Base64 or Hex decoded inputs automatically before proceeding to binary block decryptions."
  },
  {
    question: "Is there a command line tool to decrypt files?",
    answer: "Yes. In OpenSSL, you can run: <br/><code>openssl enc -d -aes-256-cbc -in file.enc -out file.txt</code>."
  },
  {
    question: "Does the tool log passphrase entries?",
    answer: "No. All states are stored temporarily in local React state variables and are wiped immediately upon closing or reloading the tab."
  }
];

const references = [
  { title: "NIST Special Publication 800-38D - Recommendation for Block Cipher Modes (GCM)", url: "https://csrc.nist.gov/publications/detail/sp/800-38d/final", source: "NIST Publications" },
  { title: "W3C Web Cryptography API - SubtleCrypto decrypt", url: "https://www.w3.org/TR/WebCryptoAPI/#SubtleCrypto-method-decrypt", source: "W3C Standards" }
];

const languageCodes = [
  {
    lang: "Node.js (AES-GCM)",
    code: `const crypto = require('crypto');

// Parameters must match the encryption stage
const key = Buffer.from(keyHex, 'hex');
const iv = Buffer.from(ivHex, 'hex');
const tag = Buffer.from(authTagHex, 'hex');

const decipher = crypto.createDecipheriv('aes-256-gcm', key, iv);
decipher.setAuthTag(tag);

let decrypted = decipher.update(ciphertextHex, 'hex', 'utf8');
decrypted += decipher.final('utf8');

console.log(decrypted); // Output: Plain Text Data`,
    note: "Must set the authentication tag before calling decipher.final."
  },
  {
    lang: "Python (AES-GCM)",
    code: `from Crypto.Cipher import AES

key = bytes.fromhex(key_hex)
iv = bytes.fromhex(iv_hex)
tag = bytes.fromhex(tag_hex)
ciphertext = bytes.fromhex(ciphertext_hex)

cipher = AES.new(key, AES.MODE_GCM, nonce=iv)
plaintext = cipher.decrypt_and_verify(ciphertext, tag)

print(plaintext.decode('utf-8'))`,
    note: "Raises ValueError if authentication tag validation fails."
  }
];

const mistakesList = [
  {
    title: "Mismatched Decryption Parameters",
    description: "Configuring a different block size, PBKDF2 iteration count, or cipher mode than what was used during encryption results in silent decryption failures or padding errors.",
    fix: "Ensure all parameters (GCM vs CBC, iterations, key size) match. Use our JSON payload envelope to store parameter configurations safely alongside the ciphertext."
  },
  {
    title: "Entering Raw Key to Passphrase Field",
    description: "Typing a 32-byte hex key into the passphrase field causes the engine to run PBKDF2 key derivation on it, producing a different key.",
    fix: "Toggle Key Input type to 'Raw Cryptographic Key' when using raw binary keys."
  }
];
---

<ToolPageLayout
  title="AES Decryption Online: Decrypt Strings & Files securely"
  description="Decrypt AES-GCM or AES-CBC ciphertexts and files locally. Supports password keys, custom IV/salt metadata, and private client-side execution."
  keywords="aes decryption, decrypt aes online, aes 256 decryptor, decrypt ciphertext, pbkdf2 key generator, aes-gcm decryption"
  toolTitle="AES Decryption Studio"
  toolDescription="Reverse Advanced Encryption Standard (AES) ciphers locally in your browser. Configure passwords, input raw keys, or drop encrypted files to recover plain text instantly."
  tabs={tabs}
  faqs={faqs}
>
  <AesEncryptDecrypt client:load defaultActiveTab="decrypt" />

  <div slot="seo-content" class="flex flex-col gap-8 font-sans text-sm text-zinc-400">
    <!-- Section: Intro -->
    <div>
      <h2 class="text-xl font-semibold text-zinc-50 tracking-tight mb-4 flex items-center gap-2">
        <span class="w-1.5 h-6 bg-accent-emerald rounded-full"></span>
        How AES Decryption Works
      </h2>
      <p class="leading-relaxed mb-4">
        Symmetric cipher systems use a single shared secret to protect data. The **AES Decryption** process applies inverse block mathematical functions (inv-sub bytes, inv-shift rows, inv-mix columns) to the block segments of the ciphertext using the derived key schedule.
      </p>
      <p class="leading-relaxed">
        Our **AES Decryption Studio** makes it easy to recover documents. It automatically splits out salt and IV markers from standard formats, verifies authenticated tags in GCM mode, and processes everything in local sandbox memory.
      </p>
    </div>

    <!-- Section: Comparison Table -->
    <ComparisonTable
      title="Common Decryption Failure Indicators"
      headers={["Error Message", "Likely Cause", "How to Verify", "Solution"]}
      rows={[
        { label: "Operation Error / Bad Tag", values: ["Authentication Tag Validation failed in GCM", "Mismatched password or cipher mode", "Confirm mode is AES-GCM and key size is correct"] },
        { label: "Padding Error / Invalid Block", values: ["PKCS#7 padding validation failed in CBC", "Wrong key, IV, or corrupted ciphertext bytes", "Verify the Initialization Vector is correct"] },
        { label: "Empty Output / Malformed", values: ["Mismatched Base64 / Hex format decoding", "Input text includes whitespace formatting or tags", "Ensure no space breaks are inside base64 string"] }
      ]}
    />

    <!-- Section: Example Card -->
    <ExampleCard
      title="Decryption Envelope Example"
      description="Inspect how the tool parses metadata from concatenated strings:"
      examples={[
        { label: "Hex Concatenated Input", input: "53414c54...[salt] + 4956...[iv] + 6369...[ciphertext]", output: "Parsed Salt, IV, and Ciphertext fields populated automatically", badge: "Concatenated Parsing" }
      ]}
    />

    <!-- Programming Implementation Guides -->
    <LanguageSupport
      languages={languageCodes}
      title="Programmatic AES Decryption Snippets"
      description="Implement secure ciphertext decryption in your backend applications using these code blocks:"
    />

    <!-- Common Mistakes -->
    <CommonMistakes
      mistakes={mistakesList}
      title="Common AES Decryption Pitfalls"
      description="Avoid these common validation errors when decoding data payloads:"
    />

    <!-- Best Practices -->
    <BestPractices
      title="AES Decryption Best Practices"
      practices={[
        { title: "Validate Tags First", description: "In GCM mode, always ensure authentication tag validation completes before writing output files to disk." },
        { title: "Enforce Key Scoping", description: "Keep key materials stored in temporary memory buffers; avoid writing keys to logs or cache stores." }
      ]}
    />

    <!-- Official References -->
    <OfficialReferences
      references={references}
    />
  </div>
</ToolPageLayout>
