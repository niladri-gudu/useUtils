---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
import { CaseConverter } from '../../components/CaseConverter';
import ComparisonTable from '../../components/content/ComparisonTable.astro';
import BestPractices from '../../components/content/BestPractices.astro';
import CommonMistakes from '../../components/content/CommonMistakes.astro';
import OfficialReferences from '../../components/content/OfficialReferences.astro';
import LanguageSupport from '../../components/content/LanguageSupport.astro';
import ExampleCard from '../../components/content/ExampleCard.astro';

const faqs = [
  {
    question: "What cases does the Case Converter support?",
    answer: "The Case Converter supports 13 different casing conventions. These include programming-oriented cases such as <code>camelCase</code>, <code>PascalCase</code>, <code>snake_case</code>, <code>kebab-case</code>, <code>CONSTANT_CASE</code>, <code>dot.case</code>, and <code>path/case</code>, as well as natural language cases like <code>UPPERCASE</code>, <code>lowercase</code>, <code>Title Case</code>, <code>Sentence case</code>, <code>Alternating Case</code>, and <code>Inverse Case</code>."
  },
  {
    question: "How does the 'Treat each line independently' setting work?",
    answer: "When enabled, the converter splits the input text by newlines and applies the selected casing transformation to each line independently. This is extremely useful for processing lists of database columns, variable names, or environment parameters. If disabled, the entire text block is treated as a single body of text."
  },
  {
    question: "Is my text data safe?",
    answer: "Yes, 100%. Like all tools on useUtils, the Case Converter runs entirely on the client side in your web browser. No text is ever uploaded, transmitted, or stored on a server. Your data remains fully secure and private."
  },
  {
    question: "What is the difference between programming and natural language cases?",
    answer: "Programming cases (like camelCase or snake_case) strip out all non-alphanumeric punctuation and join words using specific separators. Natural language cases (like Sentence case or Title Case) preserve spaces, paragraphs, and punctuation, only altering the capitalization of individual characters or words."
  },
  {
    question: "What is camelCase and when should I use it?",
    answer: "In <code>camelCase</code>, the first word is in lowercase and each subsequent word starts with an uppercase letter, without spaces or punctuation (e.g., <code>myVarName</code>). It is the standard naming convention for variables, functions, and object keys in JavaScript, TypeScript, Java, and C++."
  },
  {
    question: "What is snake_case and where is it commonly used?",
    answer: "In <code>snake_case</code>, all letters are lowercase and words are separated by underscores (e.g., <code>my_variable_name</code>). It is widely used in Python (for variables and functions), Rust, Ruby, PHP, SQL database column names, and JSON keys in some APIs."
  },
  {
    question: "What is PascalCase (UpperCamelCase) and what are its use cases?",
    answer: "In <code>PascalCase</code>, every word starts with an uppercase letter, without spaces or punctuation (e.g., <code>MyClassName</code>). It is the primary naming convention for classes in JavaScript/TypeScript, TypeScript interfaces, React components, and namespaces/classes in C# and Java."
  },
  {
    question: "What is kebab-case and when is it valid?",
    answer: "In <code>kebab-case</code> (also called Lisp-case), words are lowercase and separated by hyphens (e.g., <code>my-style-class</code>). It is the standard for CSS class names, HTML attributes, URL slugs, and configuration files like YAML or JSON, but it is invalid for variable names in most programming languages because the hyphen is parsed as a subtraction operator."
  },
  {
    question: "When is CONSTANT_CASE (screaming_snake_case) used?",
    answer: "In <code>CONSTANT_CASE</code>, all letters are uppercase and words are separated by underscores (e.g., <code>MAX_BUFFER_SIZE</code>). It is universally used in languages like JavaScript, Java, C++, Python, and C# to denote global constants, environment variables, or immutable settings."
  },
  {
    question: "How does Title Case differ from Sentence Case?",
    answer: "<code>Title Case</code> capitalizes the first letter of every word except for minor words (conjunctions, prepositions, articles like 'and', 'the', 'of', 'in'). <code>Sentence case</code> only capitalizes the first letter of the first word in a sentence, along with proper nouns and standalone 'I'. Title Case is used for headings and titles, while Sentence Case is used for UI copy."
  },
  {
    question: "What are dot.case and path/case conventions?",
    answer: "<code>dot.case</code> uses dots as separators (e.g., <code>config.db.port</code>) and is common in properties files, configuration paths, and event names. <code>path/case</code> uses slashes (e.g., <code>api/v1/users</code>) and is standard in REST API endpoints and filesystem directories."
  },
  {
    question: "How do you convert camelCase to snake_case programmatically in JavaScript?",
    answer: "You can convert camelCase to snake_case using a regular expression: <code>const toSnake = str => str.replace(/[A-Z]/g, letter => `_${letter.toLowerCase()}`);</code>. This inserts an underscore before each uppercase letter and converts it to lowercase."
  },
  {
    question: "Why do URL slugs use kebab-case instead of spaces or underscores?",
    answer: "Search engines like Google index URLs using hyphens (<code>kebab-case</code>) as word boundaries, whereas underscores (<code>snake_case</code>) are treated as single continuous characters. Hyphenated slugs optimize search indexing and improve URL readability."
  },
  {
    question: "What is Train-Case and how is it used?",
    answer: "<code>Train-Case</code> (e.g. <code>My-Train-Case-Header</code>) is similar to kebab-case, but each word is capitalized and separated by hyphens. It is widely used in HTTP headers (such as <code>Content-Type</code>, <code>X-Request-Id</code>)."
  },
  {
    question: "What is Screaming Snake Case?",
    answer: "<code>Screaming Snake Case</code> is another name for <code>CONSTANT_CASE</code>. All letters are capitalized and separated by underscores (e.g. <code>API_MAX_RETRY_COUNT</code>). It is used for immutable variables and global configuration keys."
  },
  {
    question: "How does programming casing conventions prevent compilation bugs?",
    answer: "Variable names in most programming languages cannot contain spaces because spaces signify syntax delimiters. Case conventions allow multi-word names to be declared as single tokens (e.g., <code>userAccountBalance</code>) without raising syntax parser errors."
  },
  {
    question: "What is the Unicode standard casing rules behavior?",
    answer: "Standard case conversion processes (like JavaScript's <code>toUpperCase()</code>) follow Unicode mapping rules. Some special alphabets have complex transformations (for example, the German character <code>ß</code> capitalizes to <code>SS</code>, and the Turkish dotted/dotless <code>I</code> behaves differently under locales)."
  },
  {
    question: "How should acronyms be cased in camelCase?",
    answer: "Acronyms in camelCase are typically treated as normal words rather than all-uppercase. For instance, write <code>fetchXmlData()</code> rather than <code>fetchXMLData()</code>. This keeps syntax trees predictable when mapping properties dynamically."
  },
  {
    question: "Can database schemas mix casing styles?",
    answer: "It is highly recommended to stick to a single style. PostgreSQL folds unquoted table and column names to lowercase, meaning PascalCase names will fail unless quoted. Standard databases (Postgres, MySQL) prefer snake_case columns."
  },
  {
    question: "How does React component naming casing work?",
    answer: "React requires custom component names to be declared in <code>PascalCase</code> (e.g., <code><UserProfile /></code>). This enables the JSX transpiler to distinguish between standard HTML elements (which are lowercase, e.g., <code><div></code>) and custom React components."
  },
  {
    question: "Why is dot.case used in configuration pathways?",
    answer: "<code>dot.case</code> (e.g., <code>app.database.host</code>) is used to establish hierarchical structural paths in keys. This maps naturally to JSON configuration trees or configuration files in Spring, Node, and Laravel ecosystems."
  },
  {
    question: "Is there a performance cost to frequent case conversions?",
    answer: "For singular UI variables, the cost is sub-microsecond. For large datasets or real-time streaming JSON API sanitization, complex regex matching can introduce CPU overhead. It is best to convert casing once at the system border and cache the result."
  },
  {
    question: "How does JavaScript's Intl.Segmenter or locale settings affect natural case conversions?",
    answer: "Natural language cases (like Title Case and Sentence Case) are highly locale-dependent. For example, word boundaries and capitalizing conventions differ in German (where all nouns are capitalized) vs English. The tool processes English rules by default."
  },
  {
    question: "How to convert kebab-case to camelCase in JavaScript?",
    answer: "To convert <code>kebab-case</code> to <code>camelCase</code>, use regex: <code>const camel = str => str.replace(/-([a-z])/g, (g) => g[1].toUpperCase());</code>. This identifies each hyphen followed by a letter and capitalizes that letter while removing the hyphen."
  },
  {
    question: "How do environment variables use CONSTANT_CASE?",
    answer: "Operating systems and Docker parse environment variables in <code>CONSTANT_CASE</code> (e.g. <code>DATABASE_URL</code>). This convention ensures system-level environment settings stand out from internal application code variables."
  },
  {
    question: "What is Toggle Case or Alternating Case?",
    answer: "<code>Alternating Case</code> (e.g. <code>tHe QuIcK bRoWn FoX</code>) shifts letter cases continuously and is primarily used for formatting visual text in memes or messaging apps. <code>Inverse Case</code> flips the state of each character."
  },
  {
    question: "Does Title Case lowercase short prepositions in headings?",
    answer: "Yes. Prepositions, conjunctions, and articles under 3 letters (e.g. <code>of, to, the, and, in, on</code>) are kept in lowercase unless they appear as the first or last word of the heading (e.g., <code>The Rise of APIs</code>)."
  }
];

const references = [
  { title: "Google Developer Documentation Style Guide", url: "https://developers.google.com/style/word-list", source: "Google Docs" },
  { title: "Microsoft Framework Design Guidelines - Capitalization Styles", url: "https://learn.microsoft.com/en-us/dotnet/standard/design-guidelines/capitalization-conventions", source: "MSDN Library" },
  { title: "IETF RFC 3986 - Uniform Resource Identifier (URI)", url: "https://datatracker.ietf.org/doc/html/rfc3986", source: "IETF Standards" }
];

const languageCodes = [
  {
    lang: "JavaScript",
    code: `// Convert camelCase to snake_case
const toSnakeCase = str => str.replace(/[A-Z]/g, letter => \`_\${letter.toLowerCase()}\`);

// Convert snake_case or kebab-case to camelCase
const toCamelCase = str => str.replace(/[-_]([a-z])/g, (_, g) => g.toUpperCase());

console.log(toSnakeCase("myVarName")); // "my_var_name"
console.log(toCamelCase("my_variable_name")); // "myVariableName"`,
    note: "Works client-side and in Node.js runtime environments."
  },
  {
    lang: "Python",
    code: `import re

def to_snake_case(s):
    # Insert underscore before uppercase letters (except starting letter)
    return re.sub(r'(?<!^)(?=[A-Z])', '_', s).lower()

def to_camel_case(s):
    # Split by underscore/hyphen and capitalize segments
    words = re.split(r'[-_]', s)
    return words[0] + ''.join(w.capitalize() for w in words[1:])

print(to_snake_case("myVarName")) # "my_var_name"
print(to_camel_case("my_variable_name")) # "myVariableName"`,
    note: "Uses Python's standard 're' module."
  },
  {
    lang: "Go",
    code: `package main

import (
	"fmt"
	"regexp"
	"strings"
)

var matchFirstCap = regexp.MustCompile("(.)([A-Z][a-z]+)")
var matchAllCap   = regexp.MustCompile("([a-z0-9])([A-Z])")

func ToSnakeCase(str string) string {
	snake := matchFirstCap.ReplaceAllString(str, "\${1}_\${2}")
	snake = matchAllCap.ReplaceAllString(snake, "\${1}_\${2}")
	return strings.ToLower(snake)
}

func main() {
	fmt.Println(ToSnakeCase("myVarName")) // "my_var_name"
}`,
    note: "Uses standard regexp package, safe for production servers."
  },
  {
    lang: "Rust",
    code: `fn to_snake_case(s: &str) -> String {
    let mut snake = String::new();
    for (i, ch) in s.char_indices() {
        if i > 0 && ch.is_uppercase() {
            snake.push('_');
        }
        snake.push(ch.to_ascii_lowercase());
    }
    snake
}

fn main() {
    println!("{}", to_snake_case("myVarName")); // "my_var_name"
}`,
    note: "Allocation-efficient character traversal without regex dependencies."
  }
];

const mistakesList = [
  {
    title: "Parsing Hyphens as Subtraction Operators",
    description: "Compilers analyze hyphens as arithmetic subtraction. Writing a statement like first-name = 'John' will parse as 'first minus name', causing compilation or syntax execution failures.",
    fix: "Use <code>camelCase</code> or <code>snake_case</code> for programming variables, reserving <code>kebab-case</code> for CSS and URL routes."
  },
  {
    title: "Locale-Insensitive Accented String Conversions",
    description: "Standard ASCII uppercase operations corrupt accented characters in Turkish, Greek, and other non-English alphabets.",
    fix: "Utilize locale-aware API methods like JavaScript's <code>toLocaleUpperCase('tr-TR')</code> when handling internationalized inputs."
  },
  {
    title: "PostgreSQL Capitalization Folding Failures",
    description: "Postgres database engines automatically fold unquoted identifiers and table names to lowercase. Querying UserProfile will fail if the table was created as double-quoted UserProfile.",
    fix: "Ensure database columns are defined and queried in unified <code>snake_case</code>, or consistently double-quote uppercase schemas."
  }
];
---

<ToolPageLayout
  title="Case Converter: Instant Text and Variable Case Conversion"
  description="Convert text or variable names between camelCase, PascalCase, snake_case, kebab-case, UPPERCASE, lowercase, and more. Featuring line-by-line conversion, character diffing, and auto-case detection."
  keywords="case converter, camelcase, snake_case, kebab-case, pascalcase, title case, uppercase, lowercase, text converter, screaming snake case, sentence case"
  toolTitle="Case Converter"
  toolDescription="Convert text and code variables between various casing formats in real-time. Features smart auto-case detection, line-by-line batch mode, character diffing, and an 'all-cases' overview pane."
  faqs={faqs}
>
  <CaseConverter client:load />

  <!-- Explanatory content slots for layout standard conformity -->
  <div slot="seo-content" class="flex flex-col gap-8 font-sans text-sm text-zinc-400">
    <!-- Section: Intro -->
    <div>
      <h2 class="text-xl font-semibold text-zinc-50 tracking-tight mb-4 flex items-center gap-2">
        <span class="w-1.5 h-6 bg-accent-emerald rounded-full"></span>
        How to Use the Case Converter
      </h2>
      <p class="leading-relaxed mb-4">
        Our case converter parses strings instantly in your browser to adapt them to different programming and formatting conventions. You can paste or type text in the <strong class="text-zinc-200">raw input pane</strong>, toggle configurations like line-by-line mode, and click any target case to view the converted output.
      </p>
      <p class="leading-relaxed">
        Click the copy buttons or use developer keyboard shortcuts (<kbd class="font-mono bg-zinc-800 px-1 py-0.5 rounded border border-zinc-700 text-[10px] text-zinc-400">⌘ C</kbd>) to copy the converted text to your clipboard.
      </p>
    </div>

    <!-- Section: Sibling Cross-Links -->
    <div class="flex flex-col gap-4">
      <h2 class="text-xl font-semibold text-zinc-50 tracking-tight flex items-center gap-2">
        <span class="w-1.5 h-6 bg-accent-emerald rounded-full"></span>
        Casing Convention Landing Pages
      </h2>
      <p class="text-zinc-400 text-xs font-sans leading-relaxed">
        Access dedicated converters pre-configured for specific programming formats and naming conversions:
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
        <a href="/tools/case-converter" class="p-3 bg-zinc-900/30 border border-border-hairline rounded-lg hover:border-accent-emerald/30 text-xs font-mono text-zinc-200 hover:text-accent-emerald transition-all">All-in-One Case Converter</a>
        <a href="/tools/camelcase-converter" class="p-3 bg-zinc-900/30 border border-border-hairline rounded-lg hover:border-accent-emerald/30 text-xs font-mono text-zinc-200 hover:text-accent-emerald transition-all">camelCase Converter</a>
        <a href="/tools/snake-case-converter" class="p-3 bg-zinc-900/30 border border-border-hairline rounded-lg hover:border-accent-emerald/30 text-xs font-mono text-zinc-200 hover:text-accent-emerald transition-all">snake_case Converter</a>
        <a href="/tools/pascal-case-converter" class="p-3 bg-zinc-900/30 border border-border-hairline rounded-lg hover:border-accent-emerald/30 text-xs font-mono text-zinc-200 hover:text-accent-emerald transition-all">PascalCase Converter</a>
        <a href="/tools/kebab-case-converter" class="p-3 bg-zinc-900/30 border border-border-hairline rounded-lg hover:border-accent-emerald/30 text-xs font-mono text-zinc-200 hover:text-accent-emerald transition-all">kebab-case Converter</a>
        <a href="/tools/constant-case-converter" class="p-3 bg-zinc-900/30 border border-border-hairline rounded-lg hover:border-accent-emerald/30 text-xs font-mono text-zinc-200 hover:text-accent-emerald transition-all">CONSTANT_CASE Converter</a>
        <a href="/tools/camelcase-to-snake-case" class="p-3 bg-zinc-900/30 border border-border-hairline rounded-lg hover:border-accent-emerald/30 text-xs font-mono text-zinc-200 hover:text-accent-emerald transition-all">camelCase to snake_case</a>
        <a href="/tools/snake-case-to-camelcase" class="p-3 bg-zinc-900/30 border border-border-hairline rounded-lg hover:border-accent-emerald/30 text-xs font-mono text-zinc-200 hover:text-accent-emerald transition-all">snake_case to camelCase</a>
        <a href="/tools/title-case-converter" class="p-3 bg-zinc-900/30 border border-border-hairline rounded-lg hover:border-accent-emerald/30 text-xs font-mono text-zinc-200 hover:text-accent-emerald transition-all">Title Case Converter</a>
      </div>
    </div>

    <!-- Section: Case Style Reference -->
    <ComparisonTable
      title="Programming Language Casing Conventions Cheat Sheet"
      description="Selecting the correct casing style is essential for writing clean, readable, and idiomatic code. Different ecosystems enforce distinct naming conventions for variables, files, and classes:"
      headers={["Language / Tech", "Variables & Functions", "Classes & Components", "Constants", "Files / Assets"]}
      rows={[
        { label: "JavaScript / TypeScript", values: ["camelCase", "PascalCase", "CONSTANT_CASE", "kebab-case / camelCase"] },
        { label: "Python", values: ["snake_case", "PascalCase", "CONSTANT_CASE", "snake_case"] },
        { label: "Rust", values: ["snake_case", "PascalCase", "CONSTANT_CASE", "snake_case"] },
        { label: "C# (.NET)", values: ["camelCase / PascalCase", "PascalCase", "PascalCase", "PascalCase"] },
        { label: "HTML & CSS", values: ["kebab-case (Class names)", "-", "-", "kebab-case"] }
      ]}
    />

    <!-- Section: Conversion Examples -->
    <ExampleCard
      title="Casing Format Conversion Examples"
      description="Study the raw inputs and conversion results for common multi-word strings:"
      examples={[
        { label: "API Gateway Configuration Setup", input: "api-gateway-config-setup", output: "apiGatewayConfigSetup", badge: "camelCase" },
        { label: "User Session Database Key", input: "user_session_db_key", output: "USER_SESSION_DB_KEY", badge: "CONSTANT_CASE" },
        { label: "Main Navigation Header Layout", input: "main-navigation-header-layout", output: "MainNavigationHeaderLayout", badge: "PascalCase" },
        { label: "HTTP Header Authorization Key", input: "http authorization header", output: "HTTP-Authorization-Header", badge: "Train-Case" }
      ]}
    />

    <!-- Section: Language Support -->
    <LanguageSupport
      languages={languageCodes}
      title="Programmatic Case Conversion Code Snippets"
      description="Integrate these regex-free or regular expression conversion utilities into your projects:"
    />

    <!-- Section: Common Mistakes -->
    <CommonMistakes
      mistakes={mistakesList}
      title="Common Casing Pitfalls for Software Engineers"
      description="Improper casing can break routing configurations, database builds, and build processes. Avoid these mistakes:"
    />

    <!-- Section: Features -->
    <BestPractices
      title="Advanced Case Converter Features for Developers"
      description="Our case converter includes several specialized controls to fit professional engineering workflows:"
      practices={[
        { title: "Line-by-Line Batch Mode", description: "Convert lists of properties, database columns, or variables independently. Perfect for refactoring large files or mapping database records to API payloads." },
        { title: "Interactive Diffing Engine", description: "Toggle 'Show Diff' to view exact character modifications. Deleted elements are flagged in red (with strikethroughs) and insertions in emerald green, allowing easy validation of spacing and character deletions." },
        { title: "All Cases at a Glance", description: "For short entries, the tool shows a dynamic grid containing all 13 case variations side-by-side. Copy any casing instantly without changing your main active settings." },
        { title: "Local Sandboxed Processing", description: "No data is transmitted outside your browser. Text processing uses native client APIs to guarantee complete security for proprietary code, config keys, and sensitive logs." }
      ]}
    />

    <!-- Section: Official References -->
    <OfficialReferences
      references={references}
    />
  </div>
</ToolPageLayout>
