---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
import { CronGenerator } from '../../components/CronGenerator';
import ComparisonTable from '../../components/content/ComparisonTable.astro';
import BestPractices from '../../components/content/BestPractices.astro';
import CommonMistakes from '../../components/content/CommonMistakes.astro';
import LanguageSupport from '../../components/content/LanguageSupport.astro';
import PrivacyBadge from '../../components/content/PrivacyBadge.astro';
import OfficialReferences from '../../components/content/OfficialReferences.astro';
import RelatedTools from '../../components/content/RelatedTools.astro';

const faqs = [
  {
    question: "What is a cron expression and how is it structured?",
    answer: "A cron expression is a compact string representation used to schedule background jobs or tasks in UNIX-like systems. It consists of 5 fields separated by white space: <code>minute</code> (0-59), <code>hour</code> (0-23), <code>day of month</code> (1-31), <code>month</code> (1-12 or JAN-DEC), and <code>day of week</code> (0-6 or SUN-SAT). Standard UNIX schedules execute tasks when all fields match the current system time."
  },
  {
    question: "How does the step or interval syntax (/) work in cron?",
    answer: "The slash (<code>/</code>) character is used to specify step increments. For example, <code>*/5</code> in the minutes field means 'every 5 minutes'. You can also use it with ranges: <code>10-45/15</code> means 'every 15 minutes starting at minute 10 and ending at minute 45' (executing at minutes 10, 25, and 40)."
  },
  {
    question: "What is the difference between standard UNIX cron and non-standard crons?",
    answer: "Standard UNIX cron (crontab) utilizes exactly 5 fields. Some programming frameworks or cloud scheduler platforms (like Quartz, Spring Scheduler, or AWS EventBridge) support non-standard crons with 6 or 7 fields, adding <code>seconds</code> at the beginning and optionally <code>years</code> at the end. This tool focuses on standard 5-field UNIX crontab configurations."
  },
  {
    question: "How do the Day of Month and Day of Week fields interact in cron?",
    answer: "In UNIX cron, if both the Day of Month and Day of Week fields are restricted (i.e. neither is a wildcard <code>*</code>), the scheduler evaluates them using an <strong>OR</strong> operation instead of an AND operation. This means the job will run if <em>either</em> the current day matches the Day of Month selection <em>or</em> it matches the Day of Week selection."
  },
  {
    question: "How do I specify multiple specific values in a single cron field?",
    answer: "You can specify a list of values by separating them with commas (<code>,</code>). For example, entering <code>0,15,30,45</code> in the minutes field will schedule the job to run at the beginning, quarter-past, half-past, and quarter-to hours."
  },
  {
    question: "Can I use text names for months and weekdays in cron expressions?",
    answer: "Yes, standard UNIX cron supports 3-letter case-insensitive abbreviations for months (e.g. <code>JAN, FEB, MAR</code>) and weekdays (e.g. <code>SUN, MON, TUE</code>). When using names, you cannot specify ranges or lists of names in some older cron implementations, so numbers are generally preferred for maximum compatibility."
  },
  {
    question: "Is Sunday represented by 0 or 7 in cron?",
    answer: "In UNIX crontab, Sunday is represented by both <code>0</code> and <code>7</code>. They are completely equivalent and evaluate to the same weekday condition. Monday is 1, and Saturday is 6."
  },
  {
    question: "What does the wildcard (*) symbol mean in a cron expression?",
    answer: "The asterisk (<code>*</code>) is a wildcard symbol representing 'all values'. Placing it in a field means the cron job will execute for every possible value in that position. For example, a <code>*</code> in the hour field means it runs during every hour."
  },
  {
    question: "How do I schedule a job to run only on weekdays (Monday through Friday)?",
    answer: "To target weekdays, set the Day of Week field (the 5th field) to <code>1-5</code>. For example, <code>0 9 * * 1-5</code> will execute the cron job at exactly 9:00 AM every Monday through Friday."
  },
  {
    question: "Is my cron string parsed securely in this generator?",
    answer: "Yes. Like all tools on useUtils, the Cron Expression Generator runs 100% client-side in your web browser. No data, queries, or selections are sent to external servers or logged. Your system's backend cron patterns remain completely private."
  },
  {
    question: "How do I specify ranges in a cron expression?",
    answer: "Ranges are defined using the hyphen (<code>-</code>) character. For example, <code>9-17</code> in the hours field means the job will run during every hour starting from 9:00 AM through 5:00 PM inclusive."
  },
  {
    question: "Can I schedule jobs to run every N seconds in crontab?",
    answer: "Standard UNIX crontabs only support a minimum resolution of 1 minute. If you need sub-minute executions, you can write a wrapper script that executes your command, sleeps for N seconds, and runs again in a loop, or use systemd timers."
  },
  {
    question: "How do I view or edit my system cron jobs on Linux?",
    answer: "Run <code>crontab -l</code> in your terminal to list the active jobs for the current user. To edit the jobs, run <code>crontab -e</code>, which launches the default text editor defined in your environment."
  },
  {
    question: "Why do cron jobs fail with a 'command not found' error?",
    answer: "Cron runs commands in a very restricted shell environment with a minimal <code>PATH</code> variable (usually just <code>/usr/bin:/bin</code>). It will fail to find custom scripts or binaries. To fix this, always use absolute paths for commands (e.g. <code>/usr/local/bin/node</code> instead of <code>node</code>)."
  },
  {
    question: "How do I redirect cron stdout and stderr outputs to a log file?",
    answer: "You can redirect standard output and standard error using redirection operators. For example, <code>* * * * * /path/to/script.sh >> /var/log/myjob.log 2>&1</code> appends all outputs and errors to the specified log file."
  },
  {
    question: "What is anacron and how does it relate to cron?",
    answer: "Anacron is a sibling scheduler designed for desktops or laptops that do not run 24 hours a day. Unlike cron, which misses execution if the computer is turned off, anacron tracks missing jobs and runs them immediately when the system boots up."
  },
  {
    question: "What are crontab nicknames?",
    answer: "Many cron versions support nicknames that replace the 5-field syntax. These include: <code>@hourly</code> (0 * * * *), <code>@daily</code> (0 0 * * *), <code>@weekly</code> (0 0 * * 0), <code>@monthly</code> (0 0 1 * *), and <code>@reboot</code> (runs once at system startup)."
  },
  {
    question: "Can cron jobs run concurrently?",
    answer: "Yes. If a cron job is scheduled to run every minute and takes 2 minutes to complete, cron will start a second instance while the first is still running. To prevent this concurrency, use lock wrappers like <code>flock</code> or <code>sem-run</code>."
  },
  {
    question: "What timezone does crontab execute in?",
    answer: "Crontab tasks run in the local timezone of the cron daemon. On most servers, this timezone is set to UTC, but you can override it on modern systems by setting a <code>CRON_TZ</code> variable at the top of the crontab file."
  },
  {
    question: "What does the 'L' character represent in some crons?",
    answer: "The 'L' character stands for 'Last'. In the Day of Month field, it represents the last day of the month (e.g. 28, 30, or 31). In the Day of Week field, it represents the last weekday of the month (e.g. <code>5L</code> means last Friday)."
  },
  {
    question: "How do I disable email notifications from cron?",
    answer: "By default, cron emails the system administrator with any output from the job. To disable this, set <code>MAILTO=''</code> at the top of your crontab file, or redirect all command outputs to <code>/dev/null</code>."
  }
];

const headers = ["Field Position", "Field Identifier", "Allowed Range", "Special Toggles", "Example Syntax"];
const rows = [
  {
    label: "1",
    values: ["Minute", "0 - 59", "<code>* , - /</code>", "<code>*/15</code> (every 15 min)"]
  },
  {
    label: "2",
    values: ["Hour", "0 - 23", "<code>* , - /</code>", "<code>9-17</code> (9 AM to 5 PM)"]
  },
  {
    label: "3",
    values: ["Day of Month", "1 - 31", "<code>* , - / ? L W</code>", "<code>1,15</code> (1st and 15th)"]
  },
  {
    label: "4",
    values: ["Month", "1 - 12 (or JAN-DEC)", "<code>* , - /</code>", "<code>*/3</code> (quarterly)"]
  },
  {
    label: "5",
    values: ["Day of Week", "0 - 6 (or SUN-SAT)", "<code>* , - / ? L #</code>", "<code>1-5</code> (Mon to Fri)"]
  }
];

const practices = [
  {
    title: "Always Use Absolute Paths",
    description: "Always write full binary paths in crontabs (like <code>/usr/bin/python3</code> instead of <code>python3</code>) to prevent system path resolution failures."
  },
  {
    title: "Redirect Output to Logs",
    description: "Redirect stdout and stderr (<code>>> /var/log/app.log 2>&1</code>) to prevent filling local mailbox buffers and to track execution failures."
  },
  {
    title: "Configure Locking for Long Tasks",
    description: "Use lock utilities like <code>flock -n /var/run/myjob.lock</code> to prevent multiple instances of long tasks from executing concurrently."
  },
  {
    title: "Set PATH variables explicitly",
    description: "Define the PATH environment variable at the top of your crontab file to ensure referenced commands resolve correctly without fully qualified paths."
  }
];

const mistakes = [
  {
    title: "Writing Standard Schedulers with seconds",
    description: "Writing 6 fields (adding seconds) in a standard Linux crontab fails because standard crond daemons only accept exactly 5 fields.",
    fix: "Stick to the standard 5-field UNIX configuration for native crontabs."
  },
  {
    title: "Relying on Local Server timezone",
    description: "Assuming your cron executes in your local timezone can lead to jobs running at odd hours if servers are deployed in UTC datacenters.",
    fix: "Standardize your schedule parameters to UTC or configure the <code>CRON_TZ</code> variable."
  },
  {
    title: "Leaving wildcards in Minute fields",
    description: "Writing <code>* 9 * * 1-5</code> with the intent to run a job once at 9 AM actually executes it 60 times (once every minute from 9:00 to 9:59).",
    fix: "Define the minute field explicitly, e.g. <code>0 9 * * 1-5</code>."
  }
];

const languages = [
  {
    lang: "Bash (crontab)",
    code: `
# Edit crontab
crontab -e

# Format entry:
# Min Hour Day Month Weekday Command
0 3 * * * /usr/local/bin/backup-db.sh >> /var/log/backup.log 2>&1

# List crontab entries
crontab -l
    `,
    note: "Use crontab -e to open the current user schedule file and validate the syntax."
  },
  {
    lang: "Node.js (node-cron)",
    code: `
const cron = require('node-cron');

// Schedule task to run every 15 minutes
cron.schedule('*/15 * * * *', () => {
  console.log('Running task at:', new Date().toISOString());
});
    `,
    note: "Node-cron supports 5-field standard schedules inside local JavaScript daemon scripts."
  }
];

const references = [
  { title: "IEEE POSIX crontab Specification", url: "https://pubs.opengroup.org/onlinepubs/9699919799/utilities/crontab.html" },
  { title: "Debian Cron Daemon Documentation", url: "https://manpages.debian.org/bookworm/cron/cron.8.en.html" },
  { title: "Quartz Scheduler Cron Trigger Tutorial", url: "https://www.quartz-scheduler.org/documentation/quartz-2.3.0/tutorials/crontrigger.html" }
];
---

<ToolPageLayout
  title="Cron Expression Generator & Tester Online - useUtils"
  description="Generate, validate, translate, and test UNIX cron expressions in real-time. Features interactive visual builder, next execution times calculator, and syntax reference."
  keywords="cron expression generator, cron builder, crontab generator, cron translator, cron tester, next execution times cron, crontab helper, cron syntax"
  toolTitle="Cron Expression Generator"
  toolDescription="Visually build, parse, and validate UNIX crontab schedules in real-time. Automatically translate expressions to human-readable sentences and predict upcoming execution times locally in your browser."
  faqs={faqs}
>
  <CronGenerator client:load />

  <div slot="seo-content" class="flex flex-col gap-12 mt-10 max-w-4xl mx-auto w-full">
    <PrivacyBadge />

    <ComparisonTable 
      headers={headers} 
      rows={rows} 
      title="Cron Syntax Field Structure" 
      description="Refer to this layout mapping to understand field order, value limits, and active character options:"
    />

    <BestPractices 
      practices={practices} 
      title="Crontab Best Practices" 
      description="Apply these standards to ensure cron execution security and logging clarity in Linux environments:"
    />

    <CommonMistakes 
      mistakes={mistakes} 
      title="Common Cron Mistakes" 
      description="Avoid these common errors when writing scheduling strings for servers or application scripts:"
    />

    <LanguageSupport 
      languages={languages} 
      title="Programmatic Schedulers" 
      description="Implement background scheduler operations directly in codebases using standard tools:"
    />

    <OfficialReferences 
      references={references} 
      title="Scheduling Standards & References" 
    />

    <RelatedTools />
  </div>
</ToolPageLayout>
