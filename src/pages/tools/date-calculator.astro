---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
import { DateCalculator } from '../../components/DateCalculator';
import ComparisonTable from '../../components/content/ComparisonTable.astro';
import BestPractices from '../../components/content/BestPractices.astro';
import CommonMistakes from '../../components/content/CommonMistakes.astro';
import LanguageSupport from '../../components/content/LanguageSupport.astro';
import PrivacyBadge from '../../components/content/PrivacyBadge.astro';
import OfficialReferences from '../../components/content/OfficialReferences.astro';
import RelatedTools from '../../components/content/RelatedTools.astro';

const faqs = [
  {
    question: "How do I calculate the exact number of days between two dates?",
    answer: "You can calculate the exact days between two dates by entering Date A (Start) and Date B (End) into our Date Difference calculator. The engine computes the absolute millisecond delta and converts it to total days. You can choose whether to exclude weekends or make the calculation inclusive of the final day."
  },
  {
    question: "What are business days and how are they counted?",
    answer: "Business days (or working days) are standard days of the week dedicated to business operations, typically Monday through Friday. Our calculator counts business days by iterating through the calendar span between your start and end dates and skipping Saturdays and Sundays. This is useful for project managers tracking milestones and calculating business lead times."
  },
  {
    question: "How do I add or subtract days, weeks, months, or years from a date?",
    answer: "Under the <strong>Date Adjuster</strong> tab, specify your base start date, enter the numerical adjustment value, and select the target unit (Days, Weeks, Months, Years, Hours, or Minutes). Choose the operator (Add or Subtract) and the calculator will output the exact target date, including weekday names and ISO 8601 formatting."
  },
  {
    question: "How do I calculate total hours and minutes for my timesheet?",
    answer: "Select the <strong>Timesheet Accumulator</strong> tab. You can add multiple shifts either by entering clock time ranges (e.g., <code>09:00</code> to <code>17:00</code>) or typing raw durations (e.g., <code>3.5h</code> or <code>1h 15m</code>). The accumulator automatically sums these times, displays the total duration in a clean <code>Xh Ym</code> format, and computes total earnings based on your hourly rate."
  },
  {
    question: "Does the date calculator account for leap years?",
    answer: "Yes, 100%. The date calculator runs on the JavaScript native <code>Date</code> engine which automatically handles leap years (adding February 29th for years divisible by 4, except for century years not divisible by 400). Adding 1 year or 365 days across a leap boundary will yield accurate calendar dates."
  },
  {
    question: "What does it mean to make date calculations inclusive?",
    answer: "Standard date subtraction calculates the elapsed time between two points, meaning the end date itself is not fully counted. Enabling the <strong>Include final day in count</strong> option appends 1 full day to the output, which is standard practice in contract negotiations or holiday calculations where both the start and end days are counted as full working days."
  },
  {
    question: "Do timezones affect date difference calculations?",
    answer: "Our Date Calculator executes computations using the local browser timezone. This ensures that date changes align with your physical location. For timezone-independent storage, the tool provides the corresponding Coordinated Universal Time (UTC) and ISO 8601 string outputs."
  },
  {
    question: "What is the difference between calendar days and working days?",
    answer: "Calendar days represent every consecutive day on the calendar, including weekends and public holidays. Working days or business days represent weekdays only (Monday through Friday), excluding Saturdays and Sundays. Our tool provides a toggle to display both values side-by-side."
  },
  {
    question: "Is my timesheet or financial billing data secure and private?",
    answer: "Yes, absolutely. Like all tools on useUtils, the Date & Time Duration Calculator runs entirely on the client side in your web browser. No dates, notes, hourly rates, or timesheets are ever sent to a server. You can use this tool fully offline with zero privacy risks."
  },
  {
    question: "How can I add up raw durations with decimals (e.g., 2.5 hours)?",
    answer: "In the Timesheet Accumulator, select 'Raw Hours' and enter decimal strings like <code>2.5h</code> or <code>2.5 hours</code>. The parser translates <code>2.5h</code> into 2 hours and 30 minutes, adding it accurately to your overall timesheet total."
  },
  {
    question: "How does the tool handle overnight timesheet shifts?",
    answer: "The time range parser handles overnight clock boundaries automatically. If the end time is chronologically earlier than the start time (for example, a night shift from <code>22:00</code> to <code>06:00</code>), the engine assumes the shift spans across midnight and correctly adds 8 hours of duration to your timesheet."
  },
  {
    question: "Can I filter out public holidays automatically?",
    answer: "Currently, our tool filters standard weekends (Saturdays and Sundays) out of the working days calculation. Public holidays vary widely by national and regional jurisdictions, so they are not automated. You can subtract individual holiday counts using the Date Adjuster."
  },
  {
    question: "How do I calculate the number of weeks between two dates?",
    answer: "The Date Difference tab computes the division of total days by 7 and returns a detailed weeks-and-remaining-days breakdown (e.g. <code>4 weeks, 2 days</code>) next to total day results."
  },
  {
    question: "What happens when I add 1 month to January 31st?",
    answer: "The native JavaScript Date engine resolves month overflow by wrapping to the next month. Adding 1 month to January 31st wraps to March 3rd (in standard years) because February has only 28 days. Our calculator handles calendar transitions safely."
  },
  {
    question: "How is the billing amount calculated?",
    answer: "In the Timesheet Accumulator, we sum the minutes for all shift rows. The total minutes are divided by 60 to derive a fractional hour value, which is then multiplied by your custom hourly rate parameter to display earnings."
  },
  {
    question: "Can I input negative numbers in the Date Adjuster?",
    answer: "Yes. While the adjuster provides an explicit 'Add' vs 'Subtract' operator toggle, inputting numeric intervals calculates offsets relative to your configuration."
  },
  {
    question: "What is ISO 8601 week numbering?",
    answer: "ISO 8601 week numbering defines the first week of the year as the week containing the first Thursday of the year, with weeks starting on Mondays. The Date Difference tab provides additional week counts conforming to this standard."
  },
  {
    question: "Can the timesheet parser read '30m' as half an hour?",
    answer: "Yes, typing <code>30m</code> or <code>30 minutes</code> translates to 0.5 hours or 30 minutes of accumulated duration in the timesheet shift rows."
  },
  {
    question: "How can I calculate how many days are left in the current year?",
    answer: "Set Date A to the current date and Date B to December 31st of this year. The Date Difference calculator will return the exact days remaining."
  },
  {
    question: "What is the difference between UTC date math and local date math?",
    answer: "UTC date math calculates time deltas using standard GMT boundaries, ignoring local daylight saving shifts. Local date math accounts for daylight saving transitions (like a 23-hour day when clocks spring forward)."
  },
  {
    question: "Does this tool support keyboard copy shortcuts?",
    answer: "Yes. Pressing <code>Command+C</code> (Mac) or <code>Control+C</code> (Windows) anywhere on the page copies a formatted text summary of your calculations instantly."
  }
];

const headers = ["Calculation Feature", "Day Resolution", "Weekend Filtering", "Best Application"];
const rows = [
  {
    label: "Calendar Difference",
    values: ["Consecutive days", "No (includes Sat/Sun)", "Contract periods, interest cycles, scheduling"]
  },
  {
    label: "Business Difference",
    values: ["Weekdays only", "Yes (skips Sat/Sun)", "Project milestones, SLA shipping, delivery window checks"]
  },
  {
    label: "Date Offset Adjuster",
    values: ["Target dates via offsets", "Optional (skips weekends)", "Adding lead time, estimating sprint completion dates"]
  },
  {
    label: "Shift Accumulation",
    values: ["Summed hours & minutes", "N/A", "Freelance timesheets, contractor billing summaries"]
  }
];

const practices = [
  {
    title: "Verify Inclusive Flag in Contracts",
    description: "Always align on whether date ranges are inclusive of both start and end days before signing legal contracts or estimating hosting terms."
  },
  {
    title: "Store Date Math Bounds in UTC",
    description: "When saving project timelines to a database, store datetime records in UTC. Perform timezone-aware local math only on output interfaces."
  },
  {
    title: "Audit Timesheet Overlap Shifts",
    description: "Check for duplicate time entries when logging shifts in timesheets to ensure overlapping clock intervals do not double-bill clients."
  },
  {
    title: "Account for Month Length Variations",
    description: "When programming recurring date math (like billing intervals), check boundaries (e.g. 31st of the month) to prevent missing February cycles."
  }
];

const mistakes = [
  {
    title: "Adding Days by Multiplying Milliseconds",
    description: "Adding days to JavaScript dates by doing <code>date.getTime() + 24 * 60 * 60 * 1000</code> fails across daylight saving boundaries where days have 23 or 25 hours.",
    fix: "Always adjust dates using native setter methods: <code>date.setDate(date.getDate() + offset)</code>."
  },
  {
    title: "Relying on System Timezones on Servers",
    description: "Calculating differences using server default clocks causes drift bugs if your hosting containers are located in other timezones.",
    fix: "Standardize all backend execution threads in Coordinated Universal Time (UTC)."
  },
  {
    title: "Double-Counting Dates in Ingestion Ranges",
    description: "Subtracting two identical calendar dates returns 0, but users often expect an inclusive range to indicate 1 day of work.",
    fix: "Evaluate whether you need to toggle the inclusive final day parameter for user profiles."
  }
];

const languages = [
  {
    lang: "JavaScript (Date)",
    code: `
const dateA = new Date('2026-06-01');
const dateB = new Date('2026-06-15');

// Absolute difference in days
const diffMs = Math.abs(dateB - dateA);
const diffDays = Math.ceil(diffMs / (1000 * 60 * 60 * 24));
console.log('Total Days:', diffDays);

// Adjusting a date safely
const adjusted = new Date(dateA);
adjusted.setDate(adjusted.getDate() + 90);
console.log('Adjusted Date:', adjusted.toISOString().split('T')[0]);
    `,
    note: "Use setDate() and getDate() natively to ensure JS accounts for DST shifts and month transitions."
  },
  {
    lang: "Python (datetime)",
    code: `
from datetime import datetime, timedelta

# Days difference
date_a = datetime.fromisoformat('2026-06-01')
date_b = datetime.fromisoformat('2026-06-15')
delta = date_b - date_a
print('Days between:', delta.days)

# Date adjuster
adjusted = date_a + timedelta(days=90)
print('Adjusted:', adjusted.strftime('%Y-%m-%d'))
    `,
    note: "Python's timedelta represents duration differences, making offset math readable and fast."
  }
];

const references = [
  { title: "W3C Date and Time Formats Standard", url: "https://www.w3.org/TR/NOTE-datetime" },
  { title: "ISO 8601 Calendar Date and Time Representation", url: "https://www.iso.org/iso-8601-date-and-time-format.html" },
  { title: "Mozilla Developer Docs: Native JS Date API", url: "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Date" }
];
---

<ToolPageLayout
  title="Date Calculator: Date Difference, Business Days & Timesheet Accumulator"
  description="Calculate days between dates, business/working days, and add or subtract time offsets. Features an interactive timesheet duration accumulator and billing calculator locally in your browser."
  keywords="date calculator, date difference calculator, days between dates, business days calculator, working days calculator, add days to date, date subtract, timesheet calculator, hours accumulator, timesheet builder, epoch date math"
  toolTitle="Date & Time Duration Calculator"
  toolDescription="Find the exact calendar difference between two dates, add or subtract time offsets, and calculate cumulative timesheet shifts with local project billing estimation. Processed 100% locally."
  faqs={faqs}
>
  <DateCalculator client:load />

  <div slot="seo-content" class="flex flex-col gap-12 mt-10 max-w-4xl mx-auto w-full">
    <PrivacyBadge />

    <ComparisonTable 
      headers={headers} 
      rows={rows} 
      title="Comparing Date Calculations" 
      description="Choose the most appropriate calculation method based on your project schedule, invoice calculations, or timeline goals:"
    />

    <BestPractices 
      practices={practices} 
      title="Date Arithmetic Best Practices" 
      description="Apply these industry guidelines to resolve timezone offsets and maintain project schedule integrity:"
    />

    <CommonMistakes 
      mistakes={mistakes} 
      title="Common Date Math Misconceptions" 
      description="Ensure your software algorithms perform date offsets and interval checks reliably by avoiding these bugs:"
    />

    <LanguageSupport 
      languages={languages} 
      title="Programmatic Date Arithmetic" 
      description="Implement date differences and offset math programmatically using standard utilities:"
    />

    <OfficialReferences 
      references={references} 
      title="Standard Date & Time Specifications" 
    />

    <RelatedTools />
  </div>
</ToolPageLayout>
