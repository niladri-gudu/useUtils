---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
import { FakeUserGenerator } from '../../components/FakeUserGenerator';
import ComparisonTable from '../../components/content/ComparisonTable.astro';
import BestPractices from '../../components/content/BestPractices.astro';
import CommonMistakes from '../../components/content/CommonMistakes.astro';
import LanguageSupport from '../../components/content/LanguageSupport.astro';
import PrivacyBadge from '../../components/content/PrivacyBadge.astro';
import OfficialReferences from '../../components/content/OfficialReferences.astro';
import RelatedTools from '../../components/content/RelatedTools.astro';

const faqs = [
  {
    question: "What is a mock data generator and why is it used?",
    answer: "A mock data generator is a development utility that fabricates realistic-looking datasets (such as user accounts, pricing lists, or sensor telemetry) that share the structure of real production databases. Developers and designers use it to build prototypes, seed staging databases, verify API integrations, and write automated tests without relying on or exposing sensitive real-world user data."
  },
  {
    question: "How does this tool generate fake user data without a backend server?",
    answer: "Our Fake User Generator runs 100% locally in your browser using native client-side JavaScript. When you adjust the fields or click regenerate, the data is generated instantaneously using random seed mathematics and built-in dictionaries. Because there are no backend API requests, the tool functions fully offline and guarantees complete data privacy."
  },
  {
    question: "Is the generated mock data safe to use in public environments?",
    answer: "Yes, the generated data is entirely fabricated and randomized. It contains no real Personally Identifiable Information (PII) or authentic user credentials. It is 100% safe to use in demo videos, public git repositories, QA testing platforms, staging environments, and client mockups."
  },
  {
    question: "How do I download my custom mock data in CSV format?",
    answer: "First, design your schema by adding and naming fields. Then, select the <strong>CSV</strong> tab on the output window. You will see a live preview of the comma-separated output. Click the <strong>Download</strong> button, and your browser will compile the table locally into a <code>.csv</code> file and save it to your downloads folder immediately."
  },
  {
    question: "Can I generate custom numeric ranges, decimals, or custom lists?",
    answer: "Yes. By selecting the <strong>Random Integer</strong> or <strong>Random Decimal</strong> types, you can define custom minimum and maximum ranges. Choosing the <strong>Custom List Picker</strong> opens a text field where you can input comma-separated values (e.g. <code>Admin, User, Editor</code>). The engine will pick one random item from your list for each record."
  },
  {
    question: "How do I convert my mock schema into TypeScript interfaces?",
    answer: "Our designer automates type creation. Toggle the <strong>TypeScript</strong> tab in the format toolbar. The engine parses the schema structure, maps numeric properties (like latitudes, coordinates, and integers) to the TypeScript <code>number</code> type, booleans to <code>boolean</code>, and text strings to <code>string</code>. It exports a copyable, type-safe interface declaration instantly."
  },
  {
    question: "Can I seed my SQL database directly using this mock data generator?",
    answer: "Yes, you can generate raw SQL inserts. Select the <strong>SQL</strong> tab and enter your database table name in the configuration input. The utility converts each generated record into an <code>INSERT INTO `table`</code> statement, escaping text quotes correctly. Copy the code block and execute it directly in your database terminal or client."
  },
  {
    question: "How does the local geometric SVG avatar generator work?",
    answer: "Instead of querying third-party gravatar networks which can fail offline or track requests, our utility implements a local vector generator. It hashes each username string to select a background gradient and overlays randomized geometric paths (circles, polygons, rectangles) with varying opacities. The SVG is then converted to a base64 Data URI, allowing offline image loads."
  },
  {
    question: "What is the maximum limit of rows I can generate locally?",
    answer: "The quantity slider is optimized for up to 200 records. Since all string parsing, formatting, and syntax rendering occur on the browser's single main thread, keeping generation under 200 records ensures sub-millisecond execution and prevents UI freezing, while providing ample data for mockups."
  },
  {
    question: "Is this Fake User Generator free to use?",
    answer: "Yes, useUtils.com provides all developer tools completely free with no subscriptions, advertisements, paywalls, watermarks, or account logins. All operations compile locally, keeping your workspace fast and lightweight."
  },
  {
    question: "How do I format generated fields as valid JSON?",
    answer: "The tool automatically outputs valid, prettified JSON arrays with correct syntax, double-quoted keys, and structured indentation. You can copy the code or save it directly as a <code>.json</code> file for immediate use in Mock APIs or local testing files."
  },
  {
    question: "Is mock data generation GDPR compliant?",
    answer: "Yes. Since the data is created completely from synthetic lists and random numbers, it does not correspond to any real living individual. Therefore, GDPR, HIPAA, and other privacy frameworks do not apply, making it safe to distribute and use freely."
  },
  {
    question: "How do I import the generated CSV mock files into Microsoft Excel?",
    answer: "You can open the downloaded CSV file directly in Microsoft Excel. Go to the Data tab, select 'From Text/CSV', specify UTF-8 encoding, set the delimiter to Comma, and load the dataset to maintain formatting for columns and headers."
  },
  {
    question: "What databases are supported by the SQL generation format?",
    answer: "The generated INSERT queries conform to standard SQL-92 protocols. This syntax is fully compatible with MySQL, PostgreSQL, MariaDB, SQLite, Microsoft SQL Server, and Oracle Database."
  },
  {
    question: "Can I simulate IoT device telemetry data?",
    answer: "Yes. By customizing fields for device ID (using UUID), temperature (using random decimals), status (using custom list picker), and dates, you can model realistic streams of time-series data to test data ingestion pipelines."
  },
  {
    question: "How are the fake email addresses generated?",
    answer: "Emails are formatted dynamically by joining a sanitized lowercase version of the generated first name and last name with popular dummy domains (e.g. <code>@example.com</code>, <code>@testmail.org</code>, or <code>@company.io</code>)."
  },
  {
    question: "Can I generate Boolean values?",
    answer: "Yes, the Boolean data type randomly yields <code>true</code> or <code>false</code> with a 50/50 probability, which is excellent for testing binary conditions like active accounts, notification preferences, or newsletter signups."
  },
  {
    question: "How are phone numbers formatted in the generator?",
    answer: "Phone numbers are generated using standard US mock formats (e.g., <code>555-XXX-XXXX</code>) to ensure they pass standard regex formatting checks in application input fields without mapping to real active phone lines."
  },
  {
    question: "What is the difference between a Random Integer and a Random Decimal?",
    answer: "A Random Integer generates whole numbers (like age or quantity count) within your min and max bounds. A Random Decimal generates numbers with decimal precision (like price or sensor reading) within your bounds, supporting fractional checks."
  },
  {
    question: "How are paragraphs and sentences generated?",
    answer: "The engine uses a client-side lorem-ipsum word picker to assemble grammatically-styled sentences and paragraphs, providing realistic text lengths for descriptions, bios, and article summaries."
  },
  {
    question: "Can I use this tool offline?",
    answer: "Absolutely. Once the page is loaded, all generator utilities, schema builders, formatting engines, and download operations run on your local CPU. No network connection is required to design schemas or generate data."
  }
];

const headers = ["Export Format", "File Extension", "Primary Ecosystem", "Best Use Case"];
const rows = [
  {
    label: "JSON",
    values: ["<code>.json</code>", "REST APIs, NoSQL, Javascript Web Apps", "Seeding Document databases, mocking API endpoints"]
  },
  {
    label: "CSV",
    values: ["<code>.csv</code>", "Spreadsheets, Python Pandas, Data Science", "Importing into Excel, loading tables into analytic platforms"]
  },
  {
    label: "YAML",
    values: ["<code>.yaml</code> / <code>.yml</code>", "DevOps, Kubernetes configs, config stores", "Seeding key-value parameters and platform structures"]
  },
  {
    label: "SQL",
    values: ["<code>.sql</code>", "Relational Databases (PostgreSQL, MySQL)", "Direct database migrations and staging schema seeding"]
  },
  {
    label: "TypeScript",
    values: ["<code>.ts</code>", "Frontend codebases, API type safety", "Creating copy-paste interface declarations for React/Angular/Vue"]
  }
];

const practices = [
  {
    title: "Always Seed Staging with Fake Data",
    description: "Never migrate real production databases down to staging or local environments. Always seed testing environments with synthetic mock data to ensure privacy compliance."
  },
  {
    title: "Match Production Schemas Precisely",
    description: "Ensure your mock field names and data types correspond exactly to your production database schema to capture bugs early during development."
  },
  {
    title: "Use Strict Types in Frontend Models",
    description: "Leverage the TypeScript export tab to auto-generate interface types, keeping your frontend views strictly typed against API payloads."
  },
  {
    title: "Sanitize SQL Imports",
    description: "When importing generated SQL inserts, execute them in transactions so that you can roll back easily if schema mismatch issues crop up."
  }
];

const mistakes = [
  {
    title: "Using Real PII for Sandbox Testing",
    description: "Reusing actual customer email addresses, passwords, or phone numbers in development builds violates GDPR, HIPAA, and corporate security guidelines.",
    fix: "Always fabricate mock profiles using random names and placeholder domains like <code>@example.com</code>."
  },
  {
    title: "Exposing Real APIs during UI Mocking",
    description: "Waiting for backend services to be fully built before testing frontend screens slows down velocity and creates tight coupling.",
    fix: "Generate mock JSON mockups and feed them into local fetch handlers to design interfaces asynchronously."
  },
  {
    title: "Ignoring Field Limits and Boundaries",
    description: "Failing to check how UI components render when text is too long or numbers are too large can cause broken UI layouts in production.",
    fix: "Create fields with maximum decimal lengths or paragraphs to stress-test layout constraints."
  }
];

const languages = [
  {
    lang: "Node.js (Faker)",
    code: `
import { faker } from '@faker-js/faker';

// Generate a random user
export function generateUser() {
  return {
    id: faker.string.uuid(),
    name: faker.person.fullName(),
    email: faker.internet.email(),
    role: faker.helpers.arrayElement(['admin', 'editor', 'user']),
    registeredAt: faker.date.past()
  };
}

console.log(generateUser());
    `,
    note: "The @faker-js/faker package is the industry standard for programmatic mock data generation in Node/TS."
  },
  {
    lang: "Python (Faker)",
    code: `
from faker import Faker
fake = Faker()

# Generate profile data
def generate_profile():
    return {
        "id": fake.uuid4(),
        "name": fake.name(),
        "email": fake.email(),
        "address": fake.address(),
        "created_at": fake.date_this_decade().isoformat()
    }

print(generate_profile())
    `,
    note: "Python's faker module provides rich localized generators for names, jobs, addresses, and dates."
  }
];

const references = [
  { title: "W3C CSV Specification and Standard", url: "https://www.w3.org/TR/tabular-data-model/" },
  { title: "TypeScript Interfaces documentation", url: "https://www.typescriptlang.org/docs/handbook/2/everyday-types.html#interfaces" },
  { title: "JSON Standard ECMA-404", url: "https://www.ecma-international.org/publications-and-standards/standards/ecma-404/" }
];
---

<ToolPageLayout
  title="Fake User & Mock Data Generator: Schema Builder (JSON, CSV, SQL, YAML)"
  description="Generate fake user profiles, database mock rows, IoT telemetry, and customize schemas in real-time. Design fields, set constraints, and export to JSON, CSV, YAML, SQL, and TypeScript interfaces. 100% offline and secure local processing."
  keywords="fake user generator, mock data generator, random user generator, test data generator, json generator, csv generator, sql insert generator, typescript interface generator, local developer tools"
  toolTitle="Fake User & Mock Data Generator"
  toolDescription="Design custom database schemas visually. Set parameters for numeric data, location coords, contact strings, and custom lists. Export generated mock entries to JSON, CSV, YAML, SQL, and TypeScript interfaces instantly."
  faqs={faqs}
>
  <FakeUserGenerator client:load />

  <div slot="seo-content" class="flex flex-col gap-12 mt-10 max-w-4xl mx-auto w-full">
    <PrivacyBadge />

    <ComparisonTable 
      headers={headers} 
      rows={rows} 
      title="Comparing Data Export Formats" 
      description="Select the most appropriate serialization structure for your development pipeline, analytics stacks, or database seed needs:"
    />

    <BestPractices 
      practices={practices} 
      title="Mock Data Best Practices" 
      description="Follow these industry guidelines to manage sandboxed user profiles and database seed files safely and productively:"
    />

    <CommonMistakes 
      mistakes={mistakes} 
      title="Common Mocking Mistakes" 
      description="Avoid these common errors when structuring staging mockups and integration tests in test suites:"
    />

    <LanguageSupport 
      languages={languages} 
      title="Programmatic Mock Data Libraries" 
      description="Incorporate programmatic mock generation workflows directly into your local testing codebases:"
    />

    <OfficialReferences 
      references={references} 
      title="Developer Standards & Specifications" 
    />

    <RelatedTools />
  </div>
</ToolPageLayout>
