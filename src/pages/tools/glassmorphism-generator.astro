---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
import { GlassmorphismGenerator as GlassmorphismGeneratorComponent } from '../../components/GlassmorphismGenerator';
import BestPractices from '../../components/content/BestPractices.astro';
import CommonMistakes from '../../components/content/CommonMistakes.astro';
import OfficialReferences from '../../components/content/OfficialReferences.astro';
import LanguageSupport from '../../components/content/LanguageSupport.astro';
import ComparisonTable from '../../components/content/ComparisonTable.astro';
import ExampleCard from '../../components/content/ExampleCard.astro';
import PrivacyBadge from '../../components/content/PrivacyBadge.astro';
import RelatedTools from '../../components/content/RelatedTools.astro';

const faqs = [
  {
    question: "What is CSS Glassmorphism?",
    answer: "Glassmorphism is a popular user interface design trend that mimics the appearance of frosted glass. It is characterized by a translucent background (using alpha transparency), backdrop blurring, thin borders that simulate light reflections, and drop shadows to establish visual depth."
  },
  {
    question: "How do I create a glassmorphism card in CSS?",
    answer: "You can create a frosted glass card by combining a semi-transparent background color (e.g., `background: rgba(255, 255, 255, 0.1);`), a background blur filter (e.g., `backdrop-filter: blur(12px);`), a subtle borders color (e.g., `border: 1px solid rgba(255, 255, 255, 0.2);`), and a soft box shadow (e.g., `box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.1);`)."
  },
  {
    question: "What is CSS backdrop-filter: blur()?",
    answer: "The CSS `backdrop-filter` property applies graphical changes (like blur, saturation, or contrast) to the elements located <em>behind</em> the styled element. Unlike the standard `filter: blur()` property, which blurs the entire element along with its text and children, `backdrop-filter` blurs only the background visible through the element, keeping content crisp."
  },
  {
    question: "Why is CSS backdrop-filter not working in Safari?",
    answer: "Safari requires the vendor-prefixed version: `-webkit-backdrop-filter: blur(...);`. You must declare both properties in your CSS rules. Additionally, ensure that your element's background color is semi-transparent; if it is fully opaque, you will not see the blur effect."
  },
  {
    question: "How do I apply backdrop blur in Tailwind CSS?",
    answer: "In Tailwind CSS, use the `backdrop-blur` utility classes such as `backdrop-blur-sm`, `backdrop-blur-md`, or `backdrop-blur-lg`. For arbitrary custom blur values, you can use the bracket syntax: `backdrop-blur-[12px]`."
  },
  {
    question: "Does backdrop-filter affect web page performance?",
    answer: "Yes, dynamically blurring pixels on the fly is a GPU-intensive operation, particularly during scroll animations or viewport scaling. To optimize performance, avoid using too many large backdrop filters on a single page, and trigger hardware acceleration using `will-change: backdrop-filter;` or `transform: translateZ(0);`."
  },
  {
    question: "How do I add border gradients to glassmorphism?",
    answer: "To add a gradient border to a glassmorphism card, use the `border-image` property with a gradient generator, or layer an absolute positioned pseudo-element (like `::before`) with a gradient background behind your content, matching the card border-radius."
  },
  {
    question: "Is CSS Glassmorphism supported on mobile browsers?",
    answer: "Yes, modern iOS Safari, Google Chrome, and Android mobile browsers have solid support for `backdrop-filter`. However, older devices or low-spec Android systems may toggle off filters for battery efficiency or render them with latency during page scrolls."
  },
  {
    question: "What is the difference between filter: blur() and backdrop-filter: blur()?",
    answer: "`filter: blur()` blurs the element itself and all of its content (text, images, and child DOM nodes). `backdrop-filter: blur()` blurs the layers underneath the element, preserving the sharp legibility of the element's text and child elements."
  },
  {
    question: "How do I ensure WCAG accessibility compliance with glassmorphism?",
    answer: "Glassmorphism layouts can easily cause contrast issues if the text color clashes with background shapes showing through the blur. To ensure accessibility, use a higher tint opacity (e.g. `background: rgba(0, 0, 0, 0.45);` in dark mode), check color contrast ratios (aiming for WCAG AA minimum 4.5:1), and consider providing solid background fallbacks for high contrast user preferences."
  },
  {
    question: "How do I fallback gracefully if a browser does not support backdrop-filter?",
    answer: "You can write fallback rules using CSS feature queries: `@supports not (backdrop-filter: blur(1px)) { ... }`. Inside this query, set a higher background opacity or a solid color so the content remains readable in legacy browsers."
  },
  {
    question: "Can I use multiple background images with glassmorphism?",
    answer: "Yes, you can layer a semi-transparent glass panel over a textured grid background to enhance the sense of depth."
  },
  {
    question: "Does transparency affect color contrast?",
    answer: "Yes. Semi-transparent colors blend with the background beneath them. Calculations must evaluate the final flattened color values after blending."
  },
  {
    question: "What is the relative luminance threshold?",
    answer: "Luminance calculations evaluate screen brightness levels. Comparing text luminance against background luminance gives the contrast ratio."
  },
  {
    question: "Does this page feature a contrast accessibility check?",
    answer: "Yes. The page evaluates contrast ratios against white and black backgrounds in real-time."
  },
  {
    question: "What are the accessibility requirements for glassmorphic elements?",
    answer: "Ensure interactive elements (like input fields or buttons) maintain a 3:1 contrast ratio to remain recognizable."
  },
  {
    question: "Can I use glassmorphism with dark mode in Tailwind?",
    answer: "Yes. Use dark-tinted backgrounds for dark mode styling (e.g. `bg-zinc-950/20 dark:bg-zinc-950/40 backdrop-blur-md border border-zinc-800/30`)."
  },
  {
    question: "How does the alpha channel affect glassmorphic borders?",
    answer: "The alpha channel controls border transparency, letting the background color show through for a softer blend."
  },
  {
    question: "Does this generator run locally?",
    answer: "Yes, all computations are performed client-side in your web browser, ensuring complete privacy."
  },
  {
    question: "How does screen resolution affect backdrop blur?",
    answer: "The browser's layout engine recalculates the blur effect dynamically, keeping it crisp on high-density screens."
  }
];

const languageCodes = [
  {
    lang: "CSS",
    code: `
/* Frosted Glass overlay */
.glass-overlay {
  background: rgba(255, 255, 255, 0.1);
  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.2);
}
    `,
    note: "Modern CSS declarations using standard filter properties."
  },
  {
    lang: "Tailwind CSS",
    code: `
<!-- Frosted Glass Overlay -->
<div class="bg-white/10 backdrop-blur-md border border-white/20 shadow-xl p-6 rounded-2xl"></div>
    `,
    note: "Tailwind arbitrary bracket utility syntax."
  }
];

const mistakesList = [
  {
    title: "Omiting Backdrop Blur",
    description: "Setting background opacity without applying a `backdrop-filter` class, which creates simple transparent panels instead of a frosted glass effect."
  },
  {
    title: "Flat Monochromatic Backgrounds",
    description: "Placing glassmorphic cards over flat, solid backgrounds. The frosted effect relies on colorful or textured background elements underneath."
  },
  {
    title: "Harsh Solid Borders",
    description: "Using solid, opaque borders (like `border-white`) on transparent cards, which ruins the glass transition effect."
  }
];

const references = [
  {
    title: "W3C Filter Effects Module Level 1",
    url: "https://www.w3.org/TR/filter-effects-1/"
  },
  {
    title: "MDN Web Docs: backdrop-filter",
    url: "https://developer.mozilla.org/en-US/docs/Web/CSS/backdrop-filter"
  }
];
---

<ToolPageLayout
  title="CSS Glassmorphism Generator: Interactive Backdrop-Filter Builder"
  description="Design premium, frosted glass CSS effects visually. Customize blur, background color, opacities, border reflections, and soft drop shadows with live mockup widgets and copy standard CSS or Tailwind classes."
  keywords="css glassmorphism generator, glassmorphism generator, backdrop-filter blur, css backdrop-filter, tailwind glassmorphism, css glass effect, UI design tools"
  toolTitle="CSS Glassmorphism Generator"
  toolDescription="Create stunning, high-fidelity frosted glass effects for modern user interfaces. Fine-tune backdrop blur, surface color, opacities, borders, and ambient drop shadows. Test presets, preview on dynamic mockup widgets (credit cards, music players), and copy clean CSS or Tailwind CSS utility strings."
  faqs={faqs}
>
  <GlassmorphismGeneratorComponent client:load />

  <div slot="seo-content" class="flex flex-col gap-8 font-sans text-sm text-zinc-400">
    <PrivacyBadge />

    <div>
      <h2 class="text-xl font-semibold text-zinc-50 tracking-tight mb-4 flex items-center gap-2">
        <span class="w-1.5 h-6 bg-accent-emerald rounded-full"></span>
        Designing with CSS Glassmorphism
      </h2>
      <p class="leading-relaxed mb-4">
        Glassmorphism represents one of the most prominent aesthetic developments in modern user interface design, popularized by macOS Big Sur and Microsoft Fluent design languages. Rather than using flat opaque panels, glassmorphism uses translucency and backdrop blurring to place elements in a three-dimensional visual stack. This retains connection to background context while focusing user attention on overlay dialogs, cards, or notifications.
      </p>
      <p class="leading-relaxed">
        Designing glassmorphism that feels professional—rather than messy—requires careful calibration. If the backdrop blur is too low, background graphics will interfere with text legibility. If the border opacity is too high, the card feels flat and loses its glass-like fragility. Our generator simplifies this calculation, allowing you to instantly tweak values and test them against animated layouts or your own uploaded images.
      </p>
    </div>

    <ComparisonTable
      title="Glassmorphism Syntax Comparison"
      description="Compare representation syntax:"
      headers={["Property Style", "CSS Declaration Example", "Visual Effect", "Standard UI Role"]}
      rows={[
        { label: "Frosted Glass", values: ["background: rgba(255,255,255,0.1); backdrop-filter: blur(12px);", "White translucent tint with blur", "Premium dashboard cards"] },
        { label: "Dark Glass", values: ["background: rgba(0,0,0,0.2); backdrop-filter: blur(16px);", "Black translucent tint with blur", "Media players and dropdown overlays"] }
      ]}
    />

    <ExampleCard
      title="Popular Glassmorphism Presets"
      description="Frequently used design coordinates:"
      examples={[
        { label: "Standard Frosted", input: "background: rgba(255, 255, 255, 0.1); backdrop-filter: blur(12px);", output: "Copied!", badge: "CSS" },
        { label: "Dark Ambience", input: "background: rgba(0, 0, 0, 0.2); backdrop-filter: blur(16px);", output: "Copied!", badge: "CSS" },
        { label: "Active Glow", input: "background: rgba(52, 211, 153, 0.1); backdrop-filter: blur(8px);", output: "Copied!", badge: "CSS" }
      ]}
    />

    <LanguageSupport
      languages={languageCodes}
      title="Programmatic Glassmorphism Integration"
      description="Apply these styles in your markup code:"
    />

    <CommonMistakes
      mistakes={mistakesList}
      title="Common Glassmorphic Pitfalls"
    />

    <BestPractices
      title="Glassmorphism Best Practices"
      practices={[
        { title: "Define a Theme Property", description: "Save repeating custom glassmorphism styles as theme variables in your config to maintain stylesheet consistency." },
        { title: "Optimize Focus States", description: "Ensure interactive focus states stand out clearly against semi-transparent backgrounds." }
      ]}
    />

    <OfficialReferences
      references={references}
    />

    <RelatedTools
      currentToolUrl="/tools/glassmorphism-generator"
      category="css"
    />
  </div>
</ToolPageLayout>
