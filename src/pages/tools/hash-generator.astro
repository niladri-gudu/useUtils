---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
import { HashGenerator } from '../../components/HashGenerator';
import ComparisonTable from '../../components/content/ComparisonTable.astro';
import BestPractices from '../../components/content/BestPractices.astro';
import CommonMistakes from '../../components/content/CommonMistakes.astro';
import OfficialReferences from '../../components/content/OfficialReferences.astro';
import LanguageSupport from '../../components/content/LanguageSupport.astro';
import ExampleCard from '../../components/content/ExampleCard.astro';
import PrivacyBadge from '../../components/content/PrivacyBadge.astro';

const tabs = [
  { label: 'Hash Generator', href: '/tools/hash-generator', active: true },
  { label: 'MD5 Hash', href: '/tools/md5-generator' },
  { label: 'SHA256 Hash', href: '/tools/sha256-generator' },
  { label: 'SHA512 Hash', href: '/tools/sha512-generator' }
];

const faqs = [
  {
    question: "What is a cryptographic hash function?",
    answer: "A cryptographic hash function is a mathematical algorithm that maps an arbitrary size of data (input) to a fixed-size bit string (output), typically represented as a hexadecimal string. A cryptographically secure hash is a one-way function—computationally impossible to reverse—and deterministic, meaning it will always return the exact same output for a given input."
  },
  {
    question: "What is the difference between hashing and encryption?",
    answer: "Hashing is a one-way function. Its primary purpose is to verify data integrity and authenticity; once data is hashed, it cannot be decrypted or converted back to its original plain text. Encryption is a two-way function designed to protect data confidentiality. Encrypted data (ciphertext) can be decrypted back into its original form using the correct decryption key."
  },
  {
    question: "How does HMAC differ from a regular cryptographic hash?",
    answer: "A standard cryptographic hash (like SHA-256) only verifies data integrity—checking if the data was altered. An HMAC (Hash-based Message Authentication Code) combines the hashing algorithm with a secret cryptographic key. It verifies both <strong>data integrity</strong> and <strong>authenticity</strong>, proving that the sender who created the hash possesses the secret key."
  },
  {
    question: "Is MD5 secure for password hashing?",
    answer: "No, MD5 is cryptographically broken and should never be used for password storage or security-sensitive applications. It is highly susceptible to collision attacks (where two different inputs yield the identical hash) and is computationally too fast, making it vulnerable to brute-force dictionary attacks. For passwords, use modern key-stretching functions like Argon2, bcrypt, or PBKDF2."
  },
  {
    question: "Why is SHA-256 widely used, and is it secure?",
    answer: "SHA-256 (part of the SHA-2 family) is a 256-bit cryptographic hash function designed by the NSA. It is currently the industry standard for digital certificates, SSL/TLS connections, secure APIs, and blockchain transactions (such as Bitcoin). There are no known practical collision attacks against SHA-256, and it remains cryptographically secure."
  },
  {
    question: "Can a cryptographic hash be decrypted or reversed?",
    answer: "No, hashes cannot be decrypted. Hashing maps infinite possible input datasets to a finite set of outputs (e.g., 2^256 states for SHA-256), meaning data is discarded mathematically. However, poorly chosen strings or passwords can be cracked using precomputed lookup tables (known as rainbow tables) or dictionary brute-force attacks."
  },
  {
    question: "What is a hash collision, and why is it dangerous?",
    answer: "A hash collision occurs when two completely different inputs produce the exact same hash output. In security contexts, collisions are highly dangerous because they allow attackers to substitute benign files, configurations, or certificates with malicious versions that share the same hash, tricking verifiers into accepting them."
  },
  {
    question: "How do I verify a downloaded file using a checksum?",
    answer: "To verify a file, calculate its hash locally (using our File Checksum tab or CLI tools like <code>sha256sum file.zip</code> in Linux or <code>certutil -hashfile file.zip SHA256</code> in Windows). Compare your calculated checksum against the official hash provided on the software download page. If they match, your file is authentic and hasn't been corrupted or altered."
  },
  {
    question: "Does this online Hash Generator store my keys or file contents?",
    answer: "No, 100% local. Like all tools on useUtils, this generator operates completely inside your web browser sandbox using JavaScript and the native Web Crypto API. Your text inputs, HMAC secret keys, and uploaded files are processed in local memory and are never transmitted to any external server."
  },
  {
    question: "What is a salt in hashing, and why is it used?",
    answer: "A salt is a random sequence of bytes added to an input (typically a password) before hashing. Salting ensures that identical inputs produce unique, different hashes. This prevents attackers from matching hashes across users and negates the effectiveness of precomputed rainbow table databases."
  },
  {
    question: "How do I compute an HMAC SHA-256 signature in JavaScript (Node.js)?",
    answer: "In Node.js, you can compute HMAC signatures using the native <code>crypto</code> module: <br /><code class=\"font-mono text-[10px] bg-zinc-950 border border-zinc-900 text-zinc-300 rounded px-2 py-1 block mt-2 overflow-x-auto whitespace-pre\">const crypto = require('crypto');\nconst hmac = crypto.createHmac('sha256', 'my-secret-key');\nhmac.update('my-message');\nconst signature = hmac.digest('hex');\nconsole.log(signature);</code>"
  },
  {
    question: "What is the avalanche effect in cryptography?",
    answer: "The avalanche effect describes how a minor change in input (like modifying a single bit or changing a character from lower to upper case) produces a major, completely unrelated change in the output hash, making the new hash look completely different from the old one."
  },
  {
    question: "What is the SHA-3 hashing algorithm?",
    answer: "SHA-3 (Secure Hash Algorithm 3) is the latest member of the Secure Hash Algorithm family. It uses the Keccak permutation-based sponge construction instead of the SHA-2 block algorithm structure, providing protection against length extension attacks."
  },
  {
    question: "What is a length extension attack?",
    answer: "A length extension attack is an exploit where an attacker can use the hash of a message <code>h(secret || message)</code> and the message length to calculate the hash of <code>h(secret || message || padding || extra_message)</code> without knowing the secret, highlighting vulnerabilities in older SHA-1 and SHA-256 structures (which can be avoided using HMAC)."
  },
  {
    question: "What is the difference between SHA-256 and SHA-512?",
    answer: "SHA-256 generates a 256-bit hash, while SHA-512 generates a 512-bit hash. Additionally, SHA-512 operates on 64-bit word blocks, making it faster to process on 64-bit systems than SHA-256."
  },
  {
    question: "Is there a command line hash tool in Windows?",
    answer: "Yes, you can run certutil: <br/><code>certutil -hashfile filename SHA256</code>."
  },
  {
    question: "How do I create bulk hashes from lists?",
    answer: "Toggle to the 'Bulk lines' tab in our tool, paste your entries line-by-line, and retrieve the hashes for all of them instantly. You can export results to a CSV file."
  },
  {
    question: "Can I choose different output formats for the hash?",
    answer: "Yes, the tool supports lowercase hexadecimal, uppercase hexadecimal, Base64, Base64URL, and decimal byte arrays."
  },
  {
    question: "What is the hash size of SHA-384?",
    answer: "SHA-384 produces a 384-bit (48-byte) hash string, represented as a 96-character hexadecimal string."
  },
  {
    question: "Does renaming a file change its checksum?",
    answer: "No. Checksums are calculated strictly from the binary file contents. Changing the name has no effect on the file's hash."
  }
];

const references = [
  { title: "NIST Cryptographic Hashing Policy Guide", url: "https://csrc.nist.gov/projects/hash-functions", source: "NIST Specifications" },
  { title: "RFC 2104 - HMAC: Keyed-Hashing for Message Authentication", url: "https://datatracker.ietf.org/doc/html/rfc2104", source: "IETF Standards" }
];

const languageCodes = [
  {
    lang: "Node.js (HMAC SHA-256)",
    code: `const crypto = require('crypto');

const secret = 'my-secret-key-phrase';
const message = 'The quick brown fox jumps over the lazy dog';

// Generate HMAC signature using SHA-256
const signature = crypto.createHmac('sha256', secret)
                        .update(message)
                        .digest('hex');

console.log(signature);`,
    note: "Uses Node's built-in crypto module."
  },
  {
    lang: "Python (HMAC SHA-256)",
    code: `import hmac
import hashlib

key = b'my-secret-key-phrase'
msg = b'The quick brown fox jumps over the lazy dog'

# Generate HMAC signature
sig = hmac.new(key, msg, hashlib.sha256).hexdigest()
print(sig)`,
    note: "Requires passing inputs as byte strings (with b prefix) in Python 3."
  }
];

const mistakesList = [
  {
    title: "Using Simple Hashing for Password Storage",
    description: "Using standard hash algorithms (like MD5 or SHA-256) to store passwords makes them vulnerable to lookup attacks (rainbow tables) or GPU brute-forcing.",
    fix: "Use key-stretching libraries like bcrypt or Argon2 to slow down hashing operations."
  },
  {
    title: "Mismatched Keys in HMAC Verification",
    description: "Providing incorrect secret key formatting (such as UTF-8 characters vs raw hexadecimal bytes) will yield different signature values, causing verification failures.",
    fix: "Validate key encodings across both signer and verifier systems."
  }
];
---

<ToolPageLayout
  title="Hash & HMAC Generator Online: Secure SHA-256, MD5, SHA-512 Checksums"
  description="Generate secure MD5, SHA-1, SHA-256, SHA-384, SHA-512, and HMAC hashes locally in your browser. Validate download checksums, compare files, or batch compute strings safely."
  keywords="hash generator, hmac generator, sha256 online, md5 hash generator, file checksum checker, sha512 hash, local hash generator, verify checksum"
  toolTitle="Hash & HMAC Generator"
  toolDescription="Compute secure cryptographic hashes or HMAC signatures locally in your web browser. Drag-and-drop file inputs to verify SHA-256/MD5 download checksums, perform batch string hashing, or compare checksums side-by-side."
  tabs={tabs}
  faqs={faqs}
>
  <HashGenerator client:load />

  <div slot="seo-content" class="flex flex-col gap-8 font-sans text-sm text-zinc-400">
    <!-- Section: Intro -->
    <div>
      <h2 class="text-xl font-semibold text-zinc-50 tracking-tight mb-4 flex items-center gap-2">
        <span class="w-1.5 h-6 bg-accent-emerald rounded-full"></span>
        Cryptographic Hashing & Message Authentication
      </h2>
      <p class="leading-relaxed mb-4">
        Cryptographic verification is essential for secure network operations. A **cryptographic hash function** maps files or messages to a fixed-size signature. It is a one-way operation: it is mathematically impossible to reverse the hash back into the original input.
      </p>
      <p class="leading-relaxed">
        Our **Hash & HMAC Generator** provides a secure local workspace. Drop installer packages to verify download checksums, paste query logs to batch compute hashes, or sign webhook payloads using HMAC cryptographic algorithms completely offline.
      </p>
    </div>

    <!-- Section: Privacy Badge -->
    <PrivacyBadge />

    <!-- Section: Comparison Table -->
    <ComparisonTable
      title="Hash Algorithms Properties"
      headers={["Algorithm", "Output Size", "Processing Speed", "Security Level", "Common Usage"]}
      rows={[
        { label: "MD5", values: ["128 bits", "Very Fast", "Broken", "Duplicate database index markers, legacy file checks"] },
        { label: "SHA-1", values: ["160 bits", "Fast", "Weak", "Legacy Git index tracking, older SSH handshakes"] },
        { label: "SHA-256", values: ["256 bits", "Medium", "Secure", "SSL certificates, blockchain, HTTPS integrity"] },
        { label: "SHA-512", values: ["512 bits", "Medium-Fast", "Secure", "Server credentials storage, Unix password databases"] }
      ]}
    />

    <!-- Section: Example Card -->
    <ExampleCard
      title="Avalanche Effect Demo"
      description="Inspect how tiny changes yield completely different hashes:"
      examples={[
        { label: "Hash of 'hello'", input: "hello", output: "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824", badge: "SHA-256" },
        { label: "Hash of 'hello!' (Added symbol)", input: "hello!", output: "334d016f755cd6dc58c53a86e183882f8ec14f52fb05345887c8a5edd42c87b7", badge: "Avalanche Effect" }
      ]}
    />

    <!-- Programming Implementation Guides -->
    <LanguageSupport
      languages={languageCodes}
      title="Programmatic HMAC Hashing"
      description="Generate HMAC signatures in your backend logic using these templates:"
    />

    <!-- Common Mistakes -->
    <CommonMistakes
      mistakes={mistakesList}
      title="Common Cryptographic Hashing Pitfalls"
      description="Avoid these common errors when integrating hashing algorithms in your code:"
    />

    <!-- Best Practices -->
    <BestPractices
      title="Cryptographic Hashing Best Practices"
      practices={[
        { title: "Salt All String Inputs", description: "Always append a random unique salt to inputs before hashing to block rainbow table lookups." },
        { title: "Use Local Web Cryptography", description: "Compute checksums locally in your browser memory to keep files and data private." }
      ]}
    />

    <!-- Official References -->
    <OfficialReferences
      references={references}
    />
  </div>
</ToolPageLayout>
