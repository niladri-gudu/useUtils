---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
import { ColorConverter } from '../../components/ColorConverter';
import BestPractices from '../../components/content/BestPractices.astro';
import CommonMistakes from '../../components/content/CommonMistakes.astro';
import OfficialReferences from '../../components/content/OfficialReferences.astro';
import LanguageSupport from '../../components/content/LanguageSupport.astro';
import ComparisonTable from '../../components/content/ComparisonTable.astro';
import ExampleCard from '../../components/content/ExampleCard.astro';
import PrivacyBadge from '../../components/content/PrivacyBadge.astro';
import RelatedTools from '../../components/content/RelatedTools.astro';

const faqs = [
  {
    question: "What is HEX to HSL conversion?",
    answer: "HEX to HSL conversion translates hexadecimal color values (base-16) into Hue (0-360 degrees), Saturation (0-100%), and Lightness (0-100%) coordinates."
  },
  {
    question: "How do I calculate HSL values from HEX?",
    answer: "Convert the HEX code to RGB first. Divide the RGB values by 255 to normalize them to a 0–1 range. Find the maximum (max) and minimum (min) values of these channels. Lightness is calculated as `(max + min) / 2`. Saturation is calculated depending on lightness, and Hue is determined by which color channel is dominant (Red, Green, or Blue)."
  },
  {
    question: "Why use HSL instead of HEX in modern CSS?",
    answer: "HSL is highly intuitive. You can easily adjust saturation or lightness (e.g., for creating hover states or borders) by changing a single number (S or L), whereas in HEX you would need to mathematically recalculate all six characters."
  },
  {
    question: "What does Hue represent in HSL?",
    answer: "Hue represents the color type on a 360-degree color wheel. 0 is red, 120 is green, 240 is blue, and 360 wraps back to red."
  },
  {
    question: "What does Saturation represent in HSL?",
    answer: "Saturation represents color intensity (0% is completely gray, and 100% is the fully saturated, vibrant color)."
  },
  {
    question: "What does Lightness represent in HSL?",
    answer: "Lightness represents the brightness level of a color (0% is pure black, 50% is the pure color, and 100% is pure white)."
  },
  {
    question: "How does transparency translate from HEX to HSL?",
    answer: "An 8-character HEXA code contains an alpha hex pair. Converting this pair to decimal and dividing by 255 gives the alpha value (between 0.0 and 1.0) which is mapped to the HSLA alpha channel."
  },
  {
    question: "Can I convert color codes with a leading hash omitted?",
    answer: "Yes, our converter automatically cleans up strings with or without the leading '#' marker."
  },
  {
    question: "What is the HSL equivalent for #000000?",
    answer: "hsl(0, 0%, 0%), which represents pure black."
  },
  {
    question: "What is the HSL equivalent for #ffffff?",
    answer: "hsl(0, 0%, 100%), which represents pure white."
  },
  {
    question: "Are HSL colors supported in all web browsers?",
    answer: "Yes. All modern browsers fully support HSL and HSLA color formats in CSS styles."
  },
  {
    question: "How do CSS Color Variables interact with HSL?",
    answer: "HSL works great with CSS variables: `--color-hue: 158;` allows you to declare dynamic color variations: `hsl(var(--color-hue), 64%, 52%)`."
  },
  {
    question: "Is there a performance difference between HSL and HEX in stylesheets?",
    answer: "No. The browser compiles all stylesheet color formats into binary color maps upon loading, resulting in identical rendering speeds."
  },
  {
    question: "How do you calculate Hue mathematically?",
    answer: "If max channel equals R, Hue = `(G - B) / delta % 6`. If max equals G, Hue = `(B - R) / delta + 2`. If max equals B, Hue = `(R - G) / delta + 4`. Multiply the final quotient by 60 to convert it into degrees."
  },
  {
    question: "What is WCAG color compliance?",
    answer: "The WCAG compliance standards ensure web content has adequate contrast against background colors to remain readable for visually impaired users."
  },
  {
    question: "Does this page support WCAG checking?",
    answer: "Yes. The built-in accessibility panel evaluates contrast ratios against white and black backgrounds in real-time."
  },
  {
    question: "What are complementary colors in HSL?",
    answer: "Complementary colors are opposite each other on the color wheel. You can find a color's complement by adding or subtracting 180 degrees from its Hue."
  },
  {
    question: "What are analogous colors in HSL?",
    answer: "Analogous colors sit next to each other on the color wheel. You can find them by shifting the Hue +/- 30 degrees."
  },
  {
    question: "Does this converter execute color conversions on a server?",
    answer: "No. All conversion computations run client-side in your web browser, ensuring complete privacy."
  },
  {
    question: "Why does my design look different in print?",
    answer: "Screens use the additive RGB/HSL color model (light emission), while print media uses the subtractive CMYK color model (ink absorption), which has a smaller color range (gamut)."
  }
];

const languageCodes = [
  {
    lang: "TypeScript",
    code: `
function hexToHsl(hex: string): { h: number; s: number; l: number; a: number } | null {
  // 1. Convert HEX to RGB
  let cleaned = hex.replace(/^#/, '');
  if (cleaned.length === 3 || cleaned.length === 4) {
    cleaned = cleaned.split('').map(c => c + c).join('');
  }
  if (cleaned.length !== 6 && cleaned.length !== 8) return null;
  
  const r = parseInt(cleaned.slice(0, 2), 16) / 255;
  const g = parseInt(cleaned.slice(2, 4), 16) / 255;
  const b = parseInt(cleaned.slice(4, 6), 16) / 255;
  const alpha = cleaned.length === 8 ? parseFloat((parseInt(cleaned.slice(6, 8), 16) / 255).toFixed(3)) : 1.0;
  
  // 2. Convert RGB to HSL
  const max = Math.max(r, g, b);
  const min = Math.min(r, g, b);
  const d = max - min;
  let h = 0, s = 0, l = (max + min) / 2;
  
  if (d !== 0) {
    s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
    switch (max) {
      case r: h = (g - b) / d + (g < b ? 6 : 0); break;
      case g: h = (b - r) / d + 2; break;
      case b: h = (r - g) / d + 4; break;
    }
    h = Math.round(h * 60);
  }
  
  return { h, s: Math.round(s * 100), l: Math.round(l * 100), a: alpha };
}
    `,
    note: "Performs two-step HEX → RGB → HSL conversion with rounding."
  },
  {
    lang: "Python",
    code: `
def hex_to_hsl(hex_str):
    cleaned = hex_str.lstrip('#')
    if len(cleaned) in (3, 4):
        cleaned = ''.join(c*2 for c in cleaned)
    
    r = int(cleaned[0:2], 16) / 255.0
    g = int(cleaned[2:4], 16) / 255.0
    b = int(cleaned[4:6], 16) / 255.0
    a = int(cleaned[6:8], 16) / 255.0 if len(cleaned) == 8 else 1.0
    
    mx, mn = max(r, g, b), min(r, g, b)
    diff = mx - mn
    l = (mx + mn) / 2.0
    h = s = 0.0
    
    if diff != 0:
        s = diff / (2.0 - mx - mn) if l > 0.5 else diff / (mx + mn)
        if mx == r:
            h = (g - b) / diff + (6.0 if g < b else 0.0)
        elif mx == g:
            h = (b - r) / diff + 2.0
        elif mx == b:
            h = (r - g) / diff + 4.0
        h = round(h * 60)
        
    return h, round(s * 100), round(l * 100), round(a, 3)
    `,
    note: "Standard mathematical implementation returning rounded percentages."
  }
];

const mistakesList = [
  {
    title: "Direct Conversion Attempts",
    description: "Attempting to convert HEX straight to HSL without mapping to RGB first. A multi-step process is required."
  },
  {
    title: "Incorrect HSL Units",
    description: "Omitting percent markers (%) in HSL styling declarations. Saturation and Lightness always require percentage symbols."
  },
  {
    title: "Confusing Black and White Hues",
    description: "Forgetting that Hue has no visible effect when Saturation is 0% or Lightness is 0% or 100%."
  }
];

const references = [
  {
    title: "W3C CSS Color Module Standard",
    url: "https://www.w3.org/TR/css-color-4/"
  },
  {
    title: "MDN Web Docs: HSL color type",
    url: "https://developer.mozilla.org/en-US/docs/Web/CSS/color_value/hsl"
  }
];
---

<ToolPageLayout
  title="HEX to HSL Color Converter | Real-time Color Code Translation"
  description="Convert hexadecimal color codes to Hue, Saturation, and Lightness coordinates instantly. Features interactive HSL and RGB color sliders and WCAG contrast check."
  keywords="hex to hsl, hexa to hsla, color converter, hex color, hsl color, web design colors, hsl conversion"
  toolTitle="HEX to HSL Converter"
  toolDescription="Convert hexadecimal color codes to HSL (Hue, Saturation, Lightness) space. Real-time updates, smart string detection, and accessibility contrast analyzer."
  faqs={faqs}
>
  <ColorConverter defaultColor="#34D399" defaultInputMode="hex" client:load />

  <div slot="seo-content" class="flex flex-col gap-8 font-sans text-sm text-zinc-400">
    <PrivacyBadge />

    <div>
      <h2 class="text-xl font-semibold text-zinc-50 tracking-tight mb-4 flex items-center gap-2">
        <span class="w-1.5 h-6 bg-accent-emerald rounded-full"></span>
        Translating HEX to HSL Formats
      </h2>
      <p class="leading-relaxed mb-3">
        HEX codes are standard for specifying color coordinates in digital stylesheets. However, HSL is highly preferred by developers for UI component styling because of its intuitive structure.
      </p>
      <p class="leading-relaxed">
        Our conversion utility takes hexadecimal strings, parses them to decimal RGB channels, and converts them to HSL coordinates. Adjust any slider to see the values sync across all fields in real-time.
      </p>
    </div>

    <ComparisonTable
      title="HEX vs HSL Color Representation"
      description="Compare representation syntax:"
      headers={["Format Spec", "Color Representation", "Opacity Integration", "Design Applicability"]}
      rows={[
        { label: "HEX Color", values: ["#34D399", "#34D39980 (Hex Alpha)", "High (Standard web variables)"] },
        { label: "HSL Color", values: ["hsl(158, 64%, 52%)", "hsla(158, 64%, 52%, 0.5)", "Very High (Intuitive hover adjustments)"] }
      ]}
    />

    <ExampleCard
      title="Common HEX to HSL Mappings"
      description="Observe standard color translations:"
      examples={[
        { label: "Emerald (Accent)", input: "#34D399", output: "hsl(158, 64%, 52%)", badge: "HEX" },
        { label: "Crimson Red", input: "#DC2626", output: "hsl(0, 72%, 50%)", badge: "HEX" },
        { label: "Sky Blue", input: "#0EA5E9", output: "hsl(199, 89%, 48%)", badge: "HEX" }
      ]}
    />

    <LanguageSupport
      languages={languageCodes}
      title="HEX to HSL Programmatic Snips"
      description="Parse HEX values into HSL using these templates:"
    />

    <CommonMistakes
      mistakes={mistakesList}
      title="Common Color Conversion Pitfalls"
    />

    <BestPractices
      title="HEX to HSL Best Practices"
      practices={[
        { title: "Use HSL for Color Themes", description: "Use HSL variables to quickly generate lighter and darker variations of a theme's base color." },
        { title: "Define Sensible Hue Steps", description: "When creating color scales manually, adjust Lightness in steps of 5% to 10% to keep transitions smooth." }
      ]}
    />

    <OfficialReferences
      references={references}
    />

    <RelatedTools
      currentToolUrl="/tools/hex-to-hsl"
      category="css"
    />
  </div>
</ToolPageLayout>
