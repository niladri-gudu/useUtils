---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
import { JsonToTsConverter } from '../../components/JsonToTsConverter';
import ComparisonTable from '../../components/content/ComparisonTable.astro';
import BestPractices from '../../components/content/BestPractices.astro';
import CommonMistakes from '../../components/content/CommonMistakes.astro';
import OfficialReferences from '../../components/content/OfficialReferences.astro';
import LanguageSupport from '../../components/content/LanguageSupport.astro';
import ExampleCard from '../../components/content/ExampleCard.astro';

const tabs = [
  { label: 'JSON to TypeScript', href: '/tools/json-to-typescript', active: true },
  { label: 'JSON to Zod Schema', href: '/tools/json-to-zod' }
];

const faqs = [
  {
    question: "What is JSON to TypeScript conversion and why is it useful?",
    answer: "JSON to TypeScript conversion involves parsing a sample JSON payload and automatically generating matching TypeScript interface or type declarations. This is highly useful for developers who consume APIs; it eliminates manual type definitions, prevents spelling mistakes, and provides compile-time type safety and IDE autocomplete."
  },
  {
    question: "How does this converter handle nested objects inside JSON?",
    answer: "Our converter recursively traverses the entire JSON tree. When it encounters nested objects, it extracts them and creates separate, modular TypeScript interfaces or Zod schemas rather than using messy inline object types. It names these extracted interfaces based on the object keys."
  },
  {
    question: "Can this tool generate Zod schemas for runtime validation?",
    answer: "Yes. In addition to TypeScript interfaces and type aliases, you can toggle the output format to <strong>Zod Schema</strong>. This generates full Zod validator code (e.g. <code>z.object</code>, <code>z.array</code>, etc.) that matches your JSON's shape, allowing you to validate untrusted API data at your application boundaries."
  },
  {
    question: "How does the tool infer array item types from mixed arrays?",
    answer: "If an array contains objects with varying fields, the converter performs a structural merge. It gathers the union of all keys across all array elements. If a key is missing in some elements, it is marked as optional (<code>?</code>). If keys have differing data types (e.g. string in one, number in another), it merges them into a TypeScript union (e.g. <code>string | number</code>)."
  },
  {
    question: "Does the converter support ISO-8601 date strings?",
    answer: "Yes, when <strong>Detect ISO-8601 DateTime strings</strong> is enabled, the parser tests string values against standard ISO timestamps. If matched, it converts the field to a native <code>Date</code> type in TypeScript, or a <code>z.coerce.date()</code> schema in Zod, rather than treating it as a generic string."
  },
  {
    question: "Are properties generated with readonly modifiers?",
    answer: "Yes. By enabling the <strong>Readonly modifier</strong> option, all generated properties are prefixed with the <code>readonly</code> keyword. This enforces immutability, ensuring that properties on objects parsed from API responses cannot be reassigned elsewhere in your code."
  },
  {
    question: "Is my JSON payload sent to any server during conversion?",
    answer: "No. Like all tools on useUtils, the JSON to TypeScript & Zod Schema Converter runs 100% locally in your web browser. No JSON data, variable names, or parsed types are transmitted to external servers. Your credentials, API structures, and payloads remain entirely private."
  },
  {
    question: "What is the difference between generating a TypeScript Interface vs a Type Alias?",
    answer: "TypeScript <strong>Interfaces</strong> define a contract for object shapes and support declaration merging (you can extend them using <code>extends</code>). <strong>Type Aliases</strong> are more versatile as they can describe object shapes, primitives, arrays, union types, or intersections, but they cannot be reopened to add new properties after declaration."
  },
  {
    question: "How do I customize the name of the root interface or schema?",
    answer: "You can enter your custom identifier in the <strong>Root Object Name</strong> input field (defaults to <code>RootObject</code>). The converter sanitizes your input to ensure it is a valid JavaScript variable name and uses it for the top-level interface or Zod schema definition."
  },
  {
    question: "Can I format or minify my input JSON within this tool?",
    answer: "Yes, the tool features built-in utility buttons: <strong>Prettify</strong> formats your input JSON with clean 2-space indentation and checks for errors, while <strong>Minify</strong> strips out all whitespace and carriage returns to make the JSON payload as compact as possible."
  },
  {
    question: "How does the tool handle null values or empty arrays in JSON?",
    answer: "If a JSON value is <code>null</code>, the tool types it as <code>null</code> (or <code>z.null()</code> in Zod). For empty arrays where no types can be inferred, it defaults the elements to <code>any</code> (or <code>z.any()</code> in Zod) as a safe fallback."
  },
  {
    question: "How do I validate API responses with a Zod schema?",
    answer: "Import Zod and use the <code>parse()</code> method on your schema: <br/><code>MySchema.parse(apiResponse)</code>. This will throw an error if the payload structure is incorrect."
  },
  {
    question: "What is z.infer in Zod?",
    answer: "<code>z.infer</code> is a Zod utility that automatically extracts the compile-time TypeScript type from a runtime Zod schema, preventing you from having to write both."
  },
  {
    question: "How to compile TypeScript types programmatically in Node?",
    answer: "You can use packages like <code>json-schema-to-typescript</code> or write standard compilers using AST nodes."
  },
  {
    question: "Does the generator support export statements?",
    answer: "Yes, by default it prepends the <code>export</code> keyword to all generated types and interfaces so they can be modularly imported."
  },
  {
    question: "Can I force all properties to be optional?",
    answer: "Yes, checking 'Force all properties to be optional' appends a <code>?</code> modifier to all TypeScript keys and <code>.optional()</code> to all Zod definitions."
  },
  {
    question: "Does the tool support nested arrays of objects?",
    answer: "Yes. The compiler recursively builds type schemas for nested lists, ensuring all deep levels are mapped accurately."
  },
  {
    question: "Why should I choose Zod over build-time types?",
    answer: "TypeScript interfaces do not run in production JS. If an API contract changes, interfaces won't detect it, whereas Zod will reject the payload at runtime."
  },
  {
    question: "Is there a size limit to JSON compilation?",
    answer: "No. The local compiler runs instantly and can process files up to 10MB in a fraction of a second."
  },
  {
    question: "Does the tool support snake_case mappings?",
    answer: "Yes, it parses keys exactly as they appear in the JSON. If keys are snake_case, the output properties will match."
  }
];

const references = [
  { title: "TypeScript Interface Documentation guidelines", url: "https://www.typescriptlang.org/docs/handbook/2/everyday-types.html#interfaces", source: "Official TS Handbook" },
  { title: "Zod Schema Declaration & Validation Portal", url: "https://zod.dev/", source: "Zod Official Portal" }
];

const languageCodes = [
  {
    lang: "TypeScript (Interfaces)",
    code: `export interface User {
  id: number;
  name: string;
  roles: string[];
}

const user: User = {
  id: 101,
  name: "Alex",
  roles: ["admin"]
};`,
    note: "Static interfaces provide IDE autocompletion and compiler checks."
  },
  {
    lang: "TypeScript (Zod)",
    code: `import { z } from "zod";

export const UserSchema = z.object({
  id: z.number(),
  name: z.string(),
  roles: z.array(z.string())
});

type User = z.infer<typeof UserSchema>;`,
    note: "Runtime validation with auto-inferred static types."
  }
];

const mistakesList = [
  {
    title: "Accepting Raw API Responses without Validation",
    description: "Casting dynamic network responses directly as TS interfaces (e.g. <code>fetch().then(r => r as User)</code>) bypasses runtime checks.",
    fix: "Use a validator library like Zod to parse and verify incoming HTTP responses before usage."
  },
  {
    title: "Using 'any' as a Fallback for Empty Arrays",
    description: "Allowing empty arrays to default to <code>any[]</code> loses type safety on downstream array methods.",
    fix: "Explicitly declare the type parameter of empty list items once the data schema is established."
  }
];
---

<ToolPageLayout
  title="JSON to TypeScript & Zod Schema Converter Online - useUtils"
  description="Convert JSON payloads to TypeScript interfaces, type aliases, or Zod schemas in real-time. Features recursive parsing, ISO date inference, field merging, and local validation."
  keywords="json to typescript, json to zod, typescript generator, convert json to ts, zod schema from json, typescript interface generator, json to types"
  toolTitle="JSON to TypeScript & Zod Schema Converter"
  toolDescription="Convert JSON payloads into robust, type-safe TypeScript Interfaces, Type aliases, or Zod Validation schemas instantly. Recursively merges array structures, infers ISO timestamps, and validates code 100% locally."
  tabs={tabs}
  faqs={faqs}
>
  <JsonToTsConverter client:load />

  <div slot="seo-content" class="flex flex-col gap-8 font-sans text-sm text-zinc-400">
    <!-- Section: Intro -->
    <div>
      <h2 class="text-xl font-semibold text-zinc-50 tracking-tight mb-4 flex items-center gap-2">
        <span class="w-1.5 h-6 bg-accent-emerald rounded-full"></span>
        How to Use the JSON to TypeScript & Zod Converter
      </h2>
      <p class="leading-relaxed mb-4">
        Generating typescript interfaces from JSON has never been faster. Simply paste your raw JSON string into the input editor pane on the left, customize your settings, and copy the type-safe definitions from the right pane.
      </p>
      <ul class="list-disc list-inside space-y-2 pl-2">
        <li>Paste your JSON payload into the input editor or load our pre-made <strong class="text-zinc-200">Sample</strong>.</li>
        <li>Format your input on the fly with the <strong class="text-zinc-200">Prettify</strong> or <strong class="text-zinc-200">Minify</strong> options.</li>
        <li>Choose your output target format: <strong class="text-zinc-200">TS Interfaces</strong>, <strong class="text-zinc-200">TS Types</strong>, or <strong class="text-zinc-200">Zod Schema</strong>.</li>
        <li>Configure output parameters: name the root object, toggle export keywords, detect date strings, make keys optional or readonly.</li>
        <li>Click <strong class="text-zinc-200">Copy Output</strong> to clipboard or <strong class="text-zinc-200">Download (.ts)</strong> to save it directly into your codebase.</li>
      </ul>
    </div>

    <!-- Section: Core Differences -->
    <div>
      <h2 class="text-xl font-semibold text-zinc-50 tracking-tight mb-4 flex items-center gap-2">
        <span class="w-1.5 h-6 bg-accent-emerald rounded-full"></span>
        Interfaces, Types, and Zod: Which should you choose?
      </h2>
      <p class="leading-relaxed mb-4">
        Our tool handles three distinct formatting paradigms depending on your project architecture:
      </p>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-2">
        <div class="p-4 bg-zinc-900/40 border border-border-hairline rounded-lg">
          <strong class="text-zinc-200 block mb-1">TypeScript Interfaces</strong>
          <p class="text-xs leading-relaxed text-zinc-400">
            Standard contracts for objects in TS. Ideal for defining public APIs and model layers. They support compilation optimization and allow extension.
          </p>
        </div>
        <div class="p-4 bg-zinc-900/40 border border-border-hairline rounded-lg">
          <strong class="text-zinc-200 block mb-1">TypeScript Type Aliases</strong>
          <p class="text-xs leading-relaxed text-zinc-400">
            Best for union types, primitive mappings, or utility types. Helpful if your root JSON represents an array or raw primitive directly.
          </p>
        </div>
        <div class="p-4 bg-zinc-900/40 border border-border-hairline rounded-lg">
          <strong class="text-zinc-200 block mb-1">Zod Schemas</strong>
          <p class="text-xs leading-relaxed text-zinc-400">
            Goes beyond build-time type safety by providing runtime validation. Ensures that incoming network responses match your expected schema.
          </p>
        </div>
      </div>
    </div>

    <!-- Section: Comparison Table -->
    <ComparisonTable
      title="TS Model Specifications"
      headers={["Capability", "TS Interfaces", "TS Type Aliases", "Zod Validation Schema"]}
      rows={[
        { label: "Type Safety Level", values: ["Compile-time only", "Compile-time only", "Compile-time & Runtime validation"] },
        { label: "Extensibility", values: ["Supports extending (extends) and merging", "Cannot be reopened or extended via declarations", "Supports extensions via object .extend() methods"] },
        { label: "Primitives Support", values: ["Only supports objects/classes", "Supports unions, intersections, arrays, primitives", "Supports unions, intersections, primitives, coercion"] }
      ]}
    />

    <!-- Section: Example Card -->
    <ExampleCard
      title="Code Generations"
      description="Compare JSON fields with their matching TS compiler outputs:"
      examples={[
        { label: "Flat Keys Ingestion", input: '{"id": 1, "name": "Jane"}', output: "export interface RootObject {\n  id: number;\n  name: string;\n}", badge: "TS Interface" }
      ]}
    />

    <!-- Programming Implementation Guides -->
    <LanguageSupport
      languages={languageCodes}
      title="Programmatic Validation Architectures"
      description="Validate dynamic client payloads inside your TS build environments:"
    />

    <!-- Common Mistakes -->
    <CommonMistakes
      mistakes={mistakesList}
      title="Common Compilation Pitfalls"
      description="Avoid these common errors when handling API and server model interfaces:"
    />

    <!-- Best Practices -->
    <BestPractices
      title="Type Architecture Best Practices"
      practices={[
        { title: "Incorporate Readonly", description: "Prefix keys with the readonly keyword to enforce immutability on fetched API values." },
        { title: "Avoid the any Type", description: "Avoid letting empty arrays fallback to any[]; declare strict model structures to preserve safety." }
      ]}
    />

    <!-- Official References -->
    <OfficialReferences
      references={references}
    />
  </div>
</ToolPageLayout>
