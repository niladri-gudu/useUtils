---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
import { JwtDecoder } from '../../components/JwtDecoder';
import ComparisonTable from '../../components/content/ComparisonTable.astro';
import BestPractices from '../../components/content/BestPractices.astro';
import CommonMistakes from '../../components/content/CommonMistakes.astro';
import OfficialReferences from '../../components/content/OfficialReferences.astro';
import LanguageSupport from '../../components/content/LanguageSupport.astro';
import ExampleCard from '../../components/content/ExampleCard.astro';
import PrivacyBadge from '../../components/content/PrivacyBadge.astro';

const tabs = [
  { label: 'JWT Decoder', href: '/tools/jwt-decoder', active: true },
  { label: 'JWT Encoder', href: '/tools/jwt-encoder' }
];

const faqs = [
  {
    question: "How do I decode a JWT token?",
    answer: "Because JSON Web Tokens are Base64Url-encoded rather than encrypted, you can decode the Header and Payload to read their contents using a standard Base64 decoder. Simply split the token string at the dot (<code class=\"font-mono text-[10px] bg-zinc-950 border border-zinc-900 text-zinc-300 rounded px-1\">.</code>) characters and decode the second segment (the payload) from Base64Url using the browser's native <code class=\"font-mono text-[10px] bg-zinc-950 border border-zinc-900 text-zinc-300 rounded px-1\">atob</code> API."
  },
  {
    question: "Can I decode a JWT without a secret key?",
    answer: "Yes. Since standard JSON Web Tokens are only Base64Url-encoded and not encrypted, you can decode the Header and Payload to read their contents without needing a secret key or public key. However, you cannot verify the authenticity of the token or its signature without the correct key."
  },
  {
    question: "What is the difference between decoding and verifying a JWT?",
    answer: "Decoding simply translates the token from a Base64Url representation back into plaintext JSON. Verifying checks the signature using the original secret key (or public key) to confirm the token has not been tampered with, and validates registered claims like the expiration time (<code class=\"font-mono text-[10px] bg-zinc-950 border border-zinc-900 text-zinc-300 rounded px-1\">exp</code>)."
  },
  {
    question: "Can I trust a decoded JWT?",
    answer: "No. You should never trust the claims in a JWT until you have successfully verified its signature. Without verification, a user or intermediary could easily modify claims (such as user roles or expiration times) and re-encode the token."
  },
  {
    question: "Why is my decoded JWT showing the year 1970 for expiration?",
    answer: "This occurs due to a mismatch between seconds and milliseconds. In the JWT specification, timestamps like <code class=\"font-mono text-[10px] bg-zinc-950 border border-zinc-900 text-zinc-300 rounded px-1\">exp</code>, <code class=\"font-mono text-[10px] bg-zinc-950 border border-zinc-900 text-zinc-300 rounded px-1\">iat</code>, and <code class=\"font-mono text-[10px] bg-zinc-950 border border-zinc-900 text-zinc-300 rounded px-1\">nbf</code> must be represented in Unix time as **seconds**. If your backend generated the token using millisecond timestamps (e.g., JavaScript's <code class=\"font-mono text-[10px] bg-zinc-950 border border-zinc-900 text-zinc-300 rounded px-1\">Date.now()</code>), verification libraries will divide it incorrectly, showing a date close to the Unix epoch in 1970."
  },
  {
    question: "What are the three parts of a JWT?",
    answer: "A standard JWT consists of three parts separated by dots (<code class=\"font-mono text-[10px] bg-zinc-950 border border-zinc-900 text-zinc-300 rounded px-1\">.</code>): a <strong>Header</strong> (specifying the signing algorithm and token type), a <strong>Payload</strong> (containing the claims or data), and a <strong>Signature</strong> (used to verify that the sender is who they say they are and that the token was not modified)."
  },
  {
    question: "Is a JWT payload encrypted?",
    answer: "No, a standard JWT payload is encoded, not encrypted. It is simple Base64Url encoding, which is easily readable by anyone. Do not store sensitive information like passwords, PINs, or private API keys in the payload unless you encrypt the token using the JWE (JSON Web Encryption) standard."
  },
  {
    question: "What is a 'Claim' in a JWT?",
    answer: "Claims are pieces of information asserted about a subject (usually the user) represented as key-value pairs in the payload. They are divided into <strong>registered claims</strong> (predefined metadata like <code class=\"font-mono text-[10px] bg-zinc-950 border border-zinc-900 text-zinc-300 rounded px-1\">sub</code>, <code class=\"font-mono text-[10px] bg-zinc-950 border border-zinc-900 text-zinc-300 rounded px-1\">iss</code>, <code class=\"font-mono text-[10px] bg-zinc-950 border border-zinc-900 text-zinc-300 rounded px-1\">exp</code>), <strong>public claims</strong>, and <strong>private claims</strong> (custom application-specific properties like user roles)."
  },
  {
    question: "How do I read a JWT payload in JavaScript?",
    answer: "You can read a JWT payload without external libraries by splitting the token string at the dot, replacing URL-safe base64 characters, and parsing using the browser's native Base64 decoding:<br /><code class=\"font-mono text-[10px] bg-zinc-950 border border-zinc-900 text-zinc-300 rounded px-2 py-1 block mt-2 overflow-x-auto whitespace-pre\">const payload = JSON.parse(atob(token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));</code>"
  },
  {
    question: "What is a JWT debugger used for?",
    answer: "A <strong>JWT debugger</strong> (or inspector) is used by developers to inspect the contents of JSON Web Tokens during development. It allows you to verify that expiration times are set correctly, custom scopes and roles are present, and signature verification logic operates as expected without writing temporary testing code."
  },
  {
    question: "How to decode JWT in Python?",
    answer: "Use the PyJWT library: <br/><code>import jwt; decoded = jwt.decode(token, options={'verify_signature': False})</code>."
  },
  {
    question: "How to decode JWT in Node.js?",
    answer: "Use the jsonwebtoken package: <br/><code>const jwt = require('jsonwebtoken'); const decoded = jwt.decode(token);</code>."
  },
  {
    question: "How do I decode a JWT in Go?",
    answer: "Use the golang-jwt library: <br/><code>token, _ := jwt.Parse(tokenStr, nil)</code>."
  },
  {
    question: "How do I decode a JWT in Java?",
    answer: "Use libraries like Auth0's java-jwt: <br/><code>DecodedJWT jwt = JWT.decode(tokenStr);</code>."
  },
  {
    question: "What algorithms are supported by JWT?",
    answer: "JWT supports symmetric HMAC algorithms (HS256, HS384, HS512) and asymmetric public/private key algorithms (RS256, RS384, RS512, ES256, ES384, ES512)."
  },
  {
    question: "What is the difference between JWS and JWE?",
    answer: "JWS (JSON Web Signature) represents signed, plaintext payloads (readable by anyone). JWE (JSON Web Encryption) represents encrypted payloads that can only be read with the correct private decryption key."
  },
  {
    question: "What is the role of the 'kid' claim?",
    answer: "The 'kid' (Key ID) header claim tells the verifying application which public or secret key was used to sign the token, letting systems resolve multiple keys dynamically."
  },
  {
    question: "What is the role of the 'aud' claim?",
    answer: "The 'aud' (Audience) claim identifies the intended recipients of the JWT. The recipient system must check this claim; if it doesn't match its audience identifier, the token must be rejected."
  },
  {
    question: "Is there a command line tool to inspect JWTs?",
    answer: "Yes, you can split and decode using bash tools: <br/><code>echo -n \"token\" | cut -d'.' -f2 | base64 --decode</code>."
  },
  {
    question: "Does this JWT tool save token histories?",
    answer: "No. The parsing is done entirely client-side. The token inputs and verification keys are stored in temporary variables and are wiped when the tab is refreshed."
  }
];

const references = [
  { title: "RFC 7519 - JSON Web Token (JWT) Standard", url: "https://datatracker.ietf.org/doc/html/rfc7519", source: "IETF Standards" },
  { title: "JWT.io Introduction and Standards Guide", url: "https://jwt.io/introduction", source: "Auth0 Resources" }
];

const languageCodes = [
  {
    lang: "Node.js (jsonwebtoken)",
    code: `const jwt = require('jsonwebtoken');

const token = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ...";

// Decode without verifying signature
const decoded = jwt.decode(token);
console.log(decoded);`,
    note: "jsonwebtoken decodes base64 envelopes into JSON structures."
  },
  {
    lang: "Python (PyJWT)",
    code: `import jwt

token = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIiwiaWF0IjoxNTE2MjM5MDIyfQ..."

# Decode claims payload (verify_signature=False is required to skip signing validation)
decoded = jwt.decode(token, options={"verify_signature": False})
print(decoded)`,
    note: "Skipping verification lets you read tokens when secret keys are unavailable."
  }
];

const mistakesList = [
  {
    title: "Storing Sensitive Credentials inside Payload Blocks",
    description: "Believing that JWT payloads are secure is a major security mistake. Since the payload is only base64URL encoded, any interceptor can inspect sensitive permissions or passwords.",
    fix: "Never write secrets (like API keys, passwords, or personal identity indicators) inside JWT payloads."
  },
  {
    title: "Omitting exp (Expiration) Claims",
    description: "Tokens without expiration claims remain valid indefinitely, allowing stolen tokens to be reused by attackers forever.",
    fix: "Always set a short expiration window (e.g., 15 minutes) inside token claims payloads."
  }
];
---

<ToolPageLayout
  title="JWT Decoder Online: Inspect & Debug JSON Web Tokens Safely"
  description="Decode, parse, and verify JSON Web Tokens (JWT) in real-time. Inspect the header, payload, and signature locally with full JSON syntax highlighting. 100% secure."
  keywords="JWT Decoder, jwt decoder, jwt decoder online, online jwt decoder, decode jwt, jwt debugger, inspect jwt, verify jwt, json web token decoder"
  toolTitle="JWT Decoder"
  toolDescription="Decode, inspect, and debug JWT payloads in real-time. Designed with a premium desktop-class dark aesthetic, offering live claims counting, countdowns, and inline date parsing."
  tabs={tabs}
  faqs={faqs}
>
  <JwtDecoder client:load />

  <div slot="seo-content" class="flex flex-col gap-8 font-sans text-sm text-zinc-400">
    <!-- Section: Intro -->
    <div>
      <h2 class="text-xl font-semibold text-zinc-50 tracking-tight mb-4 flex items-center gap-2">
        <span class="w-1.5 h-6 bg-accent-emerald rounded-full"></span>
        JSON Web Token Structure Anatomy
      </h2>
      <p class="leading-relaxed mb-4">
        JSON Web Tokens represent claims signed using standard cryptography. A JWT is formed by joining three Base64URL-encoded strings with dots (<code>.</code>): a **Header** (defines the signing algorithm), a **Payload** (details user metadata and claims), and a **Signature** (verifies origin and prevents tampering).
      </p>
      <p class="leading-relaxed">
        Our **JWT Decoder** splits these strings instantly. The engine handles standard HS256/RS256 algorithms, counts claims, converts expiration timestamps (like <code>exp</code>) into local human-readable times, and computes signature verification locally using browser sandbox memory.
      </p>
    </div>

    <!-- Section: Privacy Badge -->
    <PrivacyBadge />

    <!-- Section: Comparison Table -->
    <ComparisonTable
      title="Common Registered JWT Claims"
      headers={["Claim Key", "Name", "Data Type", "Role Description"]}
      rows={[
        { label: "sub", values: ["Subject", "String", "Unique identifier for the user or entity (e.g. user_12984)"] },
        { label: "iss", values: ["Issuer", "String / URL", "Identifies the authentication server that generated the token"] },
        { label: "exp", values: ["Expiration Time", "Unix Timestamp", "Schedules when the token expires and becomes invalid for routing"] },
        { label: "aud", values: ["Audience", "String / Array", "Identifies the target API services that accept the token"] }
      ]}
    />

    <!-- Section: Example Card -->
    <ExampleCard
      title="Token Layout Breakdown"
      description="Inspect how standard token strings split into separate components:"
      examples={[
        { label: "Token string", input: "eyJhbGci...[header].eyJzdWIi...[payload].signature", output: "Header (JSON) + Payload (JSON) + Signature (Hex/Base64)", badge: "JWT Anatomy" }
      ]}
    />

    <!-- Programming Implementation Guides -->
    <LanguageSupport
      languages={languageCodes}
      title="Programmatic JWT Decoding"
      description="Decode tokens in your application logic using these standard snippets:"
    />

    <!-- Common Mistakes -->
    <CommonMistakes
      mistakes={mistakesList}
      title="Common JWT Implementation Mistakes"
      description="Avoid these common validation errors when coding token routing:"
    />

    <!-- Best Practices -->
    <BestPractices
      title="JSON Web Token Best Practices"
      practices={[
        { title: "Verify Signatures on Servers", description: "Always validate token signatures using secret or public keys before executing any backend actions." },
        { title: "Enforce Expiration Constraints", description: "Keep token expiration limits short to prevent stolen token reuse." }
      ]}
    />

    <!-- Official References -->
    <OfficialReferences
      references={references}
    />
  </div>
</ToolPageLayout>
