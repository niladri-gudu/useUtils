---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
import { JwtEncoder } from '../../components/JwtEncoder';
import ComparisonTable from '../../components/content/ComparisonTable.astro';
import BestPractices from '../../components/content/BestPractices.astro';
import CommonMistakes from '../../components/content/CommonMistakes.astro';
import OfficialReferences from '../../components/content/OfficialReferences.astro';
import LanguageSupport from '../../components/content/LanguageSupport.astro';
import ExampleCard from '../../components/content/ExampleCard.astro';
import PrivacyBadge from '../../components/content/PrivacyBadge.astro';

const tabs = [
  { label: 'JWT Decoder', href: '/tools/jwt-decoder' },
  { label: 'JWT Encoder', href: '/tools/jwt-encoder', active: true }
];

const faqs = [
  {
    question: "How do I generate a JWT token?",
    answer: "To generate a JWT, format your Header and Payload as JSON objects, encode each separately in Base64Url format, and join them with a dot (<code class=\"font-mono text-[10px] bg-zinc-950 border border-zinc-900 text-zinc-300 rounded px-1\">header.payload</code>). Then, sign this combined string using a cryptographic algorithm (e.g., HS256) and a secret or private key, Base64Url-encode the resulting signature, and append it with a dot (<code class=\"font-mono text-[10px] bg-zinc-950 border border-zinc-900 text-zinc-300 rounded px-1\">header.payload.signature</code>)."
  },
  {
    question: "What is a JWT secret key and how do I create it?",
    answer: "A JWT secret key is a private string used in symmetric signing algorithms (like HS256) to sign and verify JSON Web Tokens. It should be a cryptographically secure, high-entropy random string to prevent brute-force attacks. You can generate a strong key using the terminal command: <code class=\"font-mono text-[10px] bg-zinc-950 border border-zinc-900 text-zinc-300 rounded px-1\">openssl rand -base64 32</code>."
  },
  {
    question: "Is it safe to encode a JWT online?",
    answer: "Yes, it is completely safe when using our online JWT encoder. Unlike other tools that transmit payloads and keys to remote servers, our encoder runs entirely inside your browser sandbox using client-side JavaScript. Your secret keys and private claims never leave your device."
  },
  {
    question: "Should I use HMAC (HS256) or RSA (RS256) for signing JWTs?",
    answer: "HS256 is a symmetric algorithm using a shared secret key, meaning both the service generating the token and the service verifying it must share the exact same secret. RS256 is asymmetric, using a private key to sign the token and a public key to verify it. RS256 is preferred for API gateways and distributed microservices because verification systems do not need access to the private signing key."
  },
  {
    question: "How do I set an expiration time when generating a JWT?",
    answer: "To set an expiration time, include the <code class=\"font-mono text-[10px] bg-zinc-950 border border-zinc-900 text-zinc-300 rounded px-1\">exp</code> (expiration) claim in the Payload JSON. The value must be formatted as a Unix timestamp in **seconds** (not milliseconds). For example, to expire a token in 1 hour, set the value to: <code class=\"font-mono text-[10px] bg-zinc-950 border border-zinc-900 text-zinc-300 rounded px-1\">Math.floor(Date.now() / 1000) + 3600</code>."
  },
  {
    question: "What happens if I change the payload of an encoded JWT?",
    answer: "If you modify any character in the Header or Payload of an encoded JWT, the cryptographic signature will immediately become invalid. Security libraries and API gateways verifying the token will reject it as tampered. To make changes, you must edit the JSON payload and generate a new token with a new signature."
  },
  {
    question: "What is the difference between HS256, HS384, and HS512?",
    answer: "These are symmetric signing algorithms using Hash-based Message Authentication Codes (HMAC) combined with SHA-2 hashing functions. The difference lies in the hashing bit strength: HS256 uses SHA-256, HS384 uses SHA-384, and HS512 uses SHA-512. Higher strengths provide larger keys and greater cryptographic security."
  },
  {
    question: "Can I use a public/private key pair to sign a JWT?",
    answer: "Yes, by using asymmetric algorithms like RS256, RS512, or ES256. The token issuer signs the token using a secret private key, while client applications or other microservices verify the signature using the matching public key."
  },
  {
    question: "Is a JWT signature secure?",
    answer: "Yes. The signature guarantees the integrity of the token data. As long as your signing key remains secure and you use a secure algorithm (avoiding the algorithm value <code class=\"font-mono text-[10px] bg-zinc-950 border border-zinc-900 text-zinc-300 rounded px-1\">\"none\"</code>), the signature prevents unauthorized modifications to the token content."
  },
  {
    question: "How do I generate a JWT in Node.js?",
    answer: "In Node.js, you can generate a token using the popular <code class=\"font-mono text-[10px] bg-zinc-950 border border-zinc-900 text-zinc-300 rounded px-1\">jsonwebtoken</code> library. Import it and call the sign method with a payload, key, and options:<br /><code class=\"font-mono text-[10px] bg-zinc-950 border border-zinc-900 text-zinc-300 rounded px-2 py-1 block mt-2 overflow-x-auto whitespace-pre\">const token = jwt.sign({ userId: 123 }, 'secret-key', { expiresIn: '1h' });</code>"
  },
  {
    question: "How do I encode a JWT in Python?",
    answer: "Use the PyJWT library: <br/><code>import jwt; token = jwt.encode({'sub': '123'}, 'secret', algorithm='HS256')</code>."
  },
  {
    question: "How do I encode a JWT in Go?",
    answer: "Use golang-jwt library: <br/><code>token := jwt.NewWithClaims(jwt.SigningMethodHS256, claims); tokenString, _ := token.SignedString(mySigningKey)</code>."
  },
  {
    question: "How do I encode a JWT in Java?",
    answer: "Use Auth0's java-jwt library: <br/><code>String token = JWT.create().withSubject(\"123\").sign(Algorithm.HMAC256(\"secret\"));</code>."
  },
  {
    question: "What is the 'none' algorithm vulnerability?",
    answer: "The 'none' algorithm is a legacy option that allows tokens to be accepted without any signature validation. Attackers can exploit this by changing the header algorithm to 'none' and stripping the signature block, bypassing verification on insecure servers."
  },
  {
    question: "What is a JTI claim?",
    answer: "The 'jti' (JWT ID) claim provides a unique identifier for the JWT. It is used to prevent replay attacks by ensuring a token can only be used once."
  },
  {
    question: "What is the 'nbf' claim?",
    answer: "The 'nbf' (Not Before) claim identifies the time before which the token must not be accepted for processing."
  },
  {
    question: "What is the 'iat' claim?",
    answer: "The 'iat' (Issued At) claim identifies the time at which the JWT was generated, useful for measuring the age of a token."
  },
  {
    question: "Can I use multiple audiences in 'aud'?",
    answer: "Yes, the 'aud' claim can be a single string or an array of strings representing multiple target services."
  },
  {
    question: "How to generate RSA private keys for JWT?",
    answer: "You can generate RSA private keys in terminal: <br/><code>openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048</code>."
  },
  {
    question: "Does the JWT encoder validate expiration timestamps?",
    answer: "Yes, the tool validates the structure of your JSON payload and provides warnings if dates or timestamps are formatted incorrectly."
  }
];

const references = [
  { title: "RFC 7519 - JSON Web Token (JWT) Standard", url: "https://datatracker.ietf.org/doc/html/rfc7519", source: "IETF Standards" },
  { title: "JWT.io Introduction and Standards Guide", url: "https://jwt.io/introduction", source: "Auth0 Resources" }
];

const languageCodes = [
  {
    lang: "Node.js (jsonwebtoken)",
    code: `const jwt = require('jsonwebtoken');

const payload = { sub: 'user_123', role: 'admin' };
const secretKey = 'my-super-secret-key-value';

// Sign token with HS256 symmetric algorithm (expires in 2 hours)
const token = jwt.sign(payload, secretKey, { algorithm: 'HS256', expiresIn: '2h' });

console.log(token);`,
    note: "Generates standard dot-separated base64 encoded JWT token."
  },
  {
    lang: "Python (PyJWT)",
    code: `import jwt
import time

payload = {
    "sub": "user_123",
    "role": "admin",
    "exp": int(time.time()) + 7200 # Expires in 2 hours
}
secret = "my-super-secret-key-value"

# Sign token using symmetric HS256 algorithm
token = jwt.encode(payload, secret, algorithm="HS256")
print(token)`,
    note: "Automates timestamp formatting and hashing rounds."
  }
];

const mistakesList = [
  {
    title: "Using Weak Secret Keys",
    description: "Using short or dictionary words (like <code>mysecret</code>) as signing keys allows attackers to brute-force sign tokens using GPU dictionaries.",
    fix: "Use high-entropy random keys of at least 256 bits (32 bytes)."
  },
  {
    title: "Trusting JWT headers blindly",
    description: "Failing to restrict the allowed signing algorithms list on your verification servers enables attackers to bypass signatures via 'none' or public key attacks.",
    fix: "Explicitly declare the allowed algorithms (e.g. <code>['HS256']</code>) inside your verification methods."
  }
];
---

<ToolPageLayout
  title="JWT Encoder Online: Generate Secure JSON Web Tokens Instantly"
  description="Encode and sign JSON Web Tokens (JWT) safely in your browser. Generate secure JWTs with HS256, RS256, and custom claims. 100% local, client-side only."
  keywords="JWT Encoder, jwt encoder, jwt encoder online, online jwt encoder, encode jwt, jwt generator online, json web token generator, hs256 encoder, rs256 encoder"
  toolTitle="JWT Encoder"
  toolDescription="Construct and sign JSON Web Tokens locally. Customize the algorithm header, insert custom payload properties, set token expiration timers, and preview output streams."
  tabs={tabs}
  faqs={faqs}
>
  <JwtEncoder client:load />

  <div slot="seo-content" class="flex flex-col gap-8 font-sans text-sm text-zinc-400">
    <!-- Section: Intro -->
    <div>
      <h2 class="text-xl font-semibold text-zinc-50 tracking-tight mb-4 flex items-center gap-2">
        <span class="w-1.5 h-6 bg-accent-emerald rounded-full"></span>
        JWT Generation Mechanics
      </h2>
      <p class="leading-relaxed mb-4">
        JSON Web Tokens represent a signed protocol standard. Unlike encryption methods that hide payloads, JWT signing guarantees data integrity, ensuring that any modification to token contents results in validation failures at backend gateways.
      </p>
      <p class="leading-relaxed">
        Our **JWT Encoder** simplifies testing. Developers can edit headers, customize claims payloads, add expiry timestamps, and sign tokens using symmetric secrets or asymmetric private key certificates completely client-side in their browsers.
      </p>
    </div>

    <!-- Section: Privacy Badge -->
    <PrivacyBadge />

    <!-- Section: Comparison Table -->
    <ComparisonTable
      title="Symmetric vs Asymmetric JWT Algorithms"
      headers={["Feature", "Symmetric (HMAC - e.g. HS256)", "Asymmetric (RSA/ECDSA - e.g. RS256)"]}
      rows={[
        { label: "Keys Used", values: ["Single Shared Secret Key", "Private/Public Key Pair"] },
        { label: "Token Signing", values: ["Signed with Shared Secret Key", "Signed with Private Key"] },
        { label: "Token Verification", values: ["Verified with Shared Secret Key", "Verified with Public Key"] },
        { label: "Best Suited For", values: ["Internal monolithic apps, direct database routing", "Microservices architecture, third-party authentication"] }
      ]}
    />

    <!-- Section: Example Card -->
    <ExampleCard
      title="Sample Token Envelope Structure"
      description="Inspect how the three segments are composed:"
      examples={[
        { label: "Header block (Base64Url)", input: '{"alg": "HS256", "typ": "JWT"}', output: "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9", badge: "Header" },
        { label: "Payload block (Base64Url)", input: '{"sub": "12345", "name": "Admin"}', output: "eyJzdWIiOiIxMjM0NSIsIm5hbWUiOiJBZG1pbiJ9", badge: "Payload" }
      ]}
    />

    <!-- Programming Implementation Guides -->
    <LanguageSupport
      languages={languageCodes}
      title="Programmatic JWT Hashing & Encoding"
      description="Sign tokens securely in your backend architectures using these standard snippets:"
    />

    <!-- Common Mistakes -->
    <CommonMistakes
      mistakes={mistakesList}
      title="Common JWT Generation Pitfalls"
      description="Avoid these common security oversights when creating token-based architectures:"
    />

    <!-- Best Practices -->
    <BestPractices
      title="JWT Signing Best Practices"
      practices={[
        { title: "Enforce HS256 Key Lengths", description: "Verify your HMAC keys are at least 32 characters long to match SHA-256 byte boundaries." },
        { title: "Avoid 'none' Algorithm", description: "Explicitly disable the 'none' algorithm header verification on all authentication servers." }
      ]}
    />

    <!-- Official References -->
    <OfficialReferences
      references={references}
    />
  </div>
</ToolPageLayout>
