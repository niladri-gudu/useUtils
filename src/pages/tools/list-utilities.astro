---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
import { ListUtilities as ListUtilitiesComponent } from '../../components/ListUtilities';
import ComparisonTable from '../../components/content/ComparisonTable.astro';
import BestPractices from '../../components/content/BestPractices.astro';
import CommonMistakes from '../../components/content/CommonMistakes.astro';
import OfficialReferences from '../../components/content/OfficialReferences.astro';
import LanguageSupport from '../../components/content/LanguageSupport.astro';
import ExampleCard from '../../components/content/ExampleCard.astro';

const faqs = [
  {
    question: "How do I remove duplicate lines from a text list online?",
    answer: "You can remove duplicate lines instantly by pasting your text into our list utilities tool and enabling the <strong>Deduplicate</strong> mode. It filters out matching rows locally in your browser. You can configure it to keep the first occurrence, the last occurrence, or delete all duplicates entirely."
  },
  {
    question: "How do I sort a list alphabetically or by length?",
    answer: "Pasting your list into the tool allows you to select the <strong>Sort</strong> tab. Choose <em>Alphabetical (A-Z/Z-A)</em>, <em>Length-based</em> (to sort from shortest to longest string), <em>Natural</em> (correctly ordering numbers like 2 before 10), or <em>Reverse</em>. You can also toggle case sensitivity."
  },
  {
    question: "Can I add prefix, suffix, or line numbers to each list item in bulk?",
    answer: "Yes. In the <strong>Add Prefix/Suffix</strong> tab, you can define text to prepend or append to every item. You can also toggle line numbering with several format variations (e.g. <code>1. </code>, <code>01. </code>, <code>[1] </code>, or <code>Line 1: </code>) and set a custom start index."
  },
  {
    question: "How do I filter list items containing specific words or matching regular expressions?",
    answer: "Select the <strong>Filter</strong> tab. You can remove empty lines, keep or remove items containing a specific substring, or keep/remove items that match a <strong>Regular Expression (Regex)</strong> (such as <code>^\\d+$</code> to keep only numeric items). You can also filter items by their character length."
  },
  {
    question: "How do I split a comma-separated list into individual lines, or join lines with commas?",
    answer: "Under the <strong>Split & Join</strong> configuration, you can choose how your input is parsed. You can split by commas, tabs, spaces, or custom characters/regexes. For output, you can join the processed list with commas, pipes, spaces, or export it as a formatted <strong>JSON string array</strong>."
  },
  {
    question: "How do I change the casing of a list in bulk?",
    answer: "In the <strong>Clean & Case</strong> tab, select a target format from the <em>Case Converter</em> dropdown. This supports all programming casings (like <code>camelCase</code>, <code>snake_case</code>, <code>kebab-case</code>, and <code>CONSTANT_CASE</code>) and normal text layouts (like <code>UPPERCASE</code>, <code>lowercase</code>, and <code>Title Case</code>)."
  },
  {
    question: "What is the difference between Alphabetical and Natural sorting?",
    answer: "Standard alphabetical sorting compares strings character by character based on Unicode values, which places '10' before '2' (since '1' comes before '2'). <strong>Natural sorting</strong> detects multi-digit numbers within the text and sorts them numerically, placing '2' before '10' as humans expect."
  },
  {
    question: "What is the Visual List Sandbox and how does it work?",
    answer: "The <strong>Visual List Sandbox</strong> is an interactive board that displays your list items as draggable cards. It allows you to drag-and-drop to reorder rows, double-click any card to edit its text in real-time, delete cards individually, or uncheck them to temporarily disable them from the final output without deleting them."
  },
  {
    question: "How do I detect and analyze duplicate values in a list?",
    answer: "Switch the right-side preview tab to <strong>Dups Table</strong>. The tool will scan your list and show a frequency analysis table detailing exactly which rows are repeated and how many times they appear. It also features a quick 'Resolve' button to keep only one instance."
  },
  {
    question: "Is my text data safe and secure when using this tool?",
    answer: "Yes, 100%. Like all tools on useUtils, the List Utilities and Text Cleaner runs entirely on the client side in your web browser. No data, files, keys, or logs are ever uploaded, transmitted, or stored on a server. Your data remains completely private."
  },
  {
    question: "Does this list utility support large lists?",
    answer: "Yes. Since the engine is built on optimized native JavaScript string and array APIs, it can easily process lists of thousands of lines (such as IP logs, CSV fields, or email addresses) in real-time directly inside your browser."
  },
  {
    question: "How do I sort a list naturally in JavaScript?",
    answer: "Use <code>Intl.Collator</code>: <code>list.sort(new Intl.Collator(undefined, {numeric: true}).compare)</code>. This correctly sorts multi-digit numbers within text strings."
  },
  {
    question: "How do I remove duplicate lines programmatically in JavaScript?",
    answer: "Use <code>Set</code>: <code>const unique = [...new Set(lines)]</code>. This retains only unique strings in an array."
  },
  {
    question: "How to deduplicate a list in Python?",
    answer: "Use dict keys to preserve order: <code>unique_lines = list(dict.fromkeys(lines))</code>. Standard sets also work but do not guarantee sequence order."
  },
  {
    question: "What is a JSON array string and how is it generated from a list?",
    answer: "A JSON array string wraps lines in brackets and quotes (e.g. <code>[\"item1\", \"item2\"]</code>). Choosing the 'JSON Array' output format converts the list into a valid JSON string array for copy-pasting into code."
  },
  {
    question: "How can I remove empty lines from a list?",
    answer: "Under the Filter tab, select 'Remove Empty Lines'. Programmatically, filter arrays by checking string truthiness: <code>lines.filter(line => line.trim() !== '')</code>."
  },
  {
    question: "What is the difference between sorting alphabetically (case-sensitive vs case-insensitive)?",
    answer: "Case-sensitive sorting places all uppercase characters before lowercase characters (e.g., 'Zebra' before 'apple' because U+005A is less than U+0061). Case-insensitive sorting ignores capitalization and compares characters alphabetically."
  },
  {
    question: "Can I reverse the order of my list?",
    answer: "Yes. Under the Sort configuration, select the 'Reverse' operation to flip the sequence of lines (the first line becomes the last)."
  },
  {
    question: "How to append prefix and suffix formatting in Python?",
    answer: "Use list comprehensions: <code>formatted = [f\"prefix_{line}_suffix\" for line in lines]</code>."
  },
  {
    question: "Why is deduplication important for database seeding?",
    answer: "Database schemas enforce primary keys and unique indexes. Importing lists containing duplicates causes constraint violations and seed failures. Deduplicating the raw CSV keys prevents these errors."
  },
  {
    question: "Does the list utility support dragging to reorder lines?",
    answer: "Yes. Clicking on the 'Visual Sandbox' tab renders lines as individual cards, allowing you to drag-and-drop rows to manually sequence them."
  },
  {
    question: "Is there a limit to the file size I can import?",
    answer: "Since calculations run in browser memory, files under 10MB (typically ~100,000 lines) are processed smoothly. Larger files might cause temporary browser UI lags."
  }
];

const references = [
  { title: "MDN Web Docs - Intl.Collator for Natural Sorting", url: "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/Intl/Collator", source: "Mozilla Documentation" },
  { title: "Standard Algorithm for Array Deduplication in ECMAScript", url: "https://tc39.es/ecma262/multipage/keyed-collections.html#sec-set-objects", source: "TC39 Standards" }
];

const languageCodes = [
  {
    lang: "JavaScript",
    code: `// Array deduplication preserving order
const deduplicate = list => [...new Set(list)];

// Natural numerical sort
const naturalSort = list => {
  return list.sort(new Intl.Collator(undefined, { numeric: true }).compare);
};

const raw = ["item10", "item2", "item10"];
console.log(deduplicate(raw)); // ["item10", "item2"]
console.log(naturalSort(deduplicate(raw))); // ["item2", "item10"]`,
    note: "Uses standard Set and Intl.Collator APIs natively supported in modern JS engines."
  },
  {
    lang: "Python",
    code: `import re

# Deduplicate list preserving insertion order
raw_list = ["item10", "item2", "item10"]
unique_list = list(dict.fromkeys(raw_list))

# Natural numerical sort
def natural_sort_key(s):
    return [int(text) if text.isdigit() else text.lower() for text in re.split(r'(\\d+)', s)]

unique_list.sort(key=natural_sort_key)
print(unique_list) # ['item2', 'item10']`,
    note: "Python dictionary keys preserve sequence starting in version 3.7+."
  }
];

const mistakesList = [
  {
    title: "Unintentional Reordering of Items During Deduplication",
    description: "Converting arrays directly to a Set and back to an array in programming languages that do not maintain insertion order in Set structures (or using Python's set()) shifts list item sequences randomly.",
    fix: "Use dictionary keys (Python's dict.fromkeys) or filter functions that preserve raw indexing parameters."
  },
  {
    title: "Standard Unicode Alphabetical Sort on Numbers",
    description: "Standard string sorting sorts character codes literally, ordering ['10', '2', '1'] into ['1', '10', '2'], causing numerical layout errors.",
    fix: "Utilize natural sorting algorithms (like JavaScript's <code>Intl.Collator</code>) which parse numerical sequences recursively."
  }
];
---

<ToolPageLayout
  title="List Utilities & Text Cleaner: Online Sorting, Deduplication, and Formatting"
  description="Sort lists alphabetically or by length, remove duplicate lines, filter items with regex, add prefixes, suffixes or line numbers, and clean whitespace in real-time. Features an interactive visual sandbox editor."
  keywords="list utilities, list alphabetizer, remove duplicate lines, add prefix suffix, regex list filter, online text cleaner, line sorter, list builder, bulk case converter, json array generator"
  toolTitle="List Utilities & Text Cleaner"
  toolDescription="Format, sort, deduplicate, filter, and clean text lists in real-time. Features a visual sandbox editor with drag-and-drop reordering, inline editing, a duplicate frequency analyzer, and custom split/join parameters. Processed 100% locally."
  faqs={faqs}
>
  <ListUtilitiesComponent client:load />

  <!-- Explanatory content slots for layout standard conformity -->
  <div slot="seo-content" class="flex flex-col gap-8 font-sans text-sm text-zinc-400">
    <!-- Section: Intro -->
    <div>
      <h2 class="text-xl font-semibold text-zinc-50 tracking-tight mb-4 flex items-center gap-2">
        <span class="w-1.5 h-6 bg-accent-emerald rounded-full"></span>
        How to Use the List Utilities & Text Cleaner
      </h2>
      <p class="leading-relaxed mb-4">
        Our list utilities workspace provides a comprehensive suite of tools to manipulate text arrays, logs, and database variables. Simply paste your raw text into the <strong class="text-zinc-200">raw list ingestion</strong> panel, select your desired operations in the configuration tabs, and see the transformed results in the <strong class="text-zinc-200">output preview</strong> instantly.
      </p>
      <p class="leading-relaxed">
        You can also toggle the <strong class="text-zinc-200">Visual Sandbox</strong> to reorder elements using native drag-and-drop, double-click items to edit their text inline, or view duplicate frequencies in the <strong class="text-zinc-200">Duplicates Table</strong>. All configurations are applied sequentially in real-time.
      </p>
    </div>

    <!-- Sibling Cross Links -->
    <div class="flex flex-col gap-4">
      <h2 class="text-xl font-semibold text-zinc-50 tracking-tight flex items-center gap-2">
        <span class="w-1.5 h-6 bg-accent-emerald rounded-full"></span>
        Related Text List Utilities
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
        <a href="/tools/remove-duplicate-lines" class="p-3 bg-zinc-900/30 border border-border-hairline rounded-lg hover:border-accent-emerald/30 text-xs font-mono text-zinc-200 hover:text-accent-emerald transition-all">Remove Duplicate Lines</a>
        <a href="/tools/word-counter" class="p-3 bg-zinc-900/30 border border-border-hairline rounded-lg hover:border-accent-emerald/30 text-xs font-mono text-zinc-200 hover:text-accent-emerald transition-all">Word Counter & Text Analyzer</a>
        <a href="/tools/text-inspector" class="p-3 bg-zinc-900/30 border border-border-hairline rounded-lg hover:border-accent-emerald/30 text-xs font-mono text-zinc-200 hover:text-accent-emerald transition-all">Text Inspector</a>
      </div>
    </div>

    <!-- Section: List Operations Comparison Table -->
    <ComparisonTable
      title="Overview of List Transformations"
      description="This tool supports several operations to standardize and sanitize raw strings for databases, configurations, or code codebases. Here is how different operations modify your lists:"
      headers={["Operation", "Input Example", "Configuration Options", "Output Result"]}
      rows={[
        { label: "Deduplication", values: ["apple<br/>orange<br/>apple", "Keep First / Keep Last / Remove All", "apple<br/>orange"] },
        { label: "Natural Sort", values: ["item_10<br/>item_2", "Numeric-aware comparison (A-Z/Z-A)", "item_2<br/>item_10"] },
        { label: "Length Sort", values: ["banana<br/>pear<br/>kiwi", "Ascending / Descending length", "pear<br/>kiwi<br/>banana"] },
        { label: "Line Numbering", values: ["debug<br/>error", "Formats: 1., 01., [1], Line 1:", "01. debug<br/>02. error"] },
        { label: "Regex Filtering", values: ["api/v1/users<br/>web/home<br/>api/v1/auth", "Keep matching: <code>^api/</code>", "api/v1/users<br/>api/v1/auth"] },
        { label: "Case Conversion", values: ["USER_ID<br/>auth_token", "camelCase, snake_case, Title Case, etc.", "userId<br/>authToken"] }
      ]}
    />

    <!-- Section: Example Card -->
    <ExampleCard
      title="List Formatting Examples"
      description="Study typical input datasets and their processed outputs:"
      examples={[
        { label: "Deduplicated IP Address Log", input: "192.168.1.1\n10.0.0.1\n192.168.1.1", output: "192.168.1.1\n10.0.0.1 (Duplicates removed)", badge: "Deduplicate" },
        { label: "Prefixed SQL DB Columns", input: "id\nusername\nemail", output: "user_id,\nuser_username,\nuser_email, (Prefix & Suffix applied)", badge: "Prefix/Suffix" }
      ]}
    />

    <!-- Programming Implementation Guides -->
    <LanguageSupport
      languages={languageCodes}
      title="Programmatic List Operations Snippets"
      description="Deduplicate and sort lists inside your custom applications:"
    />

    <!-- Common Mistakes -->
    <CommonMistakes
      mistakes={mistakesList}
      title="Common List Parsing Mistakes"
      description="Avoid these common errors when processing large datasets and array lists:"
    />

    <!-- Best Practices -->
    <BestPractices
      title="List Cleaning Best Practices"
      practices={[
        { title: "Deduplicate Prior to DB Imports", description: "Filter out redundant rows to prevent unique key constraint violations in database schemas." },
        { title: "Use Natural Sort for Versioning", description: "Enforce numerical sorting when ordering build numbers, server configurations, or code patches." },
        { title: "Leverage Visual Sandbox Reordering", description: "Switch to card displays to drag, re-order, or disable rows manually in the document flow." }
      ]}
    />

    <!-- Official References -->
    <OfficialReferences
      references={references}
    />
  </div>
</ToolPageLayout>
