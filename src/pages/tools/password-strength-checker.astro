---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
import PasswordStrengthChecker from '../../components/PasswordStrengthChecker';
import ComparisonTable from '../../components/content/ComparisonTable.astro';
import BestPractices from '../../components/content/BestPractices.astro';
import CommonMistakes from '../../components/content/CommonMistakes.astro';
import OfficialReferences from '../../components/content/OfficialReferences.astro';
import ExampleCard from '../../components/content/ExampleCard.astro';

const tabs = [
  { label: 'Password Checker', href: '/tools/password-strength-checker', active: true },
  { label: 'Password Generator', href: '/tools/secure-password-generator' },
  { label: 'UUID Generator', href: '/tools/uuid-generator' },
  { label: 'Hash Generator', href: '/tools/hash-generator' }
];

const faqs = [
  {
    question: "Is this password checker free?",
    answer: "Yes, completely free with no sign-up. Check unlimited passwords right in your browser."
  },
  {
    question: "Is my password sent to a server?",
    answer: "No. The strength check runs entirely on your device. Your password never leaves your computer — never type a real password into an online checker that uploads it."
  },
  {
    question: "How is password strength measured?",
    answer: "The tool scores length, character variety (upper/lowercase, numbers, symbols), and flags common patterns like repeated characters, years, and dictionary words."
  },
  {
    question: "What does the crack-time estimate mean?",
    answer: "It's an estimate of how long a brute-force attack with roughly 10 billion guesses per second would take to find your password — a common benchmark, not a guarantee of real-world security."
  },
  {
    question: "What makes a password strong?",
    answer: "Length is the single biggest factor. A 16-character password with mixed character types is far stronger than a short one with many symbols. Aim for 12–16+ characters."
  },
  {
    question: "Is a longer password better than adding symbols?",
    answer: "Yes. Every extra character multiplies the search space; adding a symbol class only adds a small constant. 'correct horse battery staple' beats 'P@ssw0rd!' easily."
  },
  {
    question: "Why is 'P@ssw0rd' still weak?",
    answer: "It's on lists of common passwords used by attackers, and substitutions like @ for a are predictable. Pattern-based guessing finds it in seconds regardless of length."
  },
  {
    question: "What is a passphrase?",
    answer: "A string of 4+ random words, like 'correct horse battery staple'. It's long, easy to remember, and far stronger than a short complex password."
  },
  {
    question: "How often should I change passwords?",
    answer: "Only change when there's evidence of a breach. Frequent forced rotation pushes people toward weaker passwords. Prioritize unique passwords per site and use a password manager."
  },
  {
    question: "Should I reuse passwords across sites?",
    answer: "Never. If one site leaks your password, attackers try it everywhere. A password manager makes unique passwords per site effortless."
  },
  {
    question: "What is a password manager?",
    answer: "Software that stores all your passwords in an encrypted vault unlocked by one master password, and generates strong unique passwords for each site."
  },
  {
    question: "Does the generated password use true randomness?",
    answer: "Yes — the generator uses the Web Crypto API's cryptographically secure random number generator, the same standard used by browsers for security features."
  },
  {
    question: "Is two-factor authentication (2FA) important?",
    answer: "Yes. 2FA protects your account even if your password leaks. Use an authenticator app rather than SMS when possible."
  },
  {
    question: "Why does this checker not use Have I Been Pwned?",
    answer: "Checking against a breach API would require sending your password data to a server. To keep everything local and private, this tool only flags a built-in list of common passwords."
  },
  {
    question: "How long should my password be in 2026?",
    answer: "Security guidance now recommends at least 15–16 characters. Combined with a password manager and 2FA, that protects against virtually all practical attacks."
  }
];

const references = [
  { title: "NIST SP 800-63B - Digital Identity Guidelines (Password Rules)", url: "https://pages.nist.gov/800-63-3/sp800-63b.html", source: "NIST" },
  { title: "OWASP - Password Storage Cheat Sheet", url: "https://cheatsheetseries.owasp.org/cheatsheets/Password_Storage_Cheat_Sheet.html", source: "OWASP" },
  { title: "xkcd 936 - Password Strength", url: "https://xkcd.com/936/", source: "xkcd" }
];

const mistakesList = [
  {
    title: "Using Real Passwords",
    description: "Typing your actual password into any checker (even a local one) risks mistakes and breeds bad habits.",
    fix: "Test representative examples instead — or use a checker you trust that never uploads, like this one."
  },
  {
    title: "Confusing Complexity With Strength",
    description: "'Aa1!aaaa' hits every checkbox but is weaker than 'kangaroo-jumps-over-the-moon'.",
    fix: "Prioritize length and randomness over symbol gymnastics."
  },
  {
    title: "Reusing One Strong Password",
    description: "One great password reused everywhere collapses the moment any single site is breached.",
    fix: "Use a unique password per site, generated and stored by a password manager."
  }
];

const practicesList = [
  { title: "Go Long", description: "Target 15+ characters. Length multiplies the search space far more than adding character classes." },
  { title: "Use a Passphrase", description: "Chain 4–6 random words. Memorable to you, brutal for brute force." },
  { title: "Let a Manager Generate", description: "Let a password manager create and store random passwords; you only memorize the master password." },
  { title: "Add 2FA", description: "Enable app-based 2FA on anything important — it stops attackers even with a leaked password." },
  { title: "Never Share or Reuse", description: "Unique password per account. If one leaks, the damage stops there." }
];

const pwExamples = [
  { label: "123456", input: "6 digits", output: "Very Weak — instant", badge: "Common" },
  { label: "P@ssw0rd!", input: "8 chars, symbols", output: "Weak — seconds", badge: "Pattern" },
  { label: "Tr0ub4dor&3", input: "11 chars", output: "Fair — months", badge: "xkcd" },
  { label: "correct horse battery staple", input: "28 chars, 4 words", output: "Very Strong — eons", badge: "Passphrase" }
];
---

<ToolPageLayout
  title="Password Strength Checker Online Free: Test Your Password"
  description="Check password strength online for free. Score length, variety, and patterns, get crack-time estimates and tips — 100% local, your password never leaves your device."
  keywords="password strength checker, password checker, test password strength, password strength test, strong password check, password security checker, how strong is my password"
  toolTitle="Password Strength Checker"
  toolDescription="Instantly score any password with a crack-time estimate, character analysis, and improvement tips. Includes a secure random password generator — all processed locally."
  tabs={tabs}
  faqs={faqs}
>
  <PasswordStrengthChecker client:load />

  <div slot="seo-content" class="flex flex-col gap-8 font-sans text-sm text-zinc-400">
    <div>
      <h2 class="text-xl font-semibold text-zinc-55 tracking-tight mb-4 flex items-center gap-2">
        <span class="w-1.5 h-6 bg-accent-emerald rounded-full"></span>
        How Password Strength Is Evaluated
      </h2>
      <p class="leading-relaxed mb-4">
        Strength is really about **entropy** — the number of possible passwords an attacker would have to try. This tool estimates the character pool (lowercase, uppercase, digits, symbols) and raises it to the length of your password, then converts that into a realistic crack-time estimate.
      </p>
      <p class="leading-relaxed">
        It also flags human patterns that defeat naive math: repeated characters, calendar years, keyboard rows, and passwords on the most common breach lists. Length beats complexity, and randomness beats cleverness.
      </p>
    </div>

    <ExampleCard
      title="Strength by Example"
      description="How different passwords score:"
      examples={pwExamples}
    />

    <ComparisonTable
      title="Password Security Approaches"
      headers={["Approach", "Strength", "Best For"]}
      rows={[
        { label: "Short + symbols", values: ["Weak", "Legacy requirements"] },
        { label: "Long passphrase", values: ["Very strong", "Master passwords, memorable"] },
        { label: "Manager-generated", values: ["Maximum", "Site passwords"] },
        { label: "Password + 2FA", values: ["Defense in depth", "Anything important"] }
      ]}
    />

    <CommonMistakes
      mistakes={mistakesList}
      title="Password Pitfalls"
      description="Avoid these common mistakes:"
    />

    <BestPractices
      title="Password Best Practices"
      practices={practicesList}
    />

    <OfficialReferences
      references={references}
    />
  </div>
</ToolPageLayout>
