---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
import QrCodeGenerator from '../../components/QrCodeGenerator';
import ComparisonTable from '../../components/content/ComparisonTable.astro';
import BestPractices from '../../components/content/BestPractices.astro';
import CommonMistakes from '../../components/content/CommonMistakes.astro';
import OfficialReferences from '../../components/content/OfficialReferences.astro';
import ExampleCard from '../../components/content/ExampleCard.astro';

const tabs = [
  { label: 'QR Code Generator', href: '/tools/qr-code-generator', active: true },
  { label: 'Image to Base64', href: '/tools/image-to-base64' },
  { label: 'Base64 Encoder', href: '/tools/base64-encoder' },
  { label: 'UUID Generator', href: '/tools/uuid-generator' }
];

const faqs = [
  {
    question: "What is a QR Code?",
    answer: "A QR (Quick Response) code is a two-dimensional matrix barcode invented by Denso Wave in 1994. It stores data in both horizontal and vertical patterns of black and white squares, making it fast to scan and capable of holding far more information than a traditional one-dimensional barcode."
  },
  {
    question: "Is this QR code generator free?",
    answer: "Yes, completely free with no sign-up required. Generate unlimited QR codes with custom sizes, colors, error correction levels, and export them as high-resolution PNG or vector SVG files."
  },
  {
    question: "Is generating a QR code online safe?",
    answer: "Yes. The QR code is generated entirely in your browser using the qrcode library. Your content is never uploaded to any server, so sensitive data like Wi-Fi passwords or personal contact details never leave your device."
  },
  {
    question: "How much data can a QR code store?",
    answer: "A QR code can store up to 7,089 numeric characters, 4,296 alphanumeric characters, or 2,953 bytes of binary data. The maximum capacity depends on the version (size) of the code and the error correction level you choose."
  },
  {
    question: "What are the error correction levels in QR codes?",
    answer: "QR codes support four error correction levels: Low (L, 7%), Medium (M, 15%), Quartile (Q, 25%), and High (H, 30%). Higher levels store more redundant data so the code remains scannable even when up to 30% is damaged or covered."
  },
  {
    question: "How do I scan a QR code?",
    answer: "Open the camera app on your smartphone or use the built-in scanner in iOS, Android, or your browser. Point the camera at the QR code and tap the notification that appears. No separate app is required on modern phones."
  },
  {
    question: "Can I change the color of a QR code?",
    answer: "Yes. You can customize both the foreground and background colors. However, for reliable scanning, always keep a strong contrast between the two — dark modules on a light background (or vice versa) scan best."
  },
  {
    question: "What is the difference between PNG and SVG QR codes?",
    answer: "PNG is a raster format made of pixels, ideal for web and digital use. SVG is a vector format that scales to any size without losing quality, making it perfect for print, t-shirts, and large signs."
  },
  {
    question: "Can I generate a QR code for Wi-Fi?",
    answer: "Yes. Use the Wi-Fi preset or enter the WIFI: format directly, such as WIFI:T:WPA;S:NetworkName;P:Password;;. Scanning it connects devices to your network instantly without typing the password."
  },
  {
    question: "How do I create a QR code for a vCard or contact card?",
    answer: "Use the vCard preset or paste a VCARD payload like BEGIN:VCARD followed by FN, TEL, and EMAIL fields and END:VCARD. Scanning it saves the contact directly to the phone's address book."
  },
  {
    question: "Why is my QR code not scanning?",
    answer: "Common causes include low contrast between colors, a missing quiet zone (margin), damage to the code, or scanning a screenshot at too small a size. Try increasing the error correction level or switching to black on white."
  },
  {
    question: "Do QR codes expire?",
    answer: "Static QR codes (like those generated by this tool) encode data directly and never expire. Dynamic QR codes, which redirect through a URL, can expire if the linked content is taken down."
  },
  {
    question: "Can QR codes be scanned without internet access?",
    answer: "Yes. The code itself is always scannable offline. If it encodes plain text, Wi-Fi, or contact data, no internet is required at all. Internet is only needed when the QR code links to a web URL."
  },
  {
    question: "How is this QR code generator different from others?",
    answer: "It runs 100% locally in your browser, offers both PNG and SVG export, full color and size control, quick presets for URLs, Wi-Fi, vCards and more — with no watermarks and no uploads."
  },
  {
    question: "How do I print a QR code at a large size?",
    answer: "Download the SVG version, which scales infinitely without pixelation. A 1:1 module ratio of about 4mm per module keeps codes scannable at arm's length. Larger quiet zones help scanners too."
  },
  {
    question: "What can I put inside a QR code?",
    answer: "Virtually anything text-based: URLs, plain text, Wi-Fi credentials, email addresses (mailto:), phone numbers (tel:), SMS messages (SMSTO:), geolocation coordinates (geo:), vCards, or payment payloads."
  }
];

const references = [
  { title: "ISO/IEC 18004:2015 - QR Code Bar Code Symbology Specification", url: "https://www.iso.org/standard/62021.html", source: "ISO Standards" },
  { title: "qrcode - QR code generation library documentation", url: "https://github.com/soldair/node-qrcode", source: "GitHub" }
];

const mistakesList = [
  {
    title: "Too Little Quiet Zone Margin",
    description: "The white border around a QR code is mandatory for scanning. Removing it or placing the code flush against text or artwork can cause scanners to fail.",
    fix: "Keep a margin of at least 4 modules (use the margin slider above) so scanners can reliably locate the three finder squares."
  },
  {
    title: "Inverted or Low-Contrast Colors",
    description: "Scanning relies on strong contrast. Light-on-light or decorative color combinations can break detection entirely.",
    fix: "Use dark modules on a light background, or test a high-contrast variant if a custom brand palette must be used."
  },
  {
    title: "Printing a Screenshot Instead of Vector Art",
    description: "Upscaling a small PNG screenshot makes modules blurry and edges soft, degrading scannability on large print surfaces.",
    fix: "Always export the SVG for print so the code stays crisp at any physical size."
  }
];

const practicesList = [
  { title: "Choose High Error Correction for Print", description: "For signs, packaging, or stickers that may get scratched or partially covered, select the H (30%) error correction level." },
  { title: "Test on Multiple Devices", description: "Before printing, scan the final version with both an iPhone camera app and an Android scanner to catch contrast or sizing problems." },
  { title: "Use Short URLs", description: "Long URLs create denser, more complex codes. Use a link shortener to keep modules large and easy to scan at a distance." },
  { title: "Keep Sensitive Data Local", description: "This generator never uploads your content. For Wi-Fi passwords or personal contact info, the browser-only processing keeps your data private." }
];
---

<ToolPageLayout
  title="QR Code Generator Online: Free Custom QR Codes (PNG & SVG)"
  description="Generate free QR codes for URLs, Wi-Fi, vCards, email and more. Customizable colors, sizes, and error correction. Download as PNG or scalable SVG — fully in-browser."
  keywords="qr code generator, free qr code, create qr code online, qr code generator with logo, wifi qr code generator, vcard qr code, qr code png svg, custom qr code"
  toolTitle="QR Code Generator"
  toolDescription="Generate scannable QR codes for URLs, Wi-Fi networks, contacts, and more. Customize colors, size, and error correction, then download as PNG or vector SVG — all processed locally."
  tabs={tabs}
  faqs={faqs}
>
  <QrCodeGenerator client:load />

  <div slot="seo-content" class="flex flex-col gap-8 font-sans text-sm text-zinc-400">
    <!-- Section: Intro -->
    <div>
      <h2 class="text-xl font-semibold text-zinc-55 tracking-tight mb-4 flex items-center gap-2">
        <span class="w-1.5 h-6 bg-accent-emerald rounded-full"></span>
        How QR Code Generation Works
      </h2>
      <p class="leading-relaxed mb-4">
        A **QR code** encodes data into a grid of black and white modules using Reed-Solomon error correction. The pattern is organized around three large **finder patterns** (the corner squares) that scanners use to detect and orient the code, plus timing patterns that keep the grid aligned.
      </p>
      <p class="leading-relaxed">
        When you enter text above, the generator converts your payload into binary codewords, applies the selected **error correction level**, and arranges them into the characteristic matrix. The result is rendered as a crisp PNG or an infinitely scalable SVG right in your browser.
      </p>
    </div>

    <!-- Section: Example Card -->
    <ExampleCard
      title="QR Data Formats You Can Encode"
      description="Different payload prefixes trigger different actions when scanned:"
      examples={[
        { label: "Web URL", input: "https://useutils.com", output: "Opens a webpage", badge: "URL" },
        { label: "Wi-Fi Access", input: "WIFI:T:WPA;S:MyNet;P:secret;;", output: "Connects to network", badge: "Wi-Fi" },
        { label: "Contact Card", input: "BEGIN:VCARD…FN:John Doe…END:VCARD", output: "Saves a contact", badge: "vCard" },
        { label: "Phone Number", input: "tel:+15551234567", output: "Dials a number", badge: "Phone" }
      ]}
    />

    <!-- Section: Comparison Table -->
    <ComparisonTable
      title="QR Error Correction Levels Explained"
      headers={["Level", "Correction", "Damage Tolerance", "Best For", "Capacity Impact"]}
      rows={[
        { label: "Low (L)", values: ["7%", "Minimal", "High-density payloads", "Largest capacity"] },
        { label: "Medium (M)", values: ["15%", "Moderate", "Digital screens", "Balanced"] },
        { label: "Quartile (Q)", values: ["25%", "Good", "General use", "Reduced"] },
        { label: "High (H)", values: ["30%", "Excellent", "Print / packaging / stickers", "Smallest capacity"] }
      ]}
    />

    <!-- Common Mistakes -->
    <CommonMistakes
      mistakes={mistakesList}
      title="QR Code Design Pitfalls"
      description="Avoid these mistakes to keep your codes reliably scannable:"
    />

    <!-- Best Practices -->
    <BestPractices
      title="QR Code Best Practices"
      practices={practicesList}
    />

    <!-- Official References -->
    <OfficialReferences
      references={references}
    />
  </div>
</ToolPageLayout>
