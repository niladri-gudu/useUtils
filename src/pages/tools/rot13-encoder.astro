---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
import { Rot13Encoder } from '../../components/Rot13Encoder';
import ComparisonTable from '../../components/content/ComparisonTable.astro';
import BestPractices from '../../components/content/BestPractices.astro';
import CommonMistakes from '../../components/content/CommonMistakes.astro';
import OfficialReferences from '../../components/content/OfficialReferences.astro';
import LanguageSupport from '../../components/content/LanguageSupport.astro';
import ExampleCard from '../../components/content/ExampleCard.astro';
import PrivacyBadge from '../../components/content/PrivacyBadge.astro';

const tabs = [
  { label: 'ROT13 Encoder', href: '/tools/rot13-encoder', active: true },
  { label: 'Caesar Cipher', href: '/tools/caesar-cipher' },
  { label: 'Vigenere Cipher', href: '/tools/vigenere-cipher' }
];

const faqs = [
  {
    question: "What is the ROT13 cipher and how does it work?",
    answer: "ROT13 (\"rotate by 13 places\") is a simple substitution cipher that replaces a letter with the letter 13 positions ahead of it in the alphabet. For instance, 'A' becomes 'N', 'B' becomes 'O', and 'Z' becomes 'M'. Because there are 26 letters in the English alphabet, applying ROT13 twice returns the original text, making it a symmetric (self-inverse) cipher."
  },
  {
    question: "What are the differences between ROT13, ROT5, ROT18, and ROT47?",
    answer: "<strong>ROT13</strong> rotates alphabetical letters (A-Z) by 13 positions. <strong>ROT5</strong> rotates numeric digits (0-9) by 5 positions. <strong>ROT18</strong> combines ROT13 and ROT5, providing alphanumeric rotation. <strong>ROT47</strong> rotates all printable ASCII characters (from code 33 '!' to 126 '~') by 47 positions, which scrambles letters, numbers, spaces, and punctuation marks under a single shift."
  },
  {
    question: "How do you decrypt a Caesar cipher?",
    answer: "To decrypt a Caesar cipher, you rotate each letter in the opposite direction of the encryption shift. For instance, if a message was encrypted with a shift of 3, you decrypt it by shifting back 3 positions (or shifting forward by 23, since 26 - 3 = 23). If the shift value is unknown, you can brute-force the cipher by trying all 25 possible shift offsets until readable text is revealed."
  },
  {
    question: "How does the Vigenère cipher work and why is it polyalphabetic?",
    answer: "The Vigenère cipher is a polyalphabetic substitution cipher, meaning it uses multiple Caesar ciphers in sequence. It encrypts letters using shifts determined by a keyword. For example, if the keyword is \"KEY\" (shifts 10, 4, 24), the first letter is shifted by 10, the second by 4, the third by 24, and the pattern repeats. This hides single-letter frequencies, making it much harder to crack than Caesar."
  },
  {
    question: "What is the Atbash cipher, and is it a symmetric cipher?",
    answer: "Yes. The Atbash cipher is a specific type of monoalphabetic substitution cipher that reverses the alphabet: 'A' becomes 'Z', 'B' becomes 'Y', and 'Z' becomes 'A'. Because it mirrors the alphabet, Atbash is self-reciprocal (symmetric), meaning the exact same algorithm is used to encrypt and decrypt."
  },
  {
    question: "Can ciphers like ROT13 or Caesar be used to secure sensitive passwords or data?",
    answer: "<strong>No.</strong> Classical ciphers like ROT13, Caesar, and Vigenère provide absolutely no modern cryptographic security. They can be cracked in milliseconds using brute-force, letter frequency analysis, or dictionary checks. They should only be used for educational purposes, puzzles, simple spoiler hiding, or legacy formatting tests, never for passwords or confidential information."
  },
  {
    question: "How does letter frequency analysis help in cracking classical ciphers?",
    answer: "In any language, certain letters appear more frequently than others. In English, 'E' is the most common (approx. 12.7%), followed by 'T', 'A', and 'O'. Monoalphabetic ciphers like Caesar shift the alphabet but preserve these frequency ratios. By analyzing letter distribution in the ciphertext and aligning the tallest peaks with 'E' and 'T', a codebreaker can instantly deduce the key."
  },
  {
    question: "What is a brute-force attack on a Caesar cipher?",
    answer: "A brute-force attack involves systematically testing every possible decryption key. For a Caesar cipher, there are only 25 unique shift keys. A computer can decrypt the ciphertext using all 25 shifts and score the results based on standard English letter frequencies and dictionary matches, identifying the correct shift in microseconds."
  },
  {
    question: "Is ROT13 its own inverse?",
    answer: "Yes, ROT13 is its own inverse (a self-reciprocal function). Rotating a letter 13 places twice results in a 26-place shift. Since there are 26 letters in the Latin alphabet, this returns the letter to its starting position. Therefore, <code>rot13(rot13(text)) === text</code>."
  },
  {
    question: "Is my text data sent to a server when using this encoder/decoder?",
    answer: "No. All conversions, encodings, decodings, letter frequency calculations, and brute-force simulations are performed completely locally within your browser using JavaScript. No text, key, or file contents are sent to our servers. This ensures 100% privacy and security for your inputs."
  },
  {
    question: "Why is the Vigenère cipher historically called 'le chiffre indéchiffrable'?",
    answer: "Historically, Vigenère was called the \"indecipherable cipher\" because polyalphabetic ciphers resist simple letter frequency analysis. By shifting the same letter differently depending on its position relative to the keyword, the standard frequency peaks are flattened. It was considered unbreakable for over 300 years until systematic cracking methods like the Kasiski examination were developed in the 19th century."
  },
  {
    question: "How do I encode ROT13 in JavaScript?",
    answer: "Replace characters using code offsets: <br/><code>str.replace(/[a-zA-Z]/g, c => String.fromCharCode(c.charCodeAt(0) + (c.toLowerCase() < 'n' ? 13 : -13)))</code>."
  },
  {
    question: "How to run ROT13 in Python?",
    answer: "Use the built-in codecs library: <br/><code>import codecs; codecs.encode(text, 'rot_13')</code>."
  },
  {
    question: "What is ROT18?",
    answer: "ROT18 is a combination of ROT13 (shifting letters A-Z by 13 positions) and ROT5 (shifting digits 0-9 by 5 positions)."
  },
  {
    question: "What is the Kasiski method for Vigenère ciphers?",
    answer: "Kasiski examination identifies repeating sequences of characters in the ciphertext to estimate the length of the Vigenère secret keyword."
  },
  {
    question: "Is Atbash a symmetric cipher?",
    answer: "Yes, because mirroring the alphabet twice returns the original letters (A maps to Z and Z maps to A)."
  },
  {
    question: "Does ROT13 shift punctuation?",
    answer: "No. Classical ROT13 only shifts standard Latin alphabet letters (a-z and A-Z), leaving special characters, digits, and spaces untouched."
  },
  {
    question: "Why do forums use ROT13?",
    answer: "ROT13 is widely used online to hide spoilers, answers to puzzles, movie summaries, or offensive jokes from casual viewing."
  },
  {
    question: "Can I convert large text files with ROT13?",
    answer: "Yes, you can upload files in the file upload area, and they will be shifted instantly in your local browser."
  },
  {
    question: "Does this tool support offline usage?",
    answer: "Yes. Once the page has loaded, all cipher shifts and frequency analysis graphs are calculated completely offline."
  }
];

const references = [
  { title: "ROT13 self-reciprocal substitution cipher specification", url: "https://en.wikipedia.org/wiki/ROT13", source: "Wikipedia Cryptography Library" },
  { title: "Standard English Letter Frequency Distribution Data", url: "https://www.math.cornell.edu/~mec/2003-2004/cryptography/subs/frequencies.html", source: "Cornell University Mathematics" }
];

const languageCodes = [
  {
    lang: "JavaScript",
    code: `function rot13(str) {
  return str.replace(/[a-zA-Z]/g, char => {
    const code = char.charCodeAt(0);
    const isLower = code >= 97;
    const base = isLower ? 97 : 65;
    return String.fromCharCode(((code - base + 13) % 26) + base);
  });
}

console.log(rot13("Hello World!")); // Output: Uryyb Jbeyq!`,
    note: "Symmetric: passing the output back to the function decrypts it."
  },
  {
    lang: "Python",
    code: `import codecs

text = "Hello World!"
# ROT13 is natively supported by codecs library
encoded = codecs.encode(text, 'rot_13')

print(encoded) # Output: Uryyb Jbeyq!`,
    note: "Uses standard library codecs module."
  }
];

const mistakesList = [
  {
    title: "Using Classical Ciphers for Application Security",
    description: "Relying on ciphers like ROT13, Caesar, or Vigenère to protect sensitive tokens or passwords in modern web applications. They can be cracked instantly.",
    fix: "Use standard cryptographically secure algorithms like AES-256-GCM for any sensitive data encryption."
  },
  {
    title: "Mismatched character sets in ROT47",
    description: "Assuming ROT47 shifts only alphabetic characters. ROT47 shifts all printable ASCII characters (including spaces, digits, and brackets), which can lead to unexpected outputs.",
    fix: "Verify character codes match the expected 33-126 range before applying ROT47 shifts."
  }
];
---

<ToolPageLayout
  title="ROT13 & Caesar Cipher Studio Online: Encode, Decode & Crack Ciphers"
  description="Encode, decode, and analyze classical ciphers including ROT13, Caesar, Vigenère, Atbash, and ROT47. Features real-time letter frequency analysis charts and automated brute-force Caesar decryption."
  keywords="rot13 encoder, caesar cipher decoder, vigenere cipher online, atbash cipher, rot13 decoder, classical ciphers, brute force caesar cipher, letter frequency analysis"
  toolTitle="ROT13 & Caesar Cipher Studio"
  toolDescription="Analyze, encrypt, and decrypt classical substitution ciphers in real-time. Explore letter frequency distributions, run brute-force cracking simulations, and process plaintext inputs locally."
  tabs={tabs}
  faqs={faqs}
>
  <Rot13Encoder client:load />

  <div slot="seo-content" class="flex flex-col gap-8 font-sans text-sm text-zinc-400">
    <!-- Section: Intro -->
    <div>
      <h2 class="text-xl font-semibold text-zinc-50 tracking-tight mb-4 flex items-center gap-2">
        <span class="w-1.5 h-6 bg-accent-emerald rounded-full"></span>
        Introduction to Symmetric Classical Ciphers
      </h2>
      <p class="leading-relaxed mb-4">
        Symmetric substitution ciphers are the ancestors of modern cryptography. **ROT13** rotates alphabetic characters by 13 positions, which is exactly half of the English alphabet. This makes it self-reciprocal (symmetric): applying the transformation twice yields the original plaintext.
      </p>
      <p class="leading-relaxed">
        Our **ROT13 & Caesar Cipher Studio** is an interactive cryptanalysis environment. Examine letter frequency curves comparing inputs to standard English distributions, execute automated Caesar brute-force solvers, and test classical substitution algorithms completely offline.
      </p>
    </div>

    <!-- Section: Privacy Badge -->
    <PrivacyBadge />

    <!-- Section: Comparison Table -->
    <ComparisonTable
      title="Classical Ciphers Comparison"
      headers={["Cipher Type", "Shift Mechanism", "Key Space Size", "Symmetric", "Cryptographic Security Status"]}
      rows={[
        { label: "ROT13", values: ["Fixed rotation (+13)", "1 key (Fixed)", "Yes", "Zero (Easily decoded)"] },
        { label: "Caesar Cipher", values: ["Custom shift offset (0-25)", "25 keys", "Yes (with offset complement)", "Zero (Cracked in microseconds)"] },
        { label: "Atbash Cipher", values: ["Reflective letter swap", "1 key (Fixed)", "Yes", "Zero"] },
        { label: "Vigenère Cipher", values: ["Variable shift sequence from keyword", "26^KeyLength combinations", "Yes (via complement word)", "Zero (Solved using Kasiski examinations)"] }
      ]}
    />

    <!-- Section: Example Card -->
    <ExampleCard
      title="ROT13 Encoding Examples"
      description="Observe standard word translations:"
      examples={[
        { label: "Symmetric check (hello)", input: "hello", output: "uryyb", badge: "Encode" },
        { label: "Symmetric check (uryyb)", input: "uryyb", output: "hello", badge: "Decode (Identical function)" }
      ]}
    />

    <!-- Programming Implementation Guides -->
    <LanguageSupport
      languages={languageCodes}
      title="Programmatic Substitution Ciphers"
      description="Implement ROT13 letter rotation in your code scripts using these standard templates:"
    />

    <!-- Common Mistakes -->
    <CommonMistakes
      mistakes={mistakesList}
      title="Common Classical Cryptography Pitfalls"
      description="Avoid these common security oversights when studying cipher history:"
    />

    <!-- Best Practices -->
    <BestPractices
      title="Classical Cryptography Best Practices"
      practices={[
        { title: "Use for Obfuscation Only", description: "Use ROT13 solely to hide game answers or spoilers from casual readers, never to secure passwords." },
        { title: "Understand Frequency Curves", description: "Examine letter frequency graphs to see how simple shifts leave character peaks and valleys intact, making them easy to solve." }
      ]}
    />

    <!-- Official References -->
    <OfficialReferences
      references={references}
    />
  </div>
</ToolPageLayout>
