---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
import { UuidGenerator } from '../../components/UuidGenerator';
import ComparisonTable from '../../components/content/ComparisonTable.astro';
import BestPractices from '../../components/content/BestPractices.astro';
import CommonMistakes from '../../components/content/CommonMistakes.astro';
import LanguageSupport from '../../components/content/LanguageSupport.astro';
import PrivacyBadge from '../../components/content/PrivacyBadge.astro';
import OfficialReferences from '../../components/content/OfficialReferences.astro';
import RelatedTools from '../../components/content/RelatedTools.astro';

const faqs = [
  {
    question: "What makes a password secure?",
    answer: "A secure password has high entropy, meaning it is long and completely random. It should be at least 12-16 characters and combine uppercase letters, lowercase letters, numbers, and special symbols. This prevents brute-force guessing attacks."
  },
  {
    question: "Is this password generator secure?",
    answer: "Yes. All passwords are generated client-side using the browser's native Web Cryptography API (CSPRNG). No parameters or generated passwords are ever sent to a server. They remain strictly in your local device memory."
  },
  {
    question: "How long should a strong password be?",
    answer: "Security experts recommend a minimum length of 12 characters for standard accounts, and 16 or more characters for sensitive accounts (such as administrative logons or email accounts)."
  },
  {
    question: "Why should I exclude ambiguous characters from passwords?",
    answer: "Ambiguous characters like <code>1</code> (one), <code>l</code> (lowercase L), <code>I</code> (uppercase i), <code>0</code> (zero), and <code>O</code> (uppercase o) look identical in many fonts. Excluding them prevents manual typing mistakes."
  },
  {
    question: "What are the rules of password entropy?",
    answer: "Password entropy represents the complexity or unpredictability of a password, measured in bits. A password with 80 bits or more of entropy is considered highly secure against modern computing attacks."
  },
  {
    question: "How is a CSPRNG different from Math.random()?",
    answer: "Math.random() is predictable and unsafe for security keys. A Cryptographically Secure Pseudo-Random Number Generator (CSPRNG) accesses hardware entropy sources to make predictions impossible."
  },
  {
    question: "Can I use special symbols in my passwords?",
    answer: "Yes, our generator allows you to toggle symbols (like <code>! @ # $ % ^ & *</code>) on or off depending on the website's password configuration rules."
  },
  {
    question: "What is a pass-phrase?",
    answer: "A passphrase is a sequence of random words (e.g. <code>correct-horse-battery-staple</code>). Passphrases are often longer than traditional passwords but are easier to memorize."
  },
  {
    question: "Why should I use a password manager?",
    answer: "Because strong passwords must be unique for every site and are too complex to memorize, a password manager stores your credentials securely in an encrypted vault."
  },
  {
    question: "How often should I change my password?",
    answer: "Historically, sites forced changes every 90 days. Modern guidelines suggest keeping the same strong password unless a security breach or leakage occurs."
  },
  {
    question: "Can this tool generate database seed passwords?",
    answer: "Yes. You can generate multiple passwords in a single batch to seed database mock user tables or temporary connection strings."
  },
  {
    question: "What is Shannon Entropy?",
    answer: "Shannon Entropy measures information density. It is displayed for each generated password block to verify the cryptographic strength of the characters."
  },
  {
    question: "How is a random password generated in Python?",
    answer: "In Python, use the secrets module: <code>import secrets, string; alphabet = string.ascii_letters + string.digits + string.punctuation; pwd = ''.join(secrets.choice(alphabet) for i in range(16))</code>."
  },
  {
    question: "How is a secure password generated in Go?",
    answer: "In Go, use the <code>crypto/rand</code> package to generate secure bytes and map them to alphanumeric characters."
  },
  {
    question: "Is it safe to write down my master password?",
    answer: "Yes, if kept in a locked drawer or physical vault. A physical copy is safe from cyberattacks, but vulnerable to physical loss."
  },
  {
    question: "Why should I avoid using dictionary words?",
    answer: "Dictionary words are easily cracked using dictionary attacks, which scan lists of known words and common letter-to-symbol substitutions (like <code>a -> @</code>)."
  },
  {
    question: "Does this tool work on mobile devices?",
    answer: "Yes, the interface is fully responsive and allows you to generate and copy passwords on mobile web browsers."
  },
  {
    question: "Can I run this password generator offline?",
    answer: "Yes. The entire code runs within your local browser thread without requiring an internet connection."
  },
  {
    question: "What is brute-force cracking?",
    answer: "A brute-force attack is an automated trial-and-error method where a program tests trillions of character combinations per second to guess passwords."
  },
  {
    question: "Are password generation configurations customizable?",
    answer: "Yes, you can configure password length, lower/uppercase inclusions, digit inclusions, and specific symbols."
  },
  {
    question: "What is the IETF recommendation for passwords?",
    answer: "The IETF recommends long, random, machine-generated passwords that are managed using secure vaults."
  }
];

const headers = ["Password Length", "Characters Included", "Entropy Rating", "Brute-Force Complexity"];
const rows = [
  {
    label: "8 Characters",
    values: ["Alphanumeric", "~45 bits", "Weak (Can be cracked in hours/days)"]
  },
  {
    label: "12 Characters",
    values: ["Alphanumeric + Symbols", "~78 bits", "Strong (Takes years to crack)"]
  },
  {
    label: "16 Characters",
    values: ["Alphanumeric + Symbols", "~104 bits", "Extremely Strong (Practically uncrackable)"]
  }
];

const practices = [
  {
    title: "Never Reuse Passwords",
    description: "Always use a distinct, random password for every service to prevent credential stuffing if one site is breached."
  },
  {
    title: "Enable Multi-Factor Authentication",
    description: "Combine secure passwords with MFA (like authenticator apps or security keys) for complete security."
  }
];

const mistakes = [
  {
    title: "Using predictable patterns",
    description: "Using common prefix/suffixes (like 'Password123!') makes passwords easy targets for dictionary scanners.",
    fix: "Use purely random generated character blocks."
  }
];

const languages = [
  {
    lang: "Python (secrets)",
    code: `
import secrets
import string

def generate_pwd(length=16):
    alphabet = string.ascii_letters + string.digits + string.punctuation
    return ''.join(secrets.choice(alphabet) for _ in range(length))

print(generate_pwd())
    `
  },
  {
    lang: "Node.js (crypto)",
    code: `
const crypto = require('crypto');

function generateSecurePassword(length = 16) {
  return crypto.randomBytes(length)
    .toString('base64')
    .slice(0, length);
}
console.log(generateSecurePassword());
    `
  }
];

const references = [
  { title: "NIST Guidelines on Password Complexity", url: "https://www.nist.gov/" }
];
---

<ToolPageLayout
  title="Secure Password Generator Online: Generate Cryptographically Safe Passwords"
  description="Generate secure, strong, and randomized passwords locally. Customize password lengths, character filters, and symbols with 100% offline security."
  keywords="secure password generator, strong password generator, random password generator, password creator, generate password online, offline password tool"
  toolTitle="Secure Password Generator"
  toolDescription="Generate strong, high-entropy passwords client-side using the browser Web Cryptography API. Configurable character classes and zero server logs."
  faqs={faqs}
>
  <UuidGenerator client:load defaultGenType="password" />

  <div slot="seo-content" class="flex flex-col gap-12 mt-10 max-w-4xl mx-auto w-full">
    <PrivacyBadge />

    <ComparisonTable 
      headers={headers} 
      rows={rows} 
      title="Password Complexity Ratings" 
      description="Compare entropy levels and resistance parameters across standard password configuration lengths:"
    />

    <BestPractices 
      practices={practices} 
      title="Secure Password Best Practices" 
    />

    <CommonMistakes 
      mistakes={mistakes} 
      title="Common Password Security Pitfalls" 
    />

    <LanguageSupport 
      languages={languages} 
      title="Programmatic Password Generators" 
    />

    <OfficialReferences 
      references={references} 
    />

    <RelatedTools />
  </div>
</ToolPageLayout>
