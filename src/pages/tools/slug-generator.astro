---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
import { SlugGenerator } from '../../components/SlugGenerator';
import ComparisonTable from '../../components/content/ComparisonTable.astro';
import BestPractices from '../../components/content/BestPractices.astro';
import CommonMistakes from '../../components/content/CommonMistakes.astro';
import OfficialReferences from '../../components/content/OfficialReferences.astro';
import LanguageSupport from '../../components/content/LanguageSupport.astro';
import ExampleCard from '../../components/content/ExampleCard.astro';

const faqs = [
  {
    question: "What is a URL slug?",
    answer: "A URL slug is the specific part of a web address that identifies a particular page on a website in an easy-to-read format. It is typically the last section of the URL path (for example, in <code>https://useutils.com/tools/slug-generator</code>, the slug is <code>slug-generator</code>) and is generated directly from the page's title."
  },
  {
    question: "Why are URL slugs important for SEO?",
    answer: "URL slugs are vital for Search Engine Optimization (SEO) for two primary reasons. First, search engines like Google read the words in the slug to determine the topic and relevance of a page. Second, clean, descriptive slugs increase the click-through rate (CTR) in search results and social media shares because users instantly understand what content to expect."
  },
  {
    question: "What characters are allowed in an SEO-safe URL slug?",
    answer: "An SEO-safe URL slug should strictly contain lowercase alphanumeric characters (a-z, 0-9) and hyphens (-) as word separators. You should avoid uppercase letters, spaces, underscores, and special characters (like ?, &amp;, @, %, +, =) as they can cause encoding issues, look spammy, or confuse search engine crawlers."
  },
  {
    question: "How do you create an SEO-friendly URL slug?",
    answer: "To create an SEO-friendly slug: 1) Keep it short (3-5 words), 2) include your primary target keyword, 3) remove stop words like 'and', 'the', 'in', or 'with', 4) convert all letters to lowercase, 5) replace spaces with hyphens, and 6) strip out all punctuation and special symbols."
  },
  {
    question: "What are 'stop words' and should they be removed from slugs?",
    answer: "Stop words are high-frequency short words like 'a', 'an', 'the', 'and', 'but', 'in', 'on', 'at', 'to', 'for', 'of', and 'with'. Removing them from your slugs is a standard SEO best practice because it makes the URL shorter, cleaner, and focuses search engines on your actual descriptive target keywords."
  },
  {
    question: "How does multilingual transliteration benefit my URL structure?",
    answer: "Many CMS engines and older web browsers have trouble parsing non-Latin characters (like Cyrillic, Greek, or Arabic) or accented letters (like é, ü, ç, ñ) in URL paths, often percent-encoding them into long, unreadable strings (e.g., <code>%D0%BF%D1%80%D0%B8%D0%B2%D0%B5%D1%82</code>). Transliterating these characters into standard Latin equivalents (e.g., 'privet') makes URLs highly readable for both users and crawlers globally."
  },
  {
    question: "What is the difference between hyphens (-) and underscores (_) in URL slugs?",
    answer: "Google's search crawlers explicitly treat hyphens (-) as word separators, whereas they treat underscores (_) as word joiners. Therefore, using hyphens (e.g., <code>seo-best-practices</code>) tells search engines that there are three separate words, while underscores (e.g., <code>seo_best_practices</code>) treat it as a single concatenated phrase, which is suboptimal for search ranking."
  },
  {
    question: "What unique suffix options should I append to slugs?",
    answer: "When building applications, you may encounter duplicate titles that would result in identical slugs (e.g. two articles titled 'Hello World'). To maintain database uniqueness, you can append a unique suffix like a short random ID (e.g., <code>-4x2a</code>), a sequential counter (e.g., <code>-2</code>), or a Unix epoch timestamp. This prevents collision errors without sacrificing slug readability."
  },
  {
    question: "How does the 'smart truncation' word-boundary option work?",
    answer: "When you set a maximum character limit on a slug (e.g., 50 characters), simple truncation might cut a word in half (e.g., <code>how-to-write-a-blog-po</code>). Enabling the 'preserve whole words' option ensures the generator slices the text at the last full word boundary under the character limit, resulting in a clean, professional output (e.g., <code>how-to-write-a-blog</code>)."
  },
  {
    question: "Is my data safe when using this online slug generator?",
    answer: "Absolutely. Like all tools on useUtils, our URL Slug Generator processes your input text completely inside your browser's local sandbox using JavaScript. No text, slugs, names, or settings are ever uploaded to, processed by, or stored on a server, ensuring 100% privacy and security for your draft titles and codebases."
  },
  {
    question: "Should slugs contain uppercase letters?",
    answer: "No. Capital letters in URLs can cause duplicate content issues on web servers (e.g. Apache or IIS might treat <code>/page</code> and <code>/Page</code> as different, or fold them). Standard practice is to force all characters to lowercase."
  },
  {
    question: "How does Google index spaces in URLs?",
    answer: "Spaces in URLs are percent-encoded to <code>%20</code>. This looks unreadable and spammy in search browser displays. Converting spaces to hyphens (<code>-</code>) ensures the URL remains descriptive and clean."
  },
  {
    question: "What is a slug vs a permalink?",
    answer: "A slug is only the specific page identifier segment (e.g., <code>slug-generator</code>). A permalink is the complete, permanent URL containing the domain, subfolders, and slug (e.g., <code>https://useutils.com/tools/slug-generator</code>)."
  },
  {
    question: "What is a slug vs a filename?",
    answer: "A slug points to a virtual database-driven route on a website (handled by dynamic routers). A filename refers to a literal file residing on a web server file system (e.g. <code>index.html</code> or <code>image.jpg</code>)."
  },
  {
    question: "What is the maximum slug length for SEO?",
    answer: "Google handles URLs up to 2,000 characters. However, for SEO readability, keep slugs short, typically between 3 and 5 words (under 60 characters)."
  },
  {
    question: "How to convert text to slugs in JavaScript?",
    answer: "You can convert text to slugs using a regular expression: <code>const slugify = str => str.toLowerCase().replace(/[^a-z0-9\\s-]/g, '').replace(/\\s+/g, '-').trim();</code>."
  },
  {
    question: "How to slugify text in Python?",
    answer: "In Python, you can use the <code>python-slugify</code> library or write a custom regex: <code>import re; slug = re.sub(r'[^a-z0-9\\s-]', '', text.lower()).strip().replace(' ', '-')</code>."
  },
  {
    question: "Why does WordPress automatically strip special characters from slugs?",
    answer: "WordPress sanitizes slugs to prevent security exploits (like SQL Injection or XSS via URL variables) and to guarantee compatibility across all hosting web server specifications."
  },
  {
    question: "How do I prevent duplicate slug issues in databases?",
    answer: "Search database records before inserting new rows. If the slug exists, append an incremental index (e.g. <code>-1</code>, <code>-2</code>) or a unique random hash suffix."
  },
  {
    question: "Does this tool support bulk slugification?",
    answer: "Yes. Toggle 'Bulk Mode' under settings, paste your list of titles, and view or download the complete converted list as a CSV or JSON payload."
  }
];

const references = [
  { title: "RFC 3986 - Uniform Resource Identifier (URI): Generic Syntax", url: "https://datatracker.ietf.org/doc/html/rfc3986", source: "IETF Standards" },
  { title: "Google Search Central - Keep URL Structures Simple", url: "https://developers.google.com/search/docs/crawling-indexing/url-structure", source: "Google SEO Guidelines" }
];

const languageCodes = [
  {
    lang: "JavaScript",
    code: `const slugify = text => {
  return text
    .toString()
    .toLowerCase()
    .trim()
    .replace(/\\s+/g, '-')           // Replace spaces with -
    .replace(/[^\\w\\-]+/g, '')       // Remove all non-word chars (except -)
    .replace(/\\-\\-+/g, '-')         // Replace multiple - with single -
    .replace(/^-+/, '')              // Trim - from start
    .replace(/-+$/, '');             // Trim - from end
};

console.log(slugify("Hello World! useUtils API")); // "hello-world-useutils-api"`,
    note: "Safe URL-compliant regex slugifier."
  },
  {
    lang: "Python",
    code: `import re
import unicodedata

def slugify(value):
    # Normalize unicode accents
    value = unicodedata.normalize('NFKD', value).encode('ascii', 'ignore').decode('ascii')
    value = re.sub(r'[^\\w\\s-]', '', value).strip().lower()
    return re.sub(r'[-\\s]+', '-', value)

print(slugify("Hello World! useUtils API")) # "hello-world-useutils-api"`,
    note: "PEP 8 compliant, handles Unicode normalization (e.g. converting é to e)."
  }
];

const mistakesList = [
  {
    title: "Using Underscores instead of Hyphens",
    description: "Search engine crawlers do not index underscores as word breaks. Utilizing my_article_slug forces Google to index it as a single word, breaking search visibility.",
    fix: "Always replace spaces and underscores with hyphens: <code>replace(/_/g, '-')</code>."
  },
  {
    title: "Percent-Encoding Accented Characters in Slugs",
    description: "Failing to transliterate non-Latin accents (like ö, é, or Cyrillic characters) turns slugs into unreadable code paths (e.g., %C3%B6).",
    fix: "Apply Unicode normalization or transliterate characters into standard Latin equivalents before generating the slug."
  }
];
---

<ToolPageLayout
  title="URL Slug Generator & Text Sanitizer: SEO-Friendly URL Creator"
  description="Generate clean, SEO-optimized URL slugs in real-time. Features multilingual transliteration (Cyrillic, accents, German Umlauts), stop words removal, custom replaces, bulk mode, and unique suffixes."
  keywords="slug generator, url slug generator, slugify, url creator, seo slug, clean url, text sanitizer, text to slug, online slugify, batch slug generator"
  toolTitle="URL Slug Generator & Sanitizer"
  toolDescription="Convert text, article headings, or lists of strings into clean, SEO-friendly, and URL-safe slugs instantly. Supports multilingual transliteration, stop-word filtering, bulk mode, and random suffix appending. Processed 100% locally."
  faqs={faqs}
>
  <SlugGenerator client:load />

  <div slot="seo-content" class="flex flex-col gap-8 font-sans text-sm text-zinc-400">
    <!-- Section: Intro -->
    <div>
      <h2 class="text-xl font-semibold text-zinc-50 tracking-tight mb-4 flex items-center gap-2">
        <span class="w-1.5 h-6 bg-accent-emerald rounded-full"></span>
        How to Use the URL Slug Generator
      </h2>
      <p class="leading-relaxed mb-4">
        Our slug generator parses strings instantly in your browser to adapt them to clean web routing conventions. You can paste or type titles in the <strong class="text-zinc-200">raw input pane</strong>, toggle configurations like stop words stripping or transliterations, and watch the output update in real-time on the right.
      </p>
      <p class="leading-relaxed">
        Click the copy buttons or use developer keyboard shortcuts (<kbd class="font-mono bg-zinc-800 px-1 py-0.5 rounded border border-zinc-700 text-[10px] text-zinc-400">⌘ C</kbd>) to copy the converted slug or the full mockup URL to your clipboard.
      </p>
    </div>

    <!-- Section: Cross Links -->
    <div class="flex flex-col gap-4">
      <h2 class="text-xl font-semibold text-zinc-50 tracking-tight flex items-center gap-2">
        <span class="w-1.5 h-6 bg-accent-emerald rounded-full"></span>
        Other URL & String Utilities
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
        <a href="/tools/url-slug-generator" class="p-3 bg-zinc-900/30 border border-border-hairline rounded-lg hover:border-accent-emerald/30 text-xs font-mono text-zinc-200 hover:text-accent-emerald transition-all">URL Slug Generator</a>
        <a href="/tools/case-converter" class="p-3 bg-zinc-900/30 border border-border-hairline rounded-lg hover:border-accent-emerald/30 text-xs font-mono text-zinc-200 hover:text-accent-emerald transition-all">Case Converter</a>
        <a href="/tools/url-encoder" class="p-3 bg-zinc-900/30 border border-border-hairline rounded-lg hover:border-accent-emerald/30 text-xs font-mono text-zinc-200 hover:text-accent-emerald transition-all">URL Encoder</a>
      </div>
    </div>

    <!-- Section: URL Safe Reference -->
    <ComparisonTable
      title="URL Character Classification Rules"
      description="Not all characters are safe to use in URL paths. According to RFC 3986, characters are classified into reserved, unreserved, and unsafe characters:"
      headers={["Character Class", "Examples", "URL Status", "Generator Action"]}
      rows={[
        { label: "Unreserved Characters", values: ["<code>a-z</code>, <code>A-Z</code>, <code>0-9</code>, <code>-</code>, <code>_</code>, <code>.</code>, <code>~</code>", "100% Safe", "Preserved (and lowercase applied)"] },
        { label: "Reserved Characters", values: ["<code>?</code>, <code>&amp;</code>, <code>#</code>, <code>/</code>, <code>:</code>, <code>@</code>, <code>+</code>, <code>=</code>", "Requires Encoding", "Stripped, or expanded (e.g. &amp; → and, @ → at)"] },
        { label: "Whitespace &amp; Accents", values: ["Spaces, tabs, <code>é</code>, <code>ö</code>, <code>ç</code>, <code>й</code>", "Unsafe / Percent-encoded", "Replaced with separator, or transliterated"] },
        { label: "Control Characters", values: ["Newlines, backspaces, binary bytes", "Illegal in URLs", "Always stripped completely"] }
      ]}
    />

    <!-- Section: Example Card -->
    <ExampleCard
      title="URL Slug Conversion Examples"
      description="Compare title strings and their converted URL-safe slug formats:"
      examples={[
        { label: "SEO Article Heading", input: "How to Build a React App in 2026!", output: "how-to-build-a-react-app-in-2026", badge: "Slugify" },
        { label: "Accented Multilingual Title", input: "Café und Frédéric en Montréal", output: "cafe-und-frederic-en-montreal", badge: "Transliterated" },
        { label: "Config Path Node", input: "database://user:pass@localhost:5432/db", output: "database-user-pass-localhost-5432-db", badge: "Sanitized" }
      ]}
    />

    <!-- Programming Implementation Guides -->
    <LanguageSupport
      languages={languageCodes}
      title="Programmatic Slug Generation Snippets"
      description="Sanitize paths and titles dynamically inside your custom scripts:"
    />

    <!-- Common Mistakes -->
    <CommonMistakes
      mistakes={mistakesList}
      title="Common Slug Generation Pitfalls"
      description="Avoid these common errors when transforming variables and URL paths:"
    />

    <!-- Best Practices -->
    <BestPractices
      title="URL Slug Best Practices"
      practices={[
        { title: "Use Hyphens for SEO", description: "Enforce hyphens as separators, as Google treats underscores as joiners rather than word boundaries." },
        { title: "Strip Minor Stop Words", description: "Remove conjunctions ('and', 'the', 'in') to keep URL paths short and highlight core keywords." },
        { title: "Prevent Suffix Collision", description: "Append short random indices or ID hashes to prevent duplicate database route collisions." }
      ]}
    />

    <!-- Official References -->
    <OfficialReferences
      references={references}
    />
  </div>
</ToolPageLayout>
