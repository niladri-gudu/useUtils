---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
import { GlassmorphismGenerator } from '../../components/GlassmorphismGenerator';
import BestPractices from '../../components/content/BestPractices.astro';
import CommonMistakes from '../../components/content/CommonMistakes.astro';
import OfficialReferences from '../../components/content/OfficialReferences.astro';
import LanguageSupport from '../../components/content/LanguageSupport.astro';
import ComparisonTable from '../../components/content/ComparisonTable.astro';
import ExampleCard from '../../components/content/ExampleCard.astro';
import PrivacyBadge from '../../components/content/PrivacyBadge.astro';
import RelatedTools from '../../components/content/RelatedTools.astro';

const faqs = [
  {
    question: "What is Tailwind Glassmorphism?",
    answer: "Tailwind Glassmorphism is a UI design style that uses Tailwind CSS utility classes to create a semi-transparent, frosted-glass effect with backdrop blur, borders, and shadow layers."
  },
  {
    question: "How do I create a glassmorphism effect in Tailwind?",
    answer: "Combine backdrop blur, background opacity, and border utilities, such as: `bg-white/10 backdrop-blur-md border border-white/20 shadow-lg`."
  },
  {
    question: "Does Tailwind v4 support backdrop blur?",
    answer: "Yes, Tailwind v4 fully supports standard backdrop blur classes like `backdrop-blur-sm`, `backdrop-blur-md`, and `backdrop-blur-lg`."
  },
  {
    question: "How do I configure custom backdrop blur filters in Tailwind?",
    answer: "You can specify custom filter properties using arbitrary bracket values, for example: `backdrop-filter-[blur(16px)]`."
  },
  {
    question: "How do I add a light border reflection in Tailwind?",
    answer: "Use semi-transparent border colors, such as `border-white/20` or `border-white/10`, to define card borders."
  },
  {
    question: "Is backdrop blur supported by all browsers?",
    answer: "Yes. Backdrop blur is supported by all modern browsers. Legacy Safari requires the `-webkit-backdrop-filter` prefix, which Tailwind handles automatically in its build step."
  },
  {
    question: "What is the Tailwind utility class for backdrop blur?",
    answer: "Use classes from the `backdrop-blur` family (e.g. `backdrop-blur-md` for a medium blur effect)."
  },
  {
    question: "Can I use glassmorphism with dark mode in Tailwind?",
    answer: "Yes. Use dark-tinted backgrounds for dark mode styling (e.g. `bg-zinc-950/20 dark:bg-zinc-950/40 backdrop-blur-md border border-zinc-800/30`)."
  },
  {
    question: "Why does my glassmorphism card look flat?",
    answer: "Ensure your card has a shadow utility class (like `shadow-xl`) and is positioned over a colorful background, as the blur effect needs background coordinates to render correctly."
  },
  {
    question: "Does this glassmorphism tool run client-side?",
    answer: "Yes, all processing is performed locally in your web browser, ensuring complete privacy."
  },
  {
    question: "How does screen resolution affect backdrop blur?",
    answer: "Backdrop blur is rendered dynamically by the browser's graphics engine, meaning it scales smoothly to high-density screens."
  },
  {
    question: "How do I build a glassmorphic navbar in Tailwind?",
    answer: "Apply fixed positioning combined with blur: `fixed top-0 left-0 right-0 z-50 bg-zinc-950/40 backdrop-blur-md border-b border-white/10`."
  },
  {
    question: "Are custom backdrop blurs supported in Tailwind v4?",
    answer: "Yes, Tailwind v4 fully supports arbitrary color variables and theme properties."
  },
  {
    question: "Can I animate glassmorphic elements in Tailwind?",
    answer: "Yes. You can transition opacity or border values using classes like `transition-all` combined with custom hover or focus triggers."
  },
  {
    question: "What are the accessibility guidelines for glassmorphism?",
    answer: "Ensure text placed on semi-transparent backgrounds maintains a contrast ratio of at least 4.5:1 against the background."
  },
  {
    question: "Does transparency affect color contrast?",
    answer: "Yes. Semi-transparent colors blend with the background beneath them, meaning contrast calculations must evaluate the final flattened color values."
  },
  {
    question: "How can I extract color palettes from an image?",
    answer: "Drag and drop any image into our sandbox to sample dominant colors and map them to gradient stops."
  },
  {
    question: "Why do colors look different in print?",
    answer: "Screens emit RGB light, whereas print ink absorbs CMYK light. This difference in color models results in varying color ranges."
  },
  {
    question: "Is there a performance cost to using backdrop blur?",
    answer: "Backdrop blur is GPU-accelerated in modern browsers. However, using many nested blurred panels can slow down rendering on older devices."
  },
  {
    question: "What is the relative luminance threshold?",
    answer: "Luminance calculations evaluate screen brightness levels. Comparing text luminance against background luminance gives the contrast ratio."
  }
];

const languageCodes = [
  {
    lang: "HTML & Tailwind",
    code: `
<!-- Frosted Glass Card -->
<div class="bg-white/10 backdrop-blur-md border border-white/20 shadow-xl p-6 rounded-2xl max-w-sm text-zinc-100">
  <h3 class="text-lg font-bold">Glassmorphism Card</h3>
  <p class="text-sm opacity-80 mt-1">Responsive frosted glass UI component.</p>
</div>
    `,
    note: "Modern CSS declarations using standard gradient functions."
  },
  {
    lang: "Tailwind v4 Config",
    code: `
@theme {
  --background-color-glass-surface: rgba(255, 255, 255, 0.1);
  --border-color-glass-border: rgba(255, 255, 255, 0.2);
}
    `,
    note: "CSS theme variable configuration format."
  }
];

const mistakesList = [
  {
    title: "Omiting Backdrop Blur",
    description: "Setting background opacity without applying a `backdrop-blur` utility class, which creates simple transparent panels instead of a frosted glass effect."
  },
  {
    title: "Flat Monochromatic Backgrounds",
    description: "Placing glassmorphic cards over flat, solid backgrounds. The frosted effect relies on colorful or textured background elements underneath."
  },
  {
    title: "Harsh Solid Borders",
    description: "Using solid, opaque borders (like `border-white`) on transparent cards, which ruins the glass transition effect."
  }
];

const references = [
  {
    title: "Tailwind CSS v4 Documentation",
    url: "https://tailwindcss.com/"
  },
  {
    title: "MDN Web Docs: backdrop-filter property",
    url: "https://developer.mozilla.org/en-US/docs/Web/CSS/backdrop-filter"
  }
];
---

<ToolPageLayout
  title="Tailwind Glassmorphism Generator | Visual Frosted Glass Designer"
  description="Generate custom Tailwind CSS glassmorphism styles visually. Configure backdrop blur, background transparency, and border reflections."
  keywords="tailwind glassmorphism, glassmorphism generator, backdrop blur tailwind, tailwind css frosted glass, visual css utility designer"
  toolTitle="Tailwind Glassmorphism"
  toolDescription="Design custom glassmorphism components. Configure backdrop blur, background transparency, and border reflections, and copy Tailwind class utilities."
  faqs={faqs}
>
  <GlassmorphismGenerator defaultActiveTab="card" client:load />

  <div slot="seo-content" class="flex flex-col gap-8 font-sans text-sm text-zinc-400">
    <PrivacyBadge />

    <div>
      <h2 class="text-xl font-semibold text-zinc-50 tracking-tight mb-4 flex items-center gap-2">
        <span class="w-1.5 h-6 bg-accent-emerald rounded-full"></span>
        Styling Glassmorphic Layouts in Tailwind
      </h2>
      <p class="leading-relaxed mb-3">
        Glassmorphism uses semi-transparent surfaces with backdrop blur filters to create depth and focus in modern layouts.
      </p>
      <p class="leading-relaxed">
        Our Tailwind Glassmorphism Generator provides an interactive timeline to adjust color coordinates, customize transparency levels, and copy responsive class utilities.
      </p>
    </div>

    <ComparisonTable
      title="Tailwind Glassmorphic Components"
      description="Compare different styling presets:"
      headers={["Preset Category", "Tailwind Class Example", "Visual Effect", "Best Application"]}
      rows={[
        { label: "Frosted Glass", values: ["bg-white/10 backdrop-blur-md border-white/20", "Smooth white tint with blur", "Premium dashboard elements"] },
        { label: "Dark Glass", values: ["bg-zinc-950/20 backdrop-blur-lg border-zinc-800/30", "Deep gray tint with blur", "Modern media control widgets"] },
        { label: "Vibrant Color Glass", values: ["bg-emerald-500/10 backdrop-blur-sm border-emerald-400/20", "Colored tint with blur", "Active system badges"] }
      ]}
    />

    <ExampleCard
      title="Popular Glassmorphism Presets"
      description="Frequently used design coordinates:"
      examples={[
        { label: "Standard Frosted", input: "bg-white/10 backdrop-blur-md border-white/20", output: "Copied!", badge: "Tailwind" },
        { label: "Dark Ambience", input: "bg-zinc-950/20 backdrop-blur-lg border-zinc-800/30", output: "Copied!", badge: "Tailwind" },
        { label: "Active Glow", input: "bg-emerald-500/10 backdrop-blur-sm border-emerald-400/20", output: "Copied!", badge: "Tailwind" }
      ]}
    />

    <LanguageSupport
      languages={languageCodes}
      title="Tailwind Integration Snippets"
      description="Apply these styles in your markup code:"
    />

    <CommonMistakes
      mistakes={mistakesList}
      title="Common Glassmorphic Pitfalls"
    />

    <BestPractices
      title="Glassmorphism Best Practices"
      practices={[
        { title: "Optimize Focus States", description: "Ensure interactive focus states stand out clearly against semi-transparent backgrounds." },
        { title: "Define a Theme Property", description: "Save repeating custom glassmorphism styles as theme variables in your config to maintain stylesheet consistency." }
      ]}
    />

    <OfficialReferences
      references={references}
    />

    <RelatedTools
      currentToolUrl="/tools/tailwind-glassmorphism"
      category="css"
    />
  </div>
</ToolPageLayout>
