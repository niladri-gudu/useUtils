---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
import { TailwindPicker } from '../../components/TailwindPicker';
import BestPractices from '../../components/content/BestPractices.astro';
import CommonMistakes from '../../components/content/CommonMistakes.astro';
import OfficialReferences from '../../components/content/OfficialReferences.astro';
import LanguageSupport from '../../components/content/LanguageSupport.astro';
import ComparisonTable from '../../components/content/ComparisonTable.astro';
import ExampleCard from '../../components/content/ExampleCard.astro';
import PrivacyBadge from '../../components/content/PrivacyBadge.astro';
import RelatedTools from '../../components/content/RelatedTools.astro';

const faqs = [
  {
    question: "How do I apply opacity to Tailwind colors?",
    answer: "You can apply opacity to Tailwind color utilities (backgrounds, texts, borders, etc.) using the slash notation. For example, `bg-slate-500/20` applies the `bg-slate-500` color at 20% opacity. This syntax was introduced in Tailwind CSS v3 and replaces the older, separate opacity classes."
  },
  {
    question: "What are the standard Tailwind CSS color families?",
    answer: "Tailwind CSS includes 22 default color families: slate, gray, zinc, neutral, stone, red, orange, amber, yellow, lime, green, emerald, teal, cyan, sky, blue, indigo, violet, purple, fuchsia, pink, and rose. Each family consists of 11 shades ranging from 50 (lightest) to 950 (darkest)."
  },
  {
    question: "How does Tailwind CSS v4 define colors?",
    answer: "Tailwind CSS v4 defines its default color system using CSS Custom Properties (variables) in the <strong>OKLCH</strong> color space (e.g., `--color-slate-500: oklch(0.551 0.027 264.385)`). OKLCH provides perceptually uniform brightness and access to modern wide-gamut monitors, though classic hex mappings remain highly accurate fallback references."
  },
  {
    question: "How does the reverse color matcher work?",
    answer: "The reverse color matcher takes any parsed HEX, RGB, or HSL color input and computes the Euclidean distance between that color's RGB coordinates and the coordinates of all standard Tailwind shades. The shade with the smallest distance is identified as the closest match."
  },
  {
    question: "Does Tailwind CSS support arbitrary opacity values?",
    answer: "Yes, you can use arbitrary opacity values by placing the value inside square brackets, such as `bg-red-500/[0.17]` (for 17% opacity) or `text-blue-600/[82%]` (for 82% opacity)."
  },
  {
    question: "What is the difference between Slate, Gray, Zinc, Neutral, and Stone?",
    answer: "These represent Tailwind's neutral color scales. <strong>Slate</strong> is a cool gray with blue tones; <strong>Gray</strong> is a neutral gray with subtle cool tones; <strong>Zinc</strong> is a clean, modern gray; <strong>Neutral</strong> is a pure, balanced gray; and <strong>Stone</strong> is a warm gray with earthy/brown undertones."
  },
  {
    question: "Does background opacity affect text inside the container?",
    answer: "No. The slash notation (e.g., `bg-emerald-500/40`) generates an RGBA background color with an alpha channel. Unlike applying the CSS `opacity` property to a container, which makes the entire container and all its children transparent, Tailwind's alpha modifier only targets the background color itself, leaving child text fully opaque."
  },
  {
    question: "What prefixes are supported by standard Tailwind colors?",
    answer: "Tailwind CSS supports color classes for several utilities: `bg-` (background), `text-` (text color), `border-` (border color), `decoration-` (text decoration color), `ring-` (focus ring color), `outline-` (outline color), and gradient anchors like `from-`, `via-`, and `to-`."
  },
  {
    question: "How can I copy color codes and classes quickly?",
    answer: "Our picker offers quick-copy buttons for every shade. You can also use keyboard shortcuts: select a shade in the list using the Up/Down arrow keys, then press `C` to copy the Tailwind class, `X` to copy the HEX code, or `R` to copy the RGBA value."
  },
  {
    question: "Is my color input processed securely?",
    answer: "Yes. Like all utilities on useUtils, the Tailwind Opacity/Color Picker runs 100% on the client side in your web browser. No color codes, image samples, or inputs are transmitted to our servers."
  },
  {
    question: "What is sRGB color gamut?",
    answer: "sRGB is the standard color range used on the web. It has a narrower range than newer gamuts like Display P3 or Rec. 2020."
  },
  {
    question: "How does relative luminance determine WCAG rating?",
    answer: "Luminance calculations evaluate screen brightness levels. Comparing text luminance against background luminance gives the contrast ratio."
  },
  {
    question: "Does this page feature an interactive contrast check?",
    answer: "Yes. The page evaluates contrast ratios against white and black backgrounds in real-time."
  },
  {
    question: "What are complementary colors?",
    answer: "Complementary colors are opposite each other on the color wheel. You can find a color's complement by adding or subtracting 180 degrees from its Hue."
  },
  {
    question: "What are analogous colors?",
    answer: "Analogous colors sit next to each other on the color wheel, typically spaced +/- 30° apart."
  },
  {
    question: "Does this page feature an interactive preview canvas?",
    answer: "Yes. Click elements in the sandbox panel to paint them with your active color selection."
  },
  {
    question: "Why do colors look different in print?",
    answer: "Screens emit RGB light, whereas print ink absorbs CMYK light. This difference in color models results in varying color ranges."
  },
  {
    question: "What is the CMYK model?",
    answer: "CMYK stands for Cyan, Magenta, Yellow, and Key (Black). It is the standard color model used in color printing."
  },
  {
    question: "What is the Euclidean color distance formula?",
    answer: "The color difference distance is calculated as: `sqrt((R1-R2)^2 + (G1-G2)^2 + (B1-B2)^2)`. A lower distance value indicates a closer visual match."
  },
  {
    question: "Is there a performance cost to using backdrop blur?",
    answer: "Backdrop blur is GPU-accelerated in modern browsers. However, using many nested blurred panels can slow down rendering on older devices."
  }
];

const languageCodes = [
  {
    lang: "HTML & Tailwind",
    code: `
<!-- Colored Accent Badge -->
<span class="inline-flex items-center gap-1.5 px-3 py-1 text-xs font-mono font-semibold text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 rounded-full">
  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
  Active
</span>
    `,
    note: "Tailwind color class utilities."
  },
  {
    lang: "Tailwind v4 Config",
    code: `
@theme {
  --color-brand-green: #34d399;
}
    `,
    note: "CSS theme variable configuration format."
  }
];

const mistakesList = [
  {
    title: "Wrong Class Prefixes",
    description: "Using color names directly (e.g. `emerald-500`) without applying a utility prefix (like `bg-`, `text-`, or `border-`), which prevents classes from compiling."
  },
  {
    title: "Missing Opacity Slop Markers",
    description: "Declaring background transparency (e.g. `bg-emerald-500-50`) using dashes instead of the slash protocol (`bg-emerald-500/50`)."
  },
  {
    title: "Forgetting Contrast Standards",
    description: "Applying light text on light color shades (like yellow-400 or green-300), which fails accessibility contrast tests."
  }
];

const references = [
  {
    title: "Tailwind CSS Official Colors Guide",
    url: "https://tailwindcss.com/docs/customizing-colors"
  },
  {
    title: "WCAG 2.1 Color Standards",
    url: "https://www.w3.org/TR/WCAG21/#contrast-minimum"
  }
];
---

<ToolPageLayout
  title="Tailwind CSS Opacity / Color Picker: Quick Reference & Reverse Matcher"
  description="Select Tailwind CSS colors and apply opacity modifiers in real-time. Convert HEX/RGB to closest Tailwind utility class, check WCAG accessibility contrast ratios, and copy styles instantly."
  keywords="tailwind color picker, tailwind opacity picker, tailwind css colors, hex to tailwind, rgb to tailwind, tailwind palette reference, tailwind color matcher, wcag contrast checker"
  toolTitle="Tailwind Opacity/Color Picker"
  toolDescription="Quickly reference Tailwind CSS color families and opacity scales. Copy utility classes, HEX/RGBA codes, find closest matches for custom colors, and analyze contrast in real-time."
  faqs={faqs}
>
  <TailwindPicker client:load />

  <div slot="seo-content" class="flex flex-col gap-8 font-sans text-sm text-zinc-400">
    <PrivacyBadge />

    <div>
      <h2 class="text-xl font-semibold text-zinc-50 tracking-tight mb-4 flex items-center gap-2">
        <span class="w-1.5 h-6 bg-accent-emerald rounded-full"></span>
        How to Use the Tailwind Opacity & Color Picker
      </h2>
      <p class="leading-relaxed mb-4">
        Our Tailwind Opacity/Color Picker serves as a real-time cheat sheet and designer tool for developers working with Tailwind CSS. You can select color families from our curated grids, choose active prefixes (such as `bg-`, `text-`, or `border-`), and drag the opacity slider to output precise class configurations.
      </p>
      <p class="leading-relaxed">
        For each color shade (50 to 950), the tool renders the final class name (like `bg-slate-500/35`), shows a live visual swatch, displays the computed HEX/RGBA codes containing the opacity, and computes WCAG contrast ratios to verify readability.
      </p>
    </div>

    <ComparisonTable
      title="Tailwind Utility Color Classes"
      description="Compare class utility outputs:"
      headers={["Class Category", "Class Name Example", "Compiled CSS Output", "Visual Application"]}
      rows={[
        { label: "Background", values: ["bg-emerald-500", "background-color: rgb(16, 185, 129)", "Card surface or button backgrounds"] },
        { label: "Text Color", values: ["text-emerald-500", "color: rgb(16, 185, 129)", "Headings, links, and body copy text"] },
        { label: "Border Color", values: ["border-emerald-500", "border-color: rgb(16, 185, 129)", "Outlines, borders, and input boundaries"] }
      ]}
    />

    <ExampleCard
      title="Popular Tailwind Color Matches"
      description="Frequently matched palette colors:"
      examples={[
        { label: "Emerald 400", input: "#34d399", output: "bg-emerald-400", badge: "Tailwind" },
        { label: "Blue 500", input: "#3b82f6", output: "bg-blue-500", badge: "Tailwind" },
        { label: "Red 500", input: "#ef4444", output: "bg-red-500", badge: "Tailwind" }
      ]}
    />

    <LanguageSupport
      languages={languageCodes}
      title="Programmatic Integration Snippets"
      description="Apply these styles in your markup code:"
    />

    <CommonMistakes
      mistakes={mistakesList}
      title="Common Tailwind Color Pitfalls"
    />

    <BestPractices
      title="Tailwind Color Best Practices"
      practices={[
        { title: "Define a Theme Property", description: "Save repeating custom colors as theme variables in your config to maintain stylesheet consistency." },
        { title: "Preserve Contrast Compliance", description: "Ensure background color values have adequate contrast against text overlays." }
      ]}
    />

    <OfficialReferences
      references={references}
    />

    <RelatedTools
      currentToolUrl="/tools/tailwind-picker"
      category="css"
    />
  </div>
</ToolPageLayout>
