---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
import { TextInspector as TextInspectorComponent } from '../../components/TextInspector';
import ComparisonTable from '../../components/content/ComparisonTable.astro';
import BestPractices from '../../components/content/BestPractices.astro';
import CommonMistakes from '../../components/content/CommonMistakes.astro';
import OfficialReferences from '../../components/content/OfficialReferences.astro';
import LanguageSupport from '../../components/content/LanguageSupport.astro';
import ExampleCard from '../../components/content/ExampleCard.astro';

const faqs = [
  {
    question: "What is a Unicode character inspector and how does it work?",
    answer: "A <b>Unicode character inspector</b> is a developer utility that analyzes text at the byte and code point level rather than just displaying it as rendered text. It iterates through the string character-by-character, identifying each character's decimal code, hexadecimal Unicode code point (e.g., U+0041 for 'A'), UTF-8/UTF-16 byte streams, binary bits, and standard Unicode Block names (e.g., Basic Latin, Emoticons). This helps isolate hidden bugs, surrogate pairs, and combined characters."
  },
  {
    question: "What are zero-width spaces (ZWSP) and why do they cause coding errors?",
    answer: "A <b>Zero-Width Space (ZWSP, code point U+200B)</b> is an invisible character used in typography to indicate a potential word break. When pasted accidentally into source code, configurations, or databases (often copied from Slack, PDFs, or formatted blogs), it remains completely invisible to the eye but is read as a character by parsers. This leads to confusing syntax errors like 'Invalid character', JSON parsing crashes, or failed database query searches where strings look visually identical but are different."
  },
  {
    question: "How can I detect and remove invisible characters in my text?",
    answer: "Our Text Inspector automatically scans your input string for zero-width characters, null bytes, and directional format indicators. Under the <b>Warnings</b> tab, you will see a list of every invisible character detected, along with its character position and description. You can remove them instantly by selecting the 'Remove Zero-Width & Hidden' checkbox under the Sanitize drawer and clicking <b>Execute Cleaning Operations</b>, or clicking <b>Strip All</b> in the warnings panel."
  },
  {
    question: "What is Unicode normalization (NFC, NFD, NFKC, NFKD)?",
    answer: "Unicode allows some characters to be represented in multiple ways. For example, the accented letter <i>é</i> can be represented as a single character (<b>NFC</b>: Canonical Composition, U+00E9) or as two characters: a standard letter <i>e</i> followed by a combining acute accent marker (<b>NFD</b>: Canonical Decomposition, U+0065 + U+0301). <b>NFKC</b> and <b>NFKD</b> are compatibility equivalents that normalize formatting distinctions like superscripts or ligatures. Normalizing ensures text matches consistently during comparisons."
  },
  {
    question: "Why do two strings look identical but fail string comparison in JavaScript?",
    answer: "If two strings look identical but return <code>false</code> on comparison (e.g., <code>str1 === str2</code>), it is usually due to one of two reasons: either one string contains a hidden zero-width character (like a zero-width space or byte order mark), or they use different Unicode representation forms (NFC vs. NFD composition). You can paste both strings into the inspector, check their code point counts, or normalize them to NFC to resolve the mismatch."
  },
  {
    question: "How does this tool calculate the byte size of my text?",
    answer: "Byte size depends on character encoding. Our tool calculates both <b>UTF-8</b> and <b>UTF-16</b> byte sizes. UTF-8 is a variable-width encoding: ASCII characters take 1 byte, accented characters take 2 bytes, symbols/oriental ideographs take 3 bytes, and emojis/surrogate pairs take 4 bytes. UTF-16 represents most characters as 2 bytes (16 bits), with supplementary plane characters (like emojis) taking 4 bytes. You can view the raw hex dump of the UTF-8 bytes in the <b>UTF-8 Hex</b> tab."
  },
  {
    question: "What are control characters and how are they identified?",
    answer: "Control characters (C0 and C1 control codes, ranging from code point U+0000 to U+001F, and U+007F to U+009F) are non-printable characters used by hardware or system protocols to guide screen formatting or command flow. Examples include tab (<code>\\t</code>), newline (<code>\\n</code>), carriage return (<code>\\r</code>), backspace, and the null terminator (<code>\\0</code>). The Text Inspector flags these as 'Control Codes' and displays their system abbreviations (like NUL or HT) in the grid."
  },
  {
    question: "What is a surrogate pair and how does JavaScript count them?",
    answer: "JavaScript strings are historically encoded in UTF-16. Characters in the Unicode Basic Multilingual Plane (code points <= U+FFFF) are represented by one 16-bit code unit. However, characters in supplementary planes (code points > U+FFFF, like 😄 or 𠜎) require two 16-bit code units, known as a <b>surrogate pair</b>. JavaScript's standard <code>string.length</code> counts the code units (returning 2 for emojis), whereas counting via code point iterators (e.g. <code>[...string].length</code>) returns the correct character count of 1."
  },
  {
    question: "Is my sensitive data or API keys sent to any server when using this tool?",
    answer: "No. In accordance with our offline-first security directive, all processing, Unicode decomposition, character inspections, and regex sanitizations occur <b>100% locally in your web browser</b>. No data is transmitted to external servers or remote API endpoints. This guarantees complete confidentiality, making it safe to inspect sensitive tokens, SQL snippets, keys, and system database logs."
  },
  {
    question: "How do zero-width joiners (ZWJ) combine emojis?",
    answer: "A <b>Zero-Width Joiner (ZWJ, U+200D)</b> is an invisible character used to join multiple emojis into a single compound emoji. For example, the family emoji '👨‍👩‍👧‍👦' is actually a sequence of four separate emojis (Man, Woman, Girl, Boy) glued together by three invisible ZWJ characters. The Text Inspector's grid will break down compound emojis into their constituent glyphs and ZWJ connectors, showing you exactly how they are structured."
  },
  {
    question: "How can I convert tabs to spaces or collapse excess spaces?",
    answer: "You can convert tab characters to spaces by checking the 'Tabs to Spaces' option in the cleaning panel and selecting your preferred indentation size (2, 4, or 8 spaces). Additionally, check 'Flatten Spaces & Trim' to collapse multiple consecutive spaces into a single space and remove leading/trailing line whitespace, then click <b>Execute Cleaning Operations</b>."
  },
  {
    question: "What is a Byte Order Mark (BOM) and how is it detected?",
    answer: "A Byte Order Mark (BOM, code point U+FEFF) is a Unicode character placed at the beginning of a text file to indicate its byte order (big-endian vs little-endian). When parsed by JSON compilers, it causes parsing errors. The Text Inspector flags it immediately in the Warnings panel."
  },
  {
    question: "How does UTF-8 encoding differ from UTF-16?",
    answer: "UTF-8 is variable-width (1 to 4 bytes) and backwards-compatible with ASCII. UTF-16 uses 2 or 4 bytes per character. Web technologies (HTML, JSON) standardise on UTF-8, while internal Windows/Java runtimes prefer UTF-16."
  },
  {
    question: "What is the difference between Unicode Code Points and UTF-16 Code Units?",
    answer: "A Unicode Code Point is a unique numerical value assigned to a character (e.g. U+1F600 for 😀). UTF-16 represents this code point using two 16-bit code units (surrogate pairs: 0xD83D and 0xDE00)."
  },
  {
    question: "What are combined characters (Combining Diacritical Marks)?",
    answer: "Combined characters compose composite symbols by overlaying combining marks onto base glyphs (e.g. <code>a</code> + <code>◌̄</code> = <code>ā</code>). Our tool isolates these combining diacritics in the inspection grid."
  },
  {
    question: "How to normalize Unicode strings programmatically in JavaScript?",
    answer: "Use JavaScript's native <code>String.prototype.normalize()</code>: <code>const normalized = str.normalize('NFC');</code>."
  },
  {
    question: "How to normalize Unicode strings in Python?",
    answer: "In Python, import <code>unicodedata</code> and call: <code>unicodedata.normalize('NFC', text)</code>."
  },
  {
    question: "What is a Null Byte (\\0) and why is it dangerous in text inputs?",
    answer: "A Null Byte (code point U+0000) terminates strings in C/C++. If passed into database fields or system utilities compiled in C/C++, it can lead to SQL injection vulnerabilities or buffer overflow exploits by truncating string fields prematurely."
  },
  {
    question: "Why do some characters display as a replacement character () or blank rectangles?",
    answer: "The replacement character (, U+FFFD) is displayed when a parser encounters byte sequences that do not represent valid UTF-8 configurations, or when the system font lacks glyph support for a specific character code point."
  },
  {
    question: "Does this tool support Unicode 15.0 specifications?",
    answer: "Yes, the local engine matches the browser's JavaScript runtime Unicode support tables, enabling indexing of modern emojis and international character sets."
  },
  {
    question: "How does this tool help in debugging SEO title tags?",
    answer: "Hidden space markers or percent-encoded characters inflate title widths. The inspector highlights all invisible characters and counts literal lengths to optimize SEO metadata sizes."
  },
  {
    question: "What are the C0 and C1 control character blocks?",
    answer: "C0 control codes represent U+0000 to U+001F (like carriage return, backspace, tab). C1 control codes represent U+007F to U+009F. They are non-printable characters formatting system command routes."
  }
];

const references = [
  { title: "Unicode Consortium Official Specifications Documentation", url: "https://www.unicode.org/versions/latest/", source: "Unicode Consortium" },
  { title: "W3C Character Model for the World Wide Web", url: "https://www.w3.org/TR/charmod/", source: "W3C Standards" }
];

const languageCodes = [
  {
    lang: "JavaScript",
    code: `// Detect hidden zero-width characters in a string
const hasHiddenChars = str => /[\\u200B-\\u200D\\uFEFF]/.test(str);

// Unicode safe character counting
const getLength = str => [...str].length;

// Normalize unicode to composition format (NFC)
const normalizeString = str => str.normalize('NFC');

const userText = "Cafe\\u0301"; // "Café" decomposed (NFD)
console.log(getLength(userText)); // 5
console.log(getLength(normalizeString(userText))); // 4`,
    note: "Works in all JavaScript engines, safe for Node.js and browser DOM environments."
  },
  {
    lang: "Python",
    code: `import unicodedata

# Detect and normalize accents to NFC
text_nfd = "Cafe\\u0301"
text_nfc = unicodedata.normalize('NFC', text_nfd)

print(len(text_nfd))  # 5
print(len(text_nfc))  # 4
print(text_nfd == text_nfc) # False`,
    note: "Uses standard library unicodedata module."
  }
];

const mistakesList = [
  {
    title: "Pasting Hidden Slack or PDF Formatting Characters",
    description: "Copying text from chat clients or formatted books often carries invisible zero-width spaces (ZWSP, U+200B) or Directional Marks (BOM, U+FEFF). This throws compilation errors like 'invalid character' in JS or YAML parsers.",
    fix: "Analyze strings inside our warnings scanner to identify code point locations and click <code>Strip All</code> to clean the text."
  },
  {
    title: "Mismatched String Comparisons from Accent Encoding Differences",
    description: "Two strings that look visually identical (like 'café' using precomposed U+00E9 vs decomposed U+0065 + U+0301) will return false when compared with <code>===</code>.",
    fix: "Always normalize database keys and compared identifiers to NFC format: <code>str.normalize('NFC')</code>."
  }
];
---

<ToolPageLayout
  title="Text Inspector & Unicode Explorer: Zero-Width Space Detector & Byte Analyzer"
  description="Inspect text at the byte and code point level. Detect zero-width spaces, hidden control codes, and surrogate pairs. Convert Unicode normalization forms (NFC/NFD) and view raw UTF-8 hex dumps locally."
  keywords="unicode inspector, character explorer, zero-width space detector, hidden character finder, utf8 byte viewer, hex dump online, unicode normalization NFC NFD, surrogate pairs javascript, text encoder bytes, inspect string online, string debugger"
  toolTitle="Text Inspector & Unicode Explorer"
  toolDescription="Inspect and debug character strings in real-time. Identify invisible zero-width characters, trace surrogate pairs (emojis), analyze UTF-8/16 byte structures, explore unicode blocks, and normalize text compositions locally."
  faqs={faqs}
>
  <TextInspectorComponent client:load />

  <!-- Rich SEO Article Content Slot -->
  <div slot="seo-content" class="flex flex-col gap-8 font-sans text-sm text-zinc-400">
    
    <div>
      <h2 class="text-xl font-semibold text-zinc-50 tracking-tight mb-4 flex items-center gap-2">
        <span class="w-1.5 h-6 bg-accent-emerald rounded-full"></span>
        Why Unicode Inspections Are Critical for Modern Development
      </h2>
      <p class="leading-relaxed mb-4">
        As applications become increasingly globalized, developers deal with multilingual text inputs, complex emojis, and copy-pasted characters from diverse sources. Standard text editors display text as rendered output, masking the underlying byte structure. This can introduce critical errors: databases might fail to index strings, compilers might crash over invisible zero-width spaces, or authentication tokens might mismatch due to different normalization compositions.
      </p>
      <p class="leading-relaxed">
        Our <strong class="text-zinc-200">Text Inspector & Unicode Explorer</strong> gives developers a microscopic look at strings. Paste any payload, logs, or keys to dissect characters, locate problematic codes, analyze UTF-8 bytes, and normalize text formats—all processed entirely inside the browser to maintain absolute security.
      </p>
    </div>

    <!-- Sibling Cross Links -->
    <div class="flex flex-col gap-4">
      <h2 class="text-xl font-semibold text-zinc-50 tracking-tight flex items-center gap-2">
        <span class="w-1.5 h-6 bg-accent-emerald rounded-full"></span>
        Related Text Analysis Utilities
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
        <a href="/tools/character-counter" class="p-3 bg-zinc-900/30 border border-border-hairline rounded-lg hover:border-accent-emerald/30 text-xs font-mono text-zinc-200 hover:text-accent-emerald transition-all">Character Counter</a>
        <a href="/tools/word-counter" class="p-3 bg-zinc-900/30 border border-border-hairline rounded-lg hover:border-accent-emerald/30 text-xs font-mono text-zinc-200 hover:text-accent-emerald transition-all">Word Counter & Text Analyzer</a>
        <a href="/tools/regex-tester" class="p-3 bg-zinc-900/30 border border-border-hairline rounded-lg hover:border-accent-emerald/30 text-xs font-mono text-zinc-200 hover:text-accent-emerald transition-all">Regex Tester & Visualizer</a>
      </div>
    </div>

    <!-- Section: Comparison of Unicode Forms -->
    <ComparisonTable
      title="Unicode Normalization Form Comparison (NFC vs NFD)"
      description="Linguistic symbols can often be represented by different code point structures. Below is a structural comparison showing how composite and decomposed characters are registered by Unicode standards:"
      headers={["Character", "NFC (Composition)", "NFD (Decomposition)", "Length (NFC vs NFD)", "Linguistic Explanation"]}
      rows={[
        { label: "é", values: ["<code>U+00E9</code>", "<code>U+0065 + U+0301</code>", "1 vs 2 code points", "NFC uses a precomposed accented letter; NFD decomposes it into standard 'e' and a combining mark."] },
        { label: "ü", values: ["<code>U+00FC</code>", "<code>U+0075 + U+0308</code>", "1 vs 2 code points", "NFC represents 'u' with umlaut as one character; NFD splits it into 'u' + combining diaeresis."] },
        { label: "ñ", values: ["<code>U+00F1</code>", "<code>U+006E + U+0303</code>", "1 vs 2 code points", "NFC combines 'n' + tilde; NFD separates them. Common cause of filesystem mismatch bugs."] },
        { label: "Ω", values: ["<code>U+03A9</code>", "<code>U+03A9</code>", "1 vs 1 code point", "Greek Omega. NFKC/NFKD converts ohms symbol (U+2126) to standard Greek Omega (U+03A9) for search normalization."] }
      ]}
    />

    <!-- Section: Example Card -->
    <ExampleCard
      title="Invisible Character & Normalization Examples"
      description="Compare how string bugs manifest under Unicode parsing layers:"
      examples={[
        { label: "Zero-Width Space Code Point Injection", input: "const token = \"auth\\u200BToken\";", output: "Character length: 10 (visually looks like 9 'authToken')", badge: "Invisible Bug" },
        { label: "BOM Byte Order Mark", input: "\\uFEFF{\"id\": 1}", output: "Character length: 9 (causes standard JSON.parse compiler failure)", badge: "BOM Indicator" }
      ]}
    />

    <!-- Programming Implementation Guides -->
    <LanguageSupport
      languages={languageCodes}
      title="Programmatic Unicode Debugging Snippets"
      description="Detect hidden characters and normalize strings inside your applications:"
    />

    <!-- Common Mistakes -->
    <CommonMistakes
      mistakes={mistakesList}
      title="Common Unicode Pitfalls"
      description="Avoid these common errors when processing document boundaries and indices:"
    />

    <!-- Section: Core Advantages -->
    <BestPractices
      title="Text Inspection Guidelines"
      practices={[
        { title: "Normalize Input Strings", description: "Convert incoming variables to NFC composition format to prevent string comparison inequalities." },
        { title: "Strip Zero-Width Characters", description: "Filter out U+200B and other invisible placeholders from configuration files to prevent build failures." },
        { title: "Analyze Byte Count Sizes", description: "Understand UTF-8 width scaling (e.g. 1 byte ASCII to 4 bytes Emojis) when planning DB column limits." }
      ]}
    />

    <!-- Official References -->
    <OfficialReferences
      references={references}
    />
  </div>
</ToolPageLayout>
