---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
import { UrlDecoder } from '../../components/UrlDecoder';
import ComparisonTable from '../../components/content/ComparisonTable.astro';
import BestPractices from '../../components/content/BestPractices.astro';
import CommonMistakes from '../../components/content/CommonMistakes.astro';
import OfficialReferences from '../../components/content/OfficialReferences.astro';
import LanguageSupport from '../../components/content/LanguageSupport.astro';
import ExampleCard from '../../components/content/ExampleCard.astro';
import PrivacyBadge from '../../components/content/PrivacyBadge.astro';

const tabs = [
  { label: 'URL Encoder', href: '/tools/url-encoder' },
  { label: 'Hex URL Encoder', href: '/tools/hex-url-encoder' },
  { label: 'URL Decoder', href: '/tools/url-decoder', active: true }
];

const faqs = [
  {
    question: "What is URL decoding?",
    answer: "URL decoding (also known as percent-decoding) is the inverse operation of URL encoding. It searches a string for percent-encoded sequences (a percent sign followed by two hexadecimal digits, like <code>%20</code>) and translates them back into their original character equivalents (like a space)."
  },
  {
    question: "Why does my decoded URL show a 'URI malformed' error?",
    answer: "A 'URI malformed' error occurs when the input contains an invalid percent-encoded sequence. Common causes include isolated percent signs (<code>%</code>) that are not followed by two valid hexadecimal digits, incomplete codes at the end of the text, or illegal UTF-8 byte sequences (e.g. <code>%g1</code>)."
  },
  {
    question: "How does x-www-form-urlencoded decoding handle the plus (+) sign?",
    answer: "In form submissions (application/x-www-form-urlencoded), spaces are encoded as plus signs (<code>+</code>) instead of <code>%20</code>. When 'Form (x-www-form-urlencoded)' is selected, the decoder converts all <code>+</code> signs to spaces before applying standard decoding. Standard decoding treats plus signs literally."
  },
  {
    question: "What is the interactive URL Parameter Manager?",
    answer: "The URL Parameter Manager is a powerful utility on our URL Decoder page. When you input a valid URL or path containing query parameters, it automatically parses them into an interactive key-value table. You can edit keys, edit values, delete parameters, or toggle them on and off to instantly rebuild the decoded URL."
  },
  {
    question: "Can I decode relative URLs or raw query strings?",
    answer: "Yes. The URL Decoder handles absolute URLs (starting with <code>http://</code> or <code>https://</code>), relative paths (e.g., <code>/search?q=query</code>), and standalone query strings (e.g., <code>?id=123&amp;user=admin</code>) by parsing them relative to a dummy virtual base."
  },
  {
    question: "How does the character diff feature work?",
    answer: "When 'Show Diff' is enabled, the tool compares the encoded input with the decoded output. The diff engine displays character-level differences, highlighting percent-encoded characters that were decoded in emerald green and showing deleted codes with a red strikethrough."
  },
  {
    question: "Is my decoded URL data private?",
    answer: "Yes, absolutely. Like all tools on useUtils, the URL Decoder executes entirely inside your browser's local sandbox using client-side JavaScript. None of your URL components, API keys, tokens, or query payloads are ever uploaded or transmitted to a server."
  },
  {
    question: "What is the difference between decodeURI and decodeURIComponent?",
    answer: "<code>decodeURI</code> is intended to decode full URLs and will not decode URL delimiters like <code>%2F</code> (<code>/</code>), <code>%3F</code> (<code>?</code>), <code>%26</code> (<code>&amp;</code>), and <code>%3D</code> (<code>=</code>). <code>decodeURIComponent</code> decodes all valid percent-encoded sequences, restoring every character to its original text form."
  },
  {
    question: "How do I decode multiple lines in bulk?",
    answer: "Toggle 'Treat each line independently'. The URL Decoder will process each line independently and output the decoded strings line-by-line. This is useful for parsing database log files or list dumps."
  },
  {
    question: "Does the Parameter Manager support duplicate keys?",
    answer: "Yes. URL specifications allow duplicate keys (e.g., <code>?filter=a&amp;filter=b</code>). The Parameter Manager parses each instance independently, displaying them as separate rows in the table so you can edit, enable/disable, or delete them separately."
  },
  {
    question: "How do I URL decode a string in Python?",
    answer: "Use Python's built-in <code>urllib.parse</code> module: <br/><code>import urllib.parse; decoded = urllib.parse.unquote_plus(encoded_str)</code>."
  },
  {
    question: "How do I URL decode a string in Node.js?",
    answer: "Use the global <code>decodeURIComponent</code> function or the <code>querystring</code> module: <br/><code>const decoded = decodeURIComponent(encodedStr);</code>"
  },
  {
    question: "How do I URL decode in Go?",
    answer: "Use Go's built-in <code>net/url</code> package: <br/><code>decoded, err := url.QueryUnescape(encodedStr)</code>."
  },
  {
    question: "How do I URL decode in Java?",
    answer: "Use Java's built-in <code>URLDecoder</code> class: <br/><code>URLDecoder.decode(encodedStr, StandardCharsets.UTF_8.toString())</code>."
  },
  {
    question: "Why does percent decoding return different characters than expected?",
    answer: "Ensure the encoding used during percent generation matches your decoder's configuration (UTF-8 is standard; using legacy ISO-8859-1 can cause character decoding breaks)."
  },
  {
    question: "What is the URL decoded value of %20?",
    answer: "The code <code>%20</code> decodes to a standard space character."
  },
  {
    question: "What is the URL decoded value of %2B?",
    answer: "The code <code>%2B</code> decodes to a plus (+) symbol. Note that in Form mode, raw plus symbols are converted to spaces, whereas <code>%2B</code> is correctly preserved as a plus sign."
  },
  {
    question: "How do I decode a fully hex-encoded URL?",
    answer: "Paste the obfuscated hex URL into the decoder. It translates every %XX sequence back into readable letters, domain hosts, protocols, and ports."
  },
  {
    question: "Is there a command line tool to decode URLs?",
    answer: "Yes, you can use python or node in the terminal: <br/><code>python -c \"import urllib.parse; print(urllib.parse.unquote('encoded_string'))\"</code>."
  },
  {
    question: "Does the URL decoder log my API keys?",
    answer: "No. All operations run strictly client-side. The parsed parameters stay in local memory and are never sent to external servers."
  }
];

const references = [
  { title: "RFC 3986 - Uniform Resource Identifier (URI) Standard", url: "https://datatracker.ietf.org/doc/html/rfc3986", source: "IETF Standards" },
  { title: "MDN Web Docs - decodeURIComponent Guide", url: "https://developer.mozilla.org/en-US/docs/Web/JavaScript/Reference/Global_Objects/decodeURIComponent", source: "MDN References" }
];

const languageCodes = [
  {
    lang: "JavaScript",
    code: `const encodedValue = "hello%20world%20%26%20stars%21";

// Decode query parameter safely
const decodedValue = decodeURIComponent(encodedValue);

console.log(decodedValue); // Output: hello world & stars!`,
    note: "decodeURIComponent resolves all standard %XX hex entities."
  },
  {
    lang: "Python",
    code: `import urllib.parse

encoded_str = "hello+world+%26+stars%21"
# Decode form-encoded parameter (plus signs become spaces)
decoded = urllib.parse.unquote_plus(encoded_str)

print(decoded) # Output: hello world & stars!`,
    note: "unquote_plus decodes plus signs back to standard spaces."
  }
];

const mistakesList = [
  {
    title: "Decoding literal + symbols in standard paths",
    description: "Using form-urlencoded decoders on URL path segments converts legitimate plus (+) symbols (e.g. inside file names) into spaces, breaking local links.",
    fix: "Only use unquote_plus/Form decoders when parsing query parameter lists; use standard percent-decoding for path strings."
  },
  {
    title: "Assuming raw % symbols decode cleanly",
    description: "Pasting standalone percent signs (e.g. inside search terms like '50% off') without proper encoding (as %25) throws malformed URI errors in decoders.",
    fix: "Pre-validate or escape inputs containing literal percent symbols before decoding."
  }
];
---

<ToolPageLayout
  title="URL Decoder Online: Parse & Unescape URI Parameters"
  description="Decode percent-encoded strings or URLs. Features standard, full URL, and form-urlencoded decoding alongside an interactive query parameters manager table."
  keywords="url decoder, percent decoding, unescape uri, decodeuri, decodeuricomponent, query string parser, url dissection, online url decoder"
  toolTitle="URL Decoder"
  toolDescription="Parse and decode percent-encoded URLs or form data in real-time. Features an interactive query parameters manager that parses parameters into a list where you can edit, add, or toggle elements."
  tabs={tabs}
  faqs={faqs}
>
  <UrlDecoder client:load />

  <div slot="seo-content" class="flex flex-col gap-8 font-sans text-sm text-zinc-400">
    <!-- Section: Intro -->
    <div>
      <h2 class="text-xl font-semibold text-zinc-55 tracking-tight mb-4 flex items-center gap-2">
        <span class="w-1.5 h-6 bg-accent-emerald rounded-full"></span>
        How URL Percent-Decoding Works
      </h2>
      <p class="leading-relaxed mb-4">
        URL decoding restores character structures. The decoder scans strings for percent-encoding hex pairs (such as <code>%20</code>), converts these hexadecimal values back into decimal byte values, and decodes these bytes into text characters under target schema encodings.
      </p>
      <p class="leading-relaxed">
        Our **URL Decoder** simplifies debugging. Paste any web link to dissect it into schema protocols, port numbers, hosts, path directories, and search parameters. Edit keys and values inside the interactive parameter grid table to reconstruct clean links.
      </p>
    </div>

    <!-- Section: Privacy Badge -->
    <PrivacyBadge />

    <!-- Section: Comparison Table -->
    <ComparisonTable
      title="URL Decoding Functions comparison"
      headers={["Decode Function", "Translates '+' to Spaces", "Decodes Delimiters (e.g. %2F, %3F)", "Typical Use Case"]}
      rows={[
        { label: "decodeURIComponent", values: ["No", "Yes", "Query parameter values"] },
        { label: "decodeURI", values: ["No", "No", "Complete URL path preservation"] },
        { label: "Form Decoder (unquote_plus)", values: ["Yes", "Yes", "HTML application/x-www-form-urlencoded inputs"] }
      ]}
    />

    <!-- Section: Example Card -->
    <ExampleCard
      title="Common Percent Decoding Examples"
      description="Observe common percent conversions decoded back to text:"
      examples={[
        { label: "Hex character %20", input: "%20", output: " (Space)", badge: "Space" },
        { label: "Hex character %26", input: "%26", output: "&", badge: "Query Splitter" },
        { label: "Hex character %2F", input: "%2F", output: "/", badge: "Path Divider" },
        { label: "Hex character %3D", input: "%3D", output: "=", badge: "Value Association" }
      ]}
    />

    <!-- Programming Implementation Guides -->
    <LanguageSupport
      languages={languageCodes}
      title="Programmatic URL Decoding"
      description="Restore query string parameter values in your application logic using these blocks:"
    />

    <!-- Common Mistakes -->
    <CommonMistakes
      mistakes={mistakesList}
      title="Common URL Decoding Pitfalls"
      description="Avoid these common errors when decoding query data parameters:"
    />

    <!-- Best Practices -->
    <BestPractices
      title="URL Decoding Best Practices"
      practices={[
        { title: "Identify Parameter Encodings", description: "Verify whether inputs contain plus signs before choosing a decoder to avoid converting legitimate plus values to spaces." },
        { title: "Handle Malformed Strings Safely", description: "Use try-catch wrappers around decoding functions to prevent application crashes from invalid percent sequences." }
      ]}
    />

    <!-- Official References -->
    <OfficialReferences
      references={references}
    />
  </div>
</ToolPageLayout>
