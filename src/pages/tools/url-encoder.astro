---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
import { UrlEncoder } from '../../components/UrlEncoder';
import ComparisonTable from '../../components/content/ComparisonTable.astro';
import BestPractices from '../../components/content/BestPractices.astro';
import CommonMistakes from '../../components/content/CommonMistakes.astro';
import OfficialReferences from '../../components/content/OfficialReferences.astro';
import LanguageSupport from '../../components/content/LanguageSupport.astro';
import ExampleCard from '../../components/content/ExampleCard.astro';
import PrivacyBadge from '../../components/content/PrivacyBadge.astro';

const tabs = [
  { label: 'URL Encoder', href: '/tools/url-encoder', active: true },
  { label: 'Hex URL Encoder', href: '/tools/hex-url-encoder' },
  { label: 'URL Decoder', href: '/tools/url-decoder' }
];

const faqs = [
  {
    question: "What is URL encoding (percent-encoding)?",
    answer: "URL encoding (also known as percent-encoding) is a mechanism for encoding information in a Uniform Resource Identifier (URI) under RFC 3986. It replaces unsafe or non-ASCII characters with a percent sign (<code>%</code>) followed by two hexadecimal digits representing the character's ASCII code."
  },
  {
    question: "Why do URLs need to be encoded?",
    answer: "URLs can only be transmitted over the Internet using the US-ASCII character set. Since URLs often contain characters outside this set (like spaces, emojis, or non-Latin alphabets) or reserved characters (like <code>?</code>, <code>&</code>, <code>=</code>, and <code>#</code>) used as delimiters, they must be safely escaped to prevent browsers and web servers from misinterpreting them."
  },
  {
    question: "What is the difference between encodeURI and encodeURIComponent?",
    answer: "<code>encodeURI</code> is designed to encode a full, complete URL. It preserves protocol delimiters (e.g. <code>://</code>) and query delimiters (e.g. <code>?</code>, <code>&</code>, <code>=</code>). In contrast, <code>encodeURIComponent</code> encodes all special characters, making it suitable for encoding single query parameter values or paths so they don't break URL structures."
  },
  {
    question: "What is the difference between standard and form encoding (x-www-form-urlencoded)?",
    answer: "In standard URL encoding (under RFC 3986 rules), spaces are encoded as <code>%20</code>. In form encoding (used for HTML form submissions with the <code>application/x-www-form-urlencoded</code> media type), spaces are encoded as plus signs (<code>+</code>) instead. This tool lets you switch between these modes instantly."
  },
  {
    question: "What characters are never encoded in standard URL encoding?",
    answer: "According to the RFC 3986 specification, the unreserved characters that are never percent-encoded are alphanumeric characters (<code>A-Z</code>, <code>a-z</code>, <code>0-9</code>) along with the hyphen (<code>-</code>), underscore (<code>_</code>), dot (<code>.</code>), and tilde (<code>~</code>)."
  },
  {
    question: "What is strict RFC 3986 encoding?",
    answer: "Standard JavaScript <code>encodeURIComponent</code> does not encode characters like <code>!</code>, <code>'</code>, <code>(</code>, <code>)</code>, and <code>*</code>. Strict RFC 3986 mode forces these characters to be fully percent-encoded (e.g., <code>!</code> becomes <code>%21</code>) to ensure maximum compatibility with strict backend systems."
  },
  {
    question: "What is Strict Hex Obfuscation mode and when is it useful?",
    answer: "Strict Hex Obfuscation encodes <em>literally every single character</em> in the input string into its corresponding <code>%XX</code> hex code. For example, <code>hello</code> becomes <code>%68%65%6C%6C%6F</code>. This is widely used by security engineers for WAF (Web Application Firewall) bypass testing, SQL injection evasion analysis, and testing input validation routines."
  },
  {
    question: "Is my input data safe and secure on this page?",
    answer: "Yes, 100%. Like all tools on useUtils, the URL Encoder operates completely client-side in your web browser. No data, text strings, or passwords you input are ever uploaded or transmitted to a server. All conversions are processed locally."
  },
  {
    question: "How does the line-by-line batch mode work?",
    answer: "When 'Treat each line independently' is enabled, the tool splits your input text at each newline and runs the selected encoding scheme on each line separately. This is ideal for processing bulk lists of database fields, files, or environment parameters."
  },
  {
    question: "How do I encode a query string manually in JavaScript?",
    answer: "In JavaScript, you should encode each query parameter key and value separately using <code>encodeURIComponent(val)</code> and join them with <code>=</code> and <code>&</code>. For example: <code>const url = 'https://example.com/?q=' + encodeURIComponent('hello world');</code>"
  },
  {
    question: "How do I URL encode a string in Python?",
    answer: "Use Python's built-in <code>urllib.parse</code> module: <br/><code>import urllib.parse; encoded = urllib.parse.quote_plus(text)</code>."
  },
  {
    question: "How do I URL encode in Go?",
    answer: "Use Go's built-in <code>net/url</code> package: <br/><code>url.QueryEscape(\"hello world\")</code>."
  },
  {
    question: "How do I URL encode in Java?",
    answer: "Use Java's built-in <code>URLEncoder</code> class: <br/><code>URLEncoder.encode(\"hello world\", StandardCharsets.UTF_8.toString())</code>."
  },
  {
    question: "How do I URL encode in PHP?",
    answer: "Use the built-in function <code>rawurlencode($str)</code> (for RFC 3986 percent-encoding) or <code>urlencode($str)</code> (for query parameter encoding)."
  },
  {
    question: "What is the difference between URL encoding and HTML entity encoding?",
    answer: "URL encoding uses percent hex codes for URI safety. HTML entity encoding uses format indicators (like <code>&amp;lt;</code>) to represent special signs inside HTML elements to prevent DOM injection vulnerabilities (XSS)."
  },
  {
    question: "Can URL encoding prevent SQL injection?",
    answer: "No, URL encoding is merely an transport format. It does not sanitize inputs inside SQL queries. Always use parameterized queries or prepared statements to prevent SQLi."
  },
  {
    question: "What is the percent-encoding for double quotes (\")?",
    answer: "Double quotes are represented as <code>%22</code> in URL queries."
  },
  {
    question: "What is the percent-encoding for a hash symbol (#)?",
    answer: "The hash symbol (which indicates the start of a URL fragment identifier) is represented as <code>%23</code>."
  },
  {
    question: "How are emojis handled in URL encoding?",
    answer: "Emojis are encoded in UTF-8, generating multiple bytes. Each byte is converted into a separate %XX sequence (e.g. 🚀 becomes <code>%F0%9F%9A%80</code>)."
  },
  {
    question: "Does URL encoding compress strings?",
    answer: "No. URL encoding actually increases string sizes since each converted symbol is replaced by a 3-character %XX block."
  }
];

const references = [
  { title: "RFC 3986 - Uniform Resource Identifier (URI) Standard", url: "https://datatracker.ietf.org/doc/html/rfc3986", source: "IETF Standards" },
  { title: "W3C HTML URL Encoding Guide Reference", url: "https://www.w3schools.com/tags/ref_urlencode.ASP", source: "W3C Web Specs" }
];

const languageCodes = [
  {
    lang: "JavaScript",
    code: `const paramValue = "hello world & stars!";

// Encode parameter value for safe query injection
const encodedValue = encodeURIComponent(paramValue);

const fullUrl = \`https://api.example.com/search?q=\${encodedValue}\`;
console.log(fullUrl); // https://api.example.com/search?q=hello%20world%20%26%20stars%21`,
    note: "encodeURIComponent escapes all reserved characters."
  },
  {
    lang: "Python",
    code: `import urllib.parse

param_value = "hello world & stars!"
# Encode parameters for queries (spaces become +)
encoded = urllib.parse.quote_plus(param_value)

print(encoded) # Output: hello+world+%26+stars%21`,
    note: "quote_plus converts spaces to plus signs for application/x-www-form-urlencoded queries."
  }
];

const mistakesList = [
  {
    title: "Encoding the Whole URL with encodeURIComponent",
    description: "Calling <code>encodeURIComponent</code> on a full URL (including the protocol and domain) converts <code>://</code> and <code>/</code>, making the URL invalid for browser routing.",
    fix: "Only encode query parameter keys/values or path segments separately; use encodeURI if you must escape a whole URL."
  },
  {
    title: "Double URL Encoding",
    description: "Encoding an already URL-encoded string converts the percent signs to %25, breaking parameter parsing on backends.",
    fix: "Keep track of whether inputs are already encoded, or decode before re-encoding."
  }
];
---

<ToolPageLayout
  title="URL Encoder Online: Safely Escape URI Parameters"
  description="Encode strings for URL parameters with multiple specifications. Supports Standard, Full URI, Strict RFC 3986, Form, and Strict Hex Obfuscation."
  keywords="url encoder, percent encoding, uri escape, encodeuri, encodeuricomponent, url obfuscator, url encode online, web parameter encoder"
  toolTitle="URL Encoder"
  toolDescription="Safely encode strings for URL parameters in real-time. Features standard, full URI, strict RFC 3986, form-urlencoded, and strict hex obfuscation modes."
  tabs={tabs}
  faqs={faqs}
>
  <UrlEncoder client:load />

  <div slot="seo-content" class="flex flex-col gap-8 font-sans text-sm text-zinc-400">
    <!-- Section: Intro -->
    <div>
      <h2 class="text-xl font-semibold text-zinc-55 tracking-tight mb-4 flex items-center gap-2">
        <span class="w-1.5 h-6 bg-accent-emerald rounded-full"></span>
        How URL Percent-Encoding Works
      </h2>
      <p class="leading-relaxed mb-4">
        Web links must operate under strict syntax parameters. Because query characters (like <code>?</code>, <code>&</code>, and <code>=</code>) act as router instructions, using them inside parameter keys or values breaks URLs.
      </p>
      <p class="leading-relaxed">
        Our **URL Encoder** converts these characters into safe **percent-encoded hex codes**. We support all standard variations, from standard JavaScript `encodeURIComponent` to strict RFC 3986 formatting, form parameter formats, and security testing hex obfuscation.
      </p>
    </div>

    <!-- Section: Privacy Badge -->
    <PrivacyBadge />

    <!-- Section: Comparison Table -->
    <ComparisonTable
      title="URL Encoding Formats Comparison"
      headers={["Mode", "Spaces", "Reserved Characters", "Typical Use Case"]}
      rows={[
        { label: "Standard (encodeURIComponent)", values: ["%20", "Fully Encoded", "Query parameter values"] },
        { label: "Full URL (encodeURI)", values: ["%20", "Preserved (delimiters intact)", "Whole URL strings"] },
        { label: "Strict RFC 3986", values: ["%20", "Fully Encoded (including ! * ' ( ))", "Strict API authentication, OAuth calls"] },
        { label: "Form Parameter Mode", values: ["+", "Fully Encoded", "HTML form submissions"] }
      ]}
    />

    <!-- Section: Example Card -->
    <ExampleCard
      title="Common Percent Encoding Mappings"
      description="Observe standard URL character translations:"
      examples={[
        { label: "Space", input: " ", output: "%20", badge: "Space" },
        { label: "Ampersand", input: "&", output: "%26", badge: "Query Divider" },
        { label: "Slash", input: "/", output: "%2F", badge: "Path Divider" },
        { label: "Equals", input: "=", output: "%3D", badge: "Value Association" }
      ]}
    />

    <!-- Programming Implementation Guides -->
    <LanguageSupport
      languages={languageCodes}
      title="Programmatic URL Encoding"
      description="Escape query string parameters in your application code using these blocks:"
    />

    <!-- Common Mistakes -->
    <CommonMistakes
      mistakes={mistakesList}
      title="Common URL Encoding Pitfalls"
      description="Avoid these common errors when handling web query parameters:"
    />

    <!-- Best Practices -->
    <BestPractices
      title="URL Encoding Best Practices"
      practices={[
        { title: "Encode Keys and Values Separately", description: "Always escape the parameter name and values individually before combining them into queries." },
        { title: "Use UTF-8 Encoding", description: "Verify your server handles UTF-8 percent-encoding to support international languages and emojis." }
      ]}
    />

    <!-- Official References -->
    <OfficialReferences
      references={references}
    />
  </div>
</ToolPageLayout>
