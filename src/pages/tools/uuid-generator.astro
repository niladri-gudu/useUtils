---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
import { UuidGenerator } from '../../components/UuidGenerator';
import ComparisonTable from '../../components/content/ComparisonTable.astro';
import BestPractices from '../../components/content/BestPractices.astro';
import CommonMistakes from '../../components/content/CommonMistakes.astro';
import LanguageSupport from '../../components/content/LanguageSupport.astro';
import PrivacyBadge from '../../components/content/PrivacyBadge.astro';
import OfficialReferences from '../../components/content/OfficialReferences.astro';
import RelatedTools from '../../components/content/RelatedTools.astro';

const faqs = [
  {
    question: "What is a UUID and what is it used for?",
    answer: "A UUID (Universally Unique Identifier) is a 128-bit value used to uniquely identify resources in computer systems without relying on a central coordination authority. It is widely used for primary keys in database tables, API transaction logs, web session identifiers, and unique file naming."
  },
  {
    question: "What is the difference between UUID v4 and UUID v7?",
    answer: "UUID v4 is generated entirely using random numbers (122 random bits), making it completely unordered. UUID v7 is a newer, timestamp-ordered specification where the first 48 bits encode a Unix timestamp in milliseconds, followed by 74 random bits. This chronological ordering makes UUID v7 ideal for database primary keys because it maintains natural insert order."
  },
  {
    question: "How does UUID v7 improve database indexing and write performance?",
    answer: "Traditional UUID v4s are random and cause severe index fragmentation or 'index thrashing' because inserts occur at random positions within B-Tree index pages. UUID v7 is monotonically increasing over time, meaning new records are always appended to the end of the index. This prevents costly database page splits, reduces disk I/O, and speeds up write throughput."
  },
  {
    question: "What is a NanoID and how does it compare to UUID?",
    answer: "NanoID is a compact, cryptographically secure, and customizable unique string generator. While UUIDs have a fixed 36-character format with hyphens (e.g., 8-4-4-4-12), NanoID allows developers to customize both the character length and the alphabet. It uses a larger alphabet (64 characters by default), making its generated strings shorter than UUIDs for the same level of cryptographic entropy."
  },
  {
    question: "How is cryptographically secure randomness achieved in the browser?",
    answer: "This tool leverages the Web Cryptography API's <code>window.crypto.getRandomValues()</code> method. Unlike <code>Math.random()</code>, which uses a predictable pseudo-random number generator (PRNG), the native browser Crypto API accesses operating-system level entropy sources (such as kernel entropy pools or hardware interrupts) to generate true cryptographically secure random values (CSPRNG)."
  },
  {
    question: "How can I extract the timestamp from a UUID v7?",
    answer: "The first 48 bits (12 hexadecimal characters) of a UUID v7 represent a Unix epoch timestamp in milliseconds. You can parse a UUID v7 by removing the hyphens, isolating the first 12 characters, and converting this hexadecimal string into a decimal integer. That integer represents the millisecond epoch, which can be instantly cast into a standard Date object."
  },
  {
    question: "What is Shannon Entropy and why is it displayed?",
    answer: "Shannon Entropy measures the amount of uncertainty, randomness, or information density in a string of text, expressed in bits per character. A higher entropy indicates that the string is more random and less predictable. It is useful for testing passwords, security keys, and random tokens to ensure they contain sufficient randomness to resist brute-force attacks."
  },
  {
    question: "Why should I avoid ambiguous characters in generated passwords?",
    answer: "Ambiguous characters like <code>1</code> (one), <code>l</code> (lowercase L), <code>I</code> (uppercase i), <code>0</code> (zero), and <code>O</code> (uppercase o) look highly similar in many monospaced or sans-serif fonts. Excluding these characters prevents human transcription errors and user confusion when passwords or tokens are read visually or typed manually."
  },
  {
    question: "Is my generated data secure and private on this site?",
    answer: "Yes, 100%. All cryptographic key generation, shuffling, and UUID parsing happen entirely inside your local browser sandbox using native JavaScript APIs. No inputs, options, or generated tokens are sent to any external server. You can even run this page completely offline."
  },
  {
    question: "What is Base58 encoding and when should it be used?",
    answer: "Base58 is a binary-to-text encoding schema that represents raw byte arrays as alphanumeric strings. It uses a 58-character alphabet that excludes easily confused characters (<code>0</code>, <code>O</code>, <code>I</code>, <code>l</code>) and non-alphanumeric symbols (<code>+</code>, <code>/</code>). It was popularized by Bitcoin for addresses because it is safe for visual reading, double-clicking to select, and URL representation."
  },
  {
    question: "How many UUIDs can I generate in one batch?",
    answer: "You can generate up to 500 tokens or identifiers per batch in real-time. If you need more, you can click 'Regenerate Batch' or configure the settings to copy multiple sets. The client-side generation engine executes instantly."
  },
  {
    question: "What is the collision probability of UUID v4?",
    answer: "To have a 50% chance of a single collision, you would need to generate approximately 2.71 quintillion (2.71 x 10^18) UUID v4s. Even generating 1 billion UUIDs per second for 85 years would only yield a minuscule probability of collision, making it practically impossible under any realistic system load."
  },
  {
    question: "Can I use UUID v7 as a primary key in PostgreSQL?",
    answer: "Yes, PostgreSQL supports storing UUID v7 natively in the <code>uuid</code> column type. Since UUID v7 fits perfectly into the standard 128-bit structure, you do not need any special database extensions to store, index, or query them."
  },
  {
    question: "What is UUID v1 and why is it deprecated in favor of UUID v7?",
    answer: "UUID v1 uses a combination of the server's MAC address and time to guarantee uniqueness. It has fallen out of favor because it leaks hardware identities (MAC address) and creates security vulnerabilities. UUID v7 replaces it by combining a millisecond-precision UTC timestamp with cryptographically secure random bits, ensuring chronological sorting without privacy leaks."
  },
  {
    question: "What is UUID v5?",
    answer: "UUID v5 is a namespace-based identifier generated by hashing a namespace identifier together with an input text string using the SHA-1 algorithm. Unlike v4 and v7, UUID v5 is deterministic—the same namespace and input text will always yield the exact same UUID."
  },
  {
    question: "How many bits of randomness are in a UUID v7?",
    answer: "A UUID v7 contains 74 random bits. Combined with the 48-bit timestamp and 6 version/variant bits, it occupies the full 128 bits. The 74 random bits ensure that even if multiple UUIDs are generated within the same millisecond on different machines, the probability of a duplicate is zero."
  },
  {
    question: "Does UUID v7 require time synchronization across servers?",
    answer: "While highly synchronized clocks (via NTP) are recommended, UUID v7 handles clock drift and sub-millisecond generation safely. If multiple UUIDs are created within the same millisecond, the random bits provide distinct values, keeping them unique and sorted."
  },
  {
    question: "Is it safe to expose UUIDs in public URLs?",
    answer: "Generally yes, especially UUID v4 since they are completely random. However, because UUID v7 contains an embedded timestamp, an attacker can determine the exact millisecond a resource was created. If creation time is a secret, stick to UUID v4 or NanoID."
  },
  {
    question: "How much storage does a UUID occupy in MySQL?",
    answer: "In MySQL, storing a UUID as a 36-character string occupies 36 bytes. A more optimized approach is to store them in a <code>BINARY(16)</code> column, which compresses the 128-bit identifier into exactly 16 bytes, saving index space and speed."
  },
  {
    question: "What is the difference between UUID v7 and Snowflake ID?",
    answer: "Snowflake IDs (pioneered by Twitter) are 64-bit chronological integers requiring a centralized worker ID coordinator. UUID v7 is a 128-bit standard that does not require any coordinator, allowing decentralized generation across multiple microservices without collision."
  },
  {
    question: "How does this tool generate random bytes?",
    answer: "For raw byte generation, the tool requests the requested number of bytes from the Web Crypto API, yielding a secure Uint8Array buffer. It then formats these bytes into hexadecimal, base64, or binary strings client-side."
  }
];

const headers = ["Identifier Type", "Bit Length", "Chronological Order", "Collision Risk", "Best Use Case"];
const rows = [
  {
    label: "UUID v4",
    values: ["128 bits", "No (Random)", "Extremely Low", "General purpose, user sessions, distributed systems"]
  },
  {
    label: "UUID v7",
    values: ["128 bits", "Yes (Timestamp-based)", "Extremely Low", "Database primary keys, logging index fields"]
  },
  {
    label: "NanoID",
    values: ["Custom (Default 126 bits)", "No (Random)", "Extremely Low", "URL-safe resource links, public short codes"]
  },
  {
    label: "Secure Password",
    values: ["Custom", "No (Random)", "High/Medium based on length", "User credentials, temporary api tokens"]
  },
  {
    label: "Raw Crypto Bytes",
    values: ["Custom", "No (Random)", "Variable", "Signing keys, cryptopgraphic salts, binary buffers"]
  }
];

const practices = [
  {
    title: "Prefer UUID v7 for Database Primary Keys",
    description: "Always use UUID v7 instead of UUID v4 for relational database tables to prevent index fragmentation and significantly boost write speed."
  },
  {
    title: "Store UUIDs as Binary Data in MySQL",
    description: "Store UUIDs as BINARY(16) rather than VARCHAR(36) to reduce index storage requirements by over 50% and optimize join queries."
  },
  {
    title: "Use CSPRNG for Unique Identifiers",
    description: "Never use Math.random() for generating IDs. Always utilize standard cryptographic engines like the Web Cryptography API."
  },
  {
    title: "Avoid Ambiguous Characters in Codes",
    description: "Exclude characters like 1, l, 0, and O when generating passwords or short codes that users must read and type manually."
  }
];

const mistakes = [
  {
    title: "Using Math.random() for Unique Tokens",
    description: "Math.random() is cryptographically weak and predictable, which can lead to predictable IDs and session hijacking vulnerabilities.",
    fix: "Use the native Web Cryptography API <code>window.crypto.getRandomValues()</code> for generating all random numbers."
  },
  {
    title: "Using UUID v4 as Indexed Database Keys",
    description: "Inserting random UUID v4 values into B-Tree tables causes index thrashing because rows are inserted in arbitrary pages.",
    fix: "Switch your primary key generators to <strong>UUID v7</strong> to guarantee sequential inserts."
  },
  {
    title: "Storing UUIDs as Case-Sensitive Strings",
    description: "UUID specifications declare characters as case-insensitive hex representations, but string comparisons in code can fail if casing differs.",
    fix: "Always normalize UUID strings to lowercase before running database queries or matching strings."
  }
];

const languages = [
  {
    lang: "Node.js (crypto)",
    code: `
const crypto = require('crypto');

// Generate UUID v4
const uuid4 = crypto.randomUUID();
console.log('UUID v4:', uuid4);

// Generate random bytes
const bytes = crypto.randomBytes(16).toString('hex');
console.log('Random bytes:', bytes);
    `,
    note: "Node.js provides a built-in crypto module with randomUUID() supporting secure generation."
  },
  {
    lang: "Python (uuid)",
    code: `
import uuid

# Generate UUID v4
uuid4 = uuid.uuid4()
print('UUID v4:', uuid4)

# Generate UUID v7 (Python 3.12+)
uuid7 = uuid.uuid7()
print('UUID v7:', uuid7)
    `,
    note: "Python 3.12 added native support for RFC 9562 UUID v7 in the standard library."
  },
  {
    lang: "Go (google/uuid)",
    code: `
package main

import (
	"fmt"
	"github.com/google/uuid"
)

func main() {
	// Generate UUID v4
	id4, _ := uuid.NewRandom()
	fmt.Println("UUID v4:", id4.String())

	// Generate UUID v7
	id7, _ := uuid.NewV7()
	fmt.Println("UUID v7:", id7.String())
}
    `,
    note: "The popular google/uuid Go module supports native RFC 9562 UUID v7 generation."
  }
];

const references = [
  { title: "RFC 9562 - Universally Unique Identifier Standards", url: "https://datatracker.ietf.org/doc/html/rfc9562" },
  { title: "MDN Web Docs: Web Cryptography API", url: "https://developer.mozilla.org/en-US/docs/Web/API/Web_Crypto_API" },
  { title: "UUID v7 Specification Details", url: "https://uuid7.com/" }
];
---

<ToolPageLayout
  title="UUID Generator Online: Generate UUID v4 & v7 Instantly"
  description="Generate cryptographically secure random UUIDs (v4 & v7), NanoIDs, secure passwords, and custom random byte sequences locally. Features a built-in UUID v7 timestamp parser and entropy analysis."
  keywords="uuid generator, uuid v4 generator, uuid v7 generator, nanoid generator, secure password generator, random bytes generator, uuid v7 parser"
  toolTitle="UUID & Cryptographic Token Generator"
  toolDescription="Generate cryptographically secure random tokens, passwords, and identifiers locally in your web browser. Dissect UUID v7 tokens to retrieve their chronological timestamps."
  faqs={faqs}
>
  <UuidGenerator client:load />

  <div slot="seo-content" class="flex flex-col gap-12 mt-10 max-w-4xl mx-auto w-full">
    <PrivacyBadge />

    <ComparisonTable 
      headers={headers} 
      rows={rows} 
      title="Comparing Unique Identifier Standards" 
      description="Compare performance traits, sizing, ordering capabilities, and target configurations across major string token types:"
    />

    <BestPractices 
      practices={practices} 
      title="Identifier & Token Best Practices" 
      description="Follow these industry guidelines to ensure security, high performance, and visual readability in your systems:"
    />

    <CommonMistakes 
      mistakes={mistakes} 
      title="Common Identifier Pitfalls to Avoid" 
      description="Watch out for these frequent mistakes when implementing unique key generations in production applications:"
    />

    <LanguageSupport 
      languages={languages} 
      title="Programmatic Generation Snippets" 
      description="Generate secure UUIDs and tokens programmatically using standard library methods in Node.js, Python, and Go:"
    />

    <OfficialReferences 
      references={references} 
      title="Technical Standards & References" 
    />

    <RelatedTools />
  </div>
</ToolPageLayout>
