---
import ToolPageLayout from '../../layouts/ToolPageLayout.astro';
import { YamlJsonConverter } from '../../components/YamlJsonConverter';
import ComparisonTable from '../../components/content/ComparisonTable.astro';
import BestPractices from '../../components/content/BestPractices.astro';
import CommonMistakes from '../../components/content/CommonMistakes.astro';
import OfficialReferences from '../../components/content/OfficialReferences.astro';
import LanguageSupport from '../../components/content/LanguageSupport.astro';
import ExampleCard from '../../components/content/ExampleCard.astro';

const tabs = [
  { label: 'YAML to JSON', href: '/tools/yaml-to-json', active: true },
  { label: 'JSON to YAML', href: '/tools/json-to-yaml' }
];

const faqs = [
  {
    question: "What is YAML and how does YAML to JSON conversion work?",
    answer: "YAML (YAML Ain't Markup Language) is a human-readable data serialization standard commonly used for configuration files. The converter parses the indentation structure, anchors, and aliases of the YAML document and maps them directly into equivalent JSON key-value pairs and arrays."
  },
  {
    question: "Why should I convert YAML to JSON?",
    answer: "JSON is the standard format for web browser APIs and database models. Converting YAML configurations into JSON allows JavaScript client frameworks, JSON schemas, or web applications to parse the data natively."
  },
  {
    question: "Does this online YAML converter protect my privacy?",
    answer: "Yes. All processing, parsing, and diagnostics run locally in your browser memory using JavaScript libraries. No configuration text, YAML payloads, or files are ever sent to a server."
  },
  {
    question: "How does the converter handle YAML anchors (&) and aliases (*)?",
    answer: "YAML anchors define a reusable variable block, and aliases reference it elsewhere in the document. Our converter automatically expands these references, duplicating the defined keys into the corresponding JSON objects."
  },
  {
    question: "Why does my YAML input show an indentation error?",
    answer: "YAML uses strict whitespace indentation (spaces) to define nesting levels. Using tab characters (<code>\\t</code>) instead of spaces is forbidden by the YAML specification and will cause parsing errors."
  },
  {
    question: "Can I convert multiple YAML documents in a single file?",
    answer: "Yes. In YAML, documents are separated by three dashes (<code>---</code>). Enabling 'Support multi-document parsing' in the settings parses all documents and outputs them as a JSON array of objects."
  },
  {
    question: "What is the difference between JSON and YAML syntax?",
    answer: "JSON uses braces (<code>{}</code>), brackets (<code>[]</code>), and double quotes, requiring delimiters. YAML uses indentation, dashes, and colons, making it cleaner and easier to read, though more sensitive to spacing errors."
  },
  {
    question: "Does the converter support block scalars (literal vs folded)?",
    answer: "Yes. The parser supports YAML's multiline block scalars: the literal style (<code>|</code>) which preserves line breaks, and the folded style (<code>&gt;</code>) which collapses line breaks into single space paragraphs."
  },
  {
    question: "How do I convert YAML to JSON in Node.js programmatically?",
    answer: "You can use packages like <code>yaml</code> or <code>js-yaml</code> to parse YAML strings and dump them into JSON structures."
  },
  {
    question: "How do I download the converted JSON file?",
    answer: "Click the 'Download' button above the output pane to save your parsed JSON payload as a local file."
  },
  {
    question: "How does the tool handle boolean strings like 'yes' or 'no'?",
    answer: "Under the older YAML 1.1 spec, words like <code>yes</code>, <code>no</code>, <code>on</code>, <code>off</code> resolve to booleans. In modern YAML 1.2, these resolve to string primitives to prevent type coercion bugs."
  },
  {
    question: "How to convert YAML to JSON in Python?",
    answer: "Use the third-party package <code>PyYAML</code> along with Python's built-in <code>json</code> module: <br/><code class='font-mono'>import yaml, json</code> to load YAML and output it."
  },
  {
    question: "Is there a limit on the YAML file size I can convert?",
    answer: "Since the tool runs locally in your browser sandbox, it can process configuration files up to 20MB in a few seconds."
  },
  {
    question: "Does the parser support custom YAML tags?",
    answer: "Standard YAML tags (like <code>!!str</code> or <code>!!int</code>) are supported and resolved to their standard JSON types, but custom application tags (e.g. <code>!include</code>) are stripped."
  },
  {
    question: "Can I inspect the JSON structure visually in a tree?",
    answer: "Yes, swap to the 'Interactive Tree' tab in the output pane to browse the nested JSON keys using an expandable collapsible folder structure."
  },
  {
    question: "How to generate parser code snippets in other languages?",
    answer: "Select the 'Parser Models' tab in the output pane, choose Go, TypeScript, or Python, and the tool will generate the parsing code to read this YAML configuration."
  },
  {
    question: "Why do Kubernetes manifests use YAML instead of JSON?",
    answer: "Kubernetes files are complex and require inline comments and multiline strings (like shell scripts). YAML's clean layout is much easier to maintain than verbose JSON."
  },
  {
    question: "Is YAML case-sensitive?",
    answer: "Yes, keys and string values are case-sensitive, just like in JSON."
  },
  {
    question: "How do I format or clean up my YAML input?",
    answer: "The editor checks your syntax. If you have alignment issues, the warning notice points to the line number so you can format it correctly."
  },
  {
    question: "Can I convert JSON back to YAML?",
    answer: "Yes, the tool is fully bidirectional. You can toggle the pathway to JSON → YAML or swap the input and output panes instantly."
  }
];

const references = [
  { title: "YAML 1.2 Specification Standard Document", url: "https://yaml.org/spec/1.2.2/", source: "YAML Org Official Site" },
  { title: "js-yaml Parser Library for JavaScript/Node", url: "https://github.com/nodeca/js-yaml", source: "GitHub Repository" }
];

const languageCodes = [
  {
    lang: "Node.js (js-yaml)",
    code: `const yaml = require("js-yaml");

const yamlStr = "app:\\n  name: useUtils\\n  port: 80";

try {
  const doc = yaml.load(yamlStr);
  console.log(JSON.stringify(doc, null, 2));
} catch (e) {
  console.error(e);
}`,
    note: "The load method parses standard YAML configs into standard JS objects."
  },
  {
    lang: "Python (PyYAML)",
    code: `import yaml
import json

yaml_data = """
app:
  name: useUtils
  port: 80
"""

# Parse YAML config using the SafeLoader
parsed = yaml.load(yaml_data, Loader=yaml.SafeLoader)
json_str = json.dumps(parsed, indent=2)
print(json_str)`,
    note: "Always specify SafeLoader in Python to prevent arbitrary code execution vulnerabilities."
  }
];

const mistakesList = [
  {
    title: "Using Tab Characters for Indentation",
    description: "YAML specifications strictly forbid horizontal tab characters (\\t) for indentation, throwing syntax errors during parsing.",
    fix: "Configure your editor to insert spaces instead of tabs, and verify alignment."
  },
  {
    title: "Unquoted Strings that Conflict with YAML Boolean Primitives",
    description: "In YAML 1.1, unquoted strings like <code>no</code>, <code>yes</code>, <code>on</code>, <code>off</code> translate to booleans, causing data type conflicts.",
    fix: "Wrap these values in double quotes, or configure your parser to strictly comply with the YAML 1.2 standard."
  }
];
---

<ToolPageLayout
  title="YAML to JSON Converter Online - 100% Offline"
  description="Convert YAML structures to JSON objects in real-time. Features anchor/alias expansion, multi-document parsing, live diagnostics, path query filters, interactive tree explorer, and parser code generators (TypeScript, Go, Python)."
  keywords="yaml to json, convert yaml to json online, yaml converter, serialize yaml to json"
  toolTitle="YAML ⇄ JSON Converter & Studio"
  toolDescription="Convert YAML configurations to JSON. Expand anchors, parse multi-documents, filter paths, inspect nested trees, and generate parser code locally in your browser."
  faqs={faqs}
>
  <YamlJsonConverter client:load />

  <div slot="seo-content" class="flex flex-col gap-8 font-sans text-sm text-zinc-400">
    
    <div>
      <h2 class="text-xl font-semibold text-zinc-50 tracking-tight mb-4 flex items-center gap-2">
        <span class="w-1.5 h-6 bg-accent-emerald rounded-full"></span>
        Understanding YAML Indentation and Structures
      </h2>
      <p class="leading-relaxed mb-4">
        YAML is designed to be highly readable for humans, but this readability comes at the cost of strict syntax rules. Unlike JSON or XML which use bracket tokens to delimit structures, YAML relies entirely on whitespace indentation to define key-value scopes and nesting hierarchies.
      </p>
      <p class="leading-relaxed mb-4">
        Our **YAML to JSON Converter** simplifies the conversion. The parser scans the indentation tokens, resolves anchors (<code>&amp;</code>) and aliases (<code>*</code>), handles folded or literal block scalars, and generates standard-compliant JSON structures.
      </p>
    </div>

    <div>
      <h2 class="text-xl font-semibold text-zinc-50 tracking-tight mb-4 flex items-center gap-2">
        <span class="w-1.5 h-6 bg-accent-emerald rounded-full"></span>
        How to Use the YAML Converter Suite
      </h2>
      <p class="leading-relaxed mb-4">
        Our tool is a complete development studio featuring:
      </p>
      <ul class="list-disc pl-5 space-y-2 mb-4 leading-relaxed">
        <li><strong class="text-zinc-200">Load Samples:</strong> Paste your YAML configurations or use our presets to load single-document configs, multi-document streams, or JSON structures.</li>
        <li><strong class="text-zinc-200">Real-time Syntax Highlights:</strong> If your spacing or indentation is misaligned, the diagnostic log prints the exact line location of the syntax error.</li>
        <li><strong class="text-zinc-200">Interactive Inspections:</strong> Swap to the <em>Interactive Tree</em> to collapse deep object folders and copy keypaths, or the <em>JSON Schema</em> tab to inspect inferred schemas.</li>
        <li><strong class="text-zinc-200">Parser Code Generation:</strong> Export structural parser configurations automatically in Go, Python, and TypeScript.</li>
      </ul>
    </div>

    <!-- Section: Comparison Table -->
    <ComparisonTable
      title="YAML vs JSON Properties"
      headers={["Syntax Target", "YAML Specification (YAML 1.2)", "JSON Specification (RFC 8259)"]}
      rows={[
        { label: "Structure Markers", values: ["Whitespace spacing offsets", "Braces ({}), brackets ([]), and commas"] },
        { label: "Keys Quotation", values: ["Optional (required only for special chars)", "Strictly double-quoted"] },
        { label: "Comments Support", values: ["Supported natively (using # symbol)", "Strictly forbidden"] },
        { label: "Object Referencing", values: ["Supported natively (anchors & aliases)", "Not supported"] }
      ]}
    />

    <!-- Section: Example Card -->
    <ExampleCard
      title="YAML to JSON Translations"
      description="Compare how YAML configurations parse into JSON:"
      examples={[
        { label: "Standard Anchor Ingestion", input: 'default: &db\n  host: local\nservice:\n  <<: *db\n  port: 80', output: '{\n  "default": {\n    "host": "local"\n  },\n  "service": {\n    "host": "local",\n    "port": 80\n  }\n}', badge: "Expanded JSON" }
      ]}
    />

    <!-- Programming Implementation Guides -->
    <LanguageSupport
      languages={languageCodes}
      title="Programmatic YAML Parsers"
      description="Load and parse YAML configurations inside your backend scripts safely:"
    />

    <!-- Common Mistakes -->
    <CommonMistakes
      mistakes={mistakesList}
      title="Common YAML Parsing Errors"
      description="Avoid these common pitfalls to prevent parser crashes:"
    />

    <!-- Best Practices -->
    <BestPractices
      title="YAML Configuration Best Practices"
      practices={[
        { title: "Standardize Space Indentations", description: "Consistently use 2 spaces or 4 spaces. Never use tab characters, as they violate specifications." },
        { title: "Adopt Safe YAML Loaders", description: "Always use SafeLoader or equivalent configuration methods in Python/Node to prevent remote code execution vulnerabilities." }
      ]}
    />

    <!-- Official References -->
    <OfficialReferences
      references={references}
    />
  </div>
</ToolPageLayout>
